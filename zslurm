def parse_timeleft(time):
    try:
        time = time.split("-")
        if len(time) > 1:
            days = int(time[0])
            time = time[1]
        else:
            days = 0
            time = time[0]

        time = [int(e) for e in time.split(":")]

        if len(time) == 3:
            hours = time[0]
            time = time[1:]
        else:
            hours = 0

        if len(time) == 2:
            minutes = time[0]
            time = time[1:]
        else:
            minutes = 0
        seconds = time[0]
    except: #catch error where time was apparently 'INVALID'.
        days = 5 #use default full time for engine. Better than crash. 
        hours = minutes = seconds = 0


    return days * 24 * 60 * 60.0 + hours * 60 * 60.0 + minutes * 60 + seconds


def _slurm_reason_is_hold(reason):
    """Return whether Slurm reports a pending allocation as explicitly held."""
    value = str(reason or "").strip().lower()
    return value.startswith("jobheld")


queue_states = set(["PENDING", "REQUEUED"])
active_job_states = queue_states | {"ASSIGNED", "RUNNING"}
DEFAULT_JOB_PRIORITY = 100

DEPENDENCY_ACTIVE_JOB_STATES = queue_states | {"ASSIGNED", "RUNNING"}

DEPENDENCY_SATISFIED = "satisfied"
DEPENDENCY_WAITING = "waiting"
DEPENDENCY_NEVER_SATISFIED = "never_satisfied"
SUPPORTED_DEPENDENCY_TYPES = {
    "after", "afterany", "afterok", "afternotok", "singleton"
}


def parse_job_dependency(dependency):
    """Parse the supported subset of Slurm's dependency syntax.

    A comma combines every atomic condition with AND; a question mark combines
    them with OR.  Multiple ids in one clause are atomic conditions too, which
    matches Slurm's ``afterok:20:21?afterany:23`` behaviour.  ``after`` accepts
    Slurm's optional ``+minutes`` delay.  The returned structure contains only
    XML-RPC/pickle-friendly primitives so it can safely live on a Job object.
    """

    if dependency is None:
        return None
    text = str(dependency).strip()
    if not text or text.lower() == "none":
        return None
    if "," in text and "?" in text:
        raise ValueError(
            "dependency may use ',' (AND) or '?' (OR), but not both"
        )

    if "?" in text:
        mode = "any"
        clauses = text.split("?")
    elif "," in text:
        mode = "all"
        clauses = text.split(",")
    else:
        mode = "all"
        clauses = [text]

    conditions = []
    seen = set()
    for raw_clause in clauses:
        clause = raw_clause.strip()
        if not clause:
            raise ValueError("dependency contains an empty condition")
        parts = [part.strip() for part in clause.split(":")]
        if any(not part for part in parts):
            raise ValueError("dependency contains an empty job id")

        if len(parts) == 1 and parts[0].lower() == "singleton":
            key = ("singleton", None, 0.0)
            if key not in seen:
                conditions.append({"type": "singleton"})
                seen.add(key)
            continue

        # Slurm documents afterany as the default dependency type.  Supporting
        # a bare id is useful for compatibility while keeping multi-id clauses
        # explicit and unambiguous.
        if len(parts) == 1 and re.match(r"^[0-9]+$", parts[0]):
            dep_type = "afterany"
            references = parts
        else:
            dep_type = parts[0].lower()
            references = parts[1:]

        if dep_type not in SUPPORTED_DEPENDENCY_TYPES:
            if dep_type == "expand":
                raise ValueError(
                    "dependency type 'expand' is not supported by ZSlurm"
                )
            raise ValueError(
                "unsupported dependency type %r; supported types: %s"
                % (dep_type, ", ".join(sorted(SUPPORTED_DEPENDENCY_TYPES)))
            )
        if dep_type == "singleton":
            raise ValueError("singleton does not accept job ids")
        if not references:
            raise ValueError("dependency type %r requires a job id" % dep_type)

        for reference in references:
            delay_seconds = 0.0
            jobid = reference
            if dep_type == "after":
                match = re.match(r"^([0-9]+)(?:\+([0-9]+))?$", reference)
                if match is None:
                    raise ValueError(
                        "invalid after dependency %r; expected JOBID or "
                        "JOBID+MINUTES" % reference
                    )
                jobid = match.group(1)
                if match.group(2) is not None:
                    delay_seconds = float(match.group(2)) * 60.0
            elif re.match(r"^[0-9]+$", reference) is None:
                raise ValueError("invalid dependency job id %r" % reference)

            key = (dep_type, str(jobid), delay_seconds)
            if key in seen:
                continue
            conditions.append({
                "type": dep_type,
                "jobid": str(jobid),
                "delay_seconds": delay_seconds,
            })
            seen.add(key)

    if not conditions:
        raise ValueError("dependency does not contain any conditions")
    return {"raw": text, "mode": mode, "conditions": conditions}


class Job(object):
    def __init__(
        self,
        job_name,
        jobid,
        command,
        cwd,
        env,
        ncpu,
        mem,
        reqtime,
        requeue,
        dependency,
        arch_use_add,
        arch_use_remove,
        dcache_use_add,
        dcache_use_remove,
        active_use_add,
        active_use_remove,
        partition,
        info_input_mb,
        info_output_file,
        comment,
        ssd_use='no',
        ssd_gb=0,
        dcache_transfer_slots=0,
        owner=None,
        priority=DEFAULT_JOB_PRIORITY,
        dcache_download_slots=0,
        dcache_upload_slots=0,
        s3_download_slots=0
    ):
        self.job_name = job_name
        self.jobid = jobid
        self.command = command
        self.cwd = cwd
        self.env = env
        self.ncpu = ncpu
        self.mem = mem
        # Immutable submission limits and mutable running allocations are kept
        # separately. Jobs that never use the lease API remain at their maxima.
        self.max_ncpu = float(ncpu)
        self.max_mem = float(mem)
        self.held_ncpu = float(ncpu)
        self.held_mem = float(mem)
        self.lease_epoch = 0
        self.reqtime = reqtime
        self.requeue = requeue
        self.dependency = dependency
        self.dependency_spec = None
        self.dependency_satisfied_conditions = []
        self.dependency_released = dependency is None or not str(dependency).strip()
        self.dependency_never_satisfied = False
        self.dependency_state = (
            DEPENDENCY_SATISFIED if self.dependency_released
            else DEPENDENCY_WAITING
        )
        self.dependency_reason = ""
        self.archive_start_use_add = arch_use_add
        self.archive_end_use_remove = arch_use_remove
        self.dcache_start_use_add = dcache_use_add
        self.dcache_end_use_remove = dcache_use_remove
        self.active_start_use_add = active_use_add
        self.active_end_use_remove = active_use_remove
        self.partition = partition
        self.input_mb = info_input_mb
        self.output_file = info_output_file
        self.comment = comment
        self.owner = owner
        try:
            value = DEFAULT_JOB_PRIORITY if priority is None else priority
            self.priority = int(value)
        except (TypeError, ValueError):
            self.priority = DEFAULT_JOB_PRIORITY
        try:
            su = (ssd_use or 'no')
            if isinstance(su, str):
                su = su.strip().lower()
            else:
                su = 'no'
            if su in ('yes', 'possible', 'can_use', 'can-use', 'canuse'):
                su = 'possible'
            elif su in ('required', 'require', 'must', 'need'):
                su = 'required'
            elif su in ('no', 'none', 'off', 'false'):
                su = 'no'
            else:
                su = 'no'
        except Exception:
            su = 'no'
        self.ssd_use = su
        try:
            self.ssd_gb = max(0.0, float(ssd_gb))
        except Exception:
            self.ssd_gb = 0.0
        self.ssd_alloc_gb = 0.0
        try:
            self.dcache_transfer_slots = max(0.0, float(dcache_transfer_slots))
        except Exception:
            self.dcache_transfer_slots = 0.0
        try:
            self.dcache_download_slots = max(0.0, float(dcache_download_slots))
        except Exception:
            self.dcache_download_slots = 0.0
        try:
            self.dcache_upload_slots = max(0.0, float(dcache_upload_slots))
        except Exception:
            self.dcache_upload_slots = 0.0
        try:
            self.s3_download_slots = max(0.0, float(s3_download_slots))
        except Exception:
            self.s3_download_slots = 0.0

        self.state = "PENDING"
        self.node_id = None
        self.starttime = None
        self.first_starttime = None
        self.endtime = None
        self.current_cpu_usage = 0.0
        self.current_mem_usage = 0.0
        self.submit_ts = time.time()

    def started(self, nodeid):
        self.node_id = nodeid
        self.starttime = time.time()
        if self.first_starttime is None:
            self.first_starttime = self.starttime
        self.state = "RUNNING"
        self.current_cpu_usage = 0.0
        self.current_mem_usage = 0.0
        # A requeued job starts with its complete (possibly enlarged) request.
        self.max_ncpu = float(self.ncpu)
        self.max_mem = float(self.mem)
        self.held_ncpu = float(self.ncpu)
        self.held_mem = float(self.mem)
        self.lease_epoch = 0
        engines.job_running(nodeid, self)

    def assigned(self, nodeid):
        self.node_id = nodeid
        self.state = "ASSIGNED"
        self.current_cpu_usage = 0.0
        self.current_mem_usage = 0.0

    def done(self, return_code, reason, state):
        self.endtime = time.time()
        self.state = state
        self.reason = reason
        self.return_code = return_code
        if state in queue_states:
            self.current_cpu_usage = 0.0
            self.current_mem_usage = 0.0
        if self.node_id:
            engines.job_stopped(self.node_id, self)
        self.node_id = None


