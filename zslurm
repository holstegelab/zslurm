class JobManager(object):
    def __init__(self):
        self.jobid_counter = numpy.random.randint(0, 1000000)

        self.jobs_by_id = OrderedDict()
        
        self.finished_jobs_by_owner = {}

        #self.finished_jobs = deque()
        self.finished_jobs_lock = threading.RLock()
        self.finished_jobs_max = 2000

        self.lock = threading.RLock()

        self.done_jobs = {}
        self.failed_jobs = {}  # count per partition (compute, archive)
        self.running_jobs = {}  # count per partition (compute, archive)
        self.total_jobs = {}  # count per partition (compute, archive)

        self.eligible_jobs = {}
        self._eligible_cache_ts = 0.0
        self._eligible_cache_ttl = 15.0

        self.active_total = 0
        self.active_inuse = 0
        self.archive_total = 0
        self.archive_inuse = 0
        self.dcache_total = 0
        self.dcache_inuse = 0
        # Transient transfer concurrency is separate from dcache_{total,inuse},
        # which account for durable storage in GiB.  Jobs reserve these slots
        # only while ASSIGNED/RUNNING.
        self.dcache_download_total = 4.0
        self.dcache_download_inuse = 0.0
        self.dcache_upload_total = 4.0
        self.dcache_upload_inuse = 0.0
        self.s3_download_total = 4.0
        self.s3_download_inuse = 0.0

        # idempotent submission: maps a client-supplied idempotency_key -> jobid,
        # so a retried submit_job (e.g. after a socket timeout that actually
        # succeeded) returns the existing jobid instead of double-submitting.
        self.seen_tokens = {}

        # Compact terminal outcomes used by dependencies.  Finished Job objects
        # are retained separately for queue/report output and may be trimmed per
        # owner; dependency correctness must not depend on that presentation
        # history still containing a predecessor.
        self.dependency_history = OrderedDict()

    @staticmethod
    def _dependency_owner(owner, env):
        if owner is not None:
            return str(owner)
        values = env if isinstance(env, dict) else {}
        for name in ("USER", "LOGNAME"):
            value = values.get(name)
            if value:
                return str(value)
        return None

    def _prepare_dependency_locked(self, parsed, job_name, owner, env,
                                   exclude_jobid=None):
        if parsed is None:
            return None

        conditions = []
        dependency_owner = self._dependency_owner(owner, env)
        for condition in parsed["conditions"]:
            dep_type = condition["type"]
            if dep_type == "singleton":
                predecessors = []
                for other in self.jobs_by_id.values():
                    other_id = str(getattr(other, "jobid", ""))
                    if exclude_jobid is not None and other_id == str(exclude_jobid):
                        continue
                    if (
                        getattr(other, "state", None)
                        not in DEPENDENCY_ACTIVE_JOB_STATES
                    ):
                        continue
                    if str(getattr(other, "job_name", "")) != str(job_name):
                        continue
                    other_owner = self._dependency_owner(
                        getattr(other, "owner", None), getattr(other, "env", {})
                    )
                    if other_owner == dependency_owner:
                        predecessors.append(other_id)
                conditions.append({
                    "type": "singleton",
                    "jobids": predecessors,
                })
                continue

            target = str(condition["jobid"])
            if exclude_jobid is not None and target == str(exclude_jobid):
                raise ValueError("a job cannot depend on itself (%s)" % target)
            if (
                target not in self.jobs_by_id
                and target not in self.dependency_history
            ):
                raise ValueError("unknown dependency job id %s" % target)
            conditions.append(dict(condition))

        return {
            "raw": parsed["raw"],
            "mode": parsed["mode"],
            "conditions": conditions,
        }

    def _remember_dependency_outcome_locked(self, job):
        self.dependency_history[str(job.jobid)] = {
            "jobid": str(job.jobid),
            "owner": getattr(job, "owner", None),
            "state": str(getattr(job, "state", "")),
            "return_code": getattr(job, "return_code", None),
            "first_starttime": getattr(job, "first_starttime", None),
            "endtime": getattr(job, "endtime", None),
        }

    def _dependency_target_locked(self, jobid):
        """Return (is_terminal, record), or (None, None) when unknown."""
        target = self.jobs_by_id.get(str(jobid))
        if target is not None:
            if (
                getattr(target, "state", None)
                in DEPENDENCY_ACTIVE_JOB_STATES
            ):
                return False, target
            return True, target
        outcome = self.dependency_history.get(str(jobid))
        if outcome is not None:
            return True, outcome
        return None, None

    @staticmethod
    def _dependency_value(record, name, default=None):
        if isinstance(record, dict):
            return record.get(name, default)
        return getattr(record, name, default)

    def _dependency_condition_status_locked(self, condition, now):
        dep_type = condition["type"]
        if dep_type == "singleton":
            for target in condition.get("jobids", []):
                is_terminal, _record = self._dependency_target_locked(target)
                if is_terminal is None:
                    return (
                        DEPENDENCY_NEVER_SATISFIED,
                        "singleton predecessor %s is no longer known" % target,
                    )
                if not is_terminal:
                    return (
                        DEPENDENCY_WAITING,
                        "waiting for singleton predecessor %s" % target,
                    )
            return DEPENDENCY_SATISFIED, ""

        target = str(condition["jobid"])
        is_terminal, record = self._dependency_target_locked(target)
        label = "%s:%s" % (dep_type, target)
        if is_terminal is None:
            return (
                DEPENDENCY_NEVER_SATISFIED,
                "%s references an unknown job" % label,
            )

        if dep_type == "after":
            anchor = self._dependency_value(record, "first_starttime")
            if anchor is None and is_terminal:
                # Slurm also satisfies `after` when a predecessor is cancelled
                # before it ever starts.
                anchor = self._dependency_value(record, "endtime")
            if anchor is None:
                return DEPENDENCY_WAITING, "waiting for %s to start" % target
            ready_at = float(anchor) + float(condition.get("delay_seconds", 0.0))
            if now < ready_at:
                return (
                    DEPENDENCY_WAITING,
                    "waiting for delay after job %s started" % target,
                )
            return DEPENDENCY_SATISFIED, ""

        if not is_terminal:
            return DEPENDENCY_WAITING, "waiting for %s" % label

        state = self._dependency_value(record, "state", "")
        return_code = self._dependency_value(record, "return_code")
        successful = state == "COMPLETED" and return_code == RC_SUCCESS
        if dep_type == "afterany":
            return DEPENDENCY_SATISFIED, ""
        if dep_type == "afterok":
            if successful:
                return DEPENDENCY_SATISFIED, ""
            return (
                DEPENDENCY_NEVER_SATISFIED,
                "%s did not complete successfully" % label,
            )
        if dep_type == "afternotok":
            if not successful:
                return DEPENDENCY_SATISFIED, ""
            return (
                DEPENDENCY_NEVER_SATISFIED,
                "%s completed successfully" % label,
            )
        return DEPENDENCY_NEVER_SATISFIED, "unsupported %s" % label

    def _dependency_status_locked(self, job, now=None):
        if getattr(job, "dependency_released", False):
            job.dependency_state = DEPENDENCY_SATISFIED
            job.dependency_reason = ""
            return DEPENDENCY_SATISFIED, ""
        if getattr(job, "dependency_never_satisfied", False):
            return (
                DEPENDENCY_NEVER_SATISFIED,
                getattr(job, "dependency_reason", "dependency can never be satisfied"),
            )

        spec = getattr(job, "dependency_spec", None)
        if spec is None:
            try:
                parsed = parse_job_dependency(getattr(job, "dependency", None))
                spec = self._prepare_dependency_locked(
                    parsed,
                    getattr(job, "job_name", ""),
                    getattr(job, "owner", None),
                    getattr(job, "env", {}),
                    exclude_jobid=getattr(job, "jobid", None),
                )
                job.dependency_spec = spec
            except ValueError as ex:
                job.dependency_never_satisfied = True
                job.dependency_state = DEPENDENCY_NEVER_SATISFIED
                job.dependency_reason = str(ex)
                return DEPENDENCY_NEVER_SATISFIED, str(ex)
        if spec is None:
            job.dependency_released = True
            job.dependency_state = DEPENDENCY_SATISFIED
            job.dependency_reason = ""
            return DEPENDENCY_SATISFIED, ""

        if now is None:
            now = time.time()
        satisfied = set(getattr(job, "dependency_satisfied_conditions", []))
        statuses = []
        for index, condition in enumerate(spec["conditions"]):
            if index in satisfied:
                statuses.append((DEPENDENCY_SATISFIED, ""))
                continue
            condition_status = self._dependency_condition_status_locked(
                condition, now
            )
            statuses.append(condition_status)
            if condition_status[0] == DEPENDENCY_SATISFIED:
                satisfied.add(index)
        job.dependency_satisfied_conditions = sorted(satisfied)

        if spec["mode"] == "any":
            released = any(state == DEPENDENCY_SATISFIED for state, _ in statuses)
            impossible = all(
                state == DEPENDENCY_NEVER_SATISFIED for state, _ in statuses
            )
        else:
            released = all(state == DEPENDENCY_SATISFIED for state, _ in statuses)
            impossible = any(
                state == DEPENDENCY_NEVER_SATISFIED for state, _ in statuses
            )

        if released:
            state, reason = DEPENDENCY_SATISFIED, ""
            job.dependency_released = True
        elif impossible:
            state = DEPENDENCY_NEVER_SATISFIED
            reason = next(
                reason for item_state, reason in statuses
                if item_state == DEPENDENCY_NEVER_SATISFIED
            )
            # Slurm does not reconsider a failed dependency if a predecessor is
            # later requeued; latch that terminal result.
            job.dependency_never_satisfied = True
        else:
            state = DEPENDENCY_WAITING
            reason = next(
                (reason for item_state, reason in statuses
                 if item_state == DEPENDENCY_WAITING),
                "waiting for dependency",
            )
        job.dependency_state = state
        job.dependency_reason = reason
        return state, reason

    def dependency_status(self, job):
        self.lock.acquire()
        try:
            state, reason = self._dependency_status_locked(job)
            return {"state": state, "reason": reason}
        finally:
            self.lock.release()

    def _dependency_allows_run_locked(self, job):
        state, _reason = self._dependency_status_locked(job)
        return state == DEPENDENCY_SATISFIED

    def _resource_fits_locked(self, total, inuse, needed):
        try:
            needed_val = float(needed)
        except Exception:
            needed_val = 0.0
        if needed_val <= 0.0:
            return True
        try:
            total_val = float(total)
        except Exception:
            total_val = 0.0
        try:
            inuse_val = float(inuse)
        except Exception:
            inuse_val = 0.0
        return total_val >= (inuse_val + needed_val)

    def _dcache_slot_needs(self, job):
        """Return (download, upload) needs for a job.

        Legacy dcache_transfer_slots consumes both pools only when directional
        metadata is absent. Updated clients may also send a legacy fallback for
        rolling upgrades; a new manager ignores it when a direction is known.
        """
        # Updated clients send dCache metadata as a fallback alongside a native
        # S3 request. Do not charge those fallbacks once this manager can see
        # the independent S3 pool.
        if self._s3_download_slot_need(job) > 0.0:
            return 0.0, 0.0
        legacy = float(getattr(job, 'dcache_transfer_slots', 0.0) or 0.0)
        download = float(getattr(job, 'dcache_download_slots', 0.0) or 0.0)
        upload = float(getattr(job, 'dcache_upload_slots', 0.0) or 0.0)
        if download > 0.0 or upload > 0.0:
            return download, upload
        return legacy, legacy

    @staticmethod
    def _s3_download_slot_need(job):
        return float(getattr(job, 's3_download_slots', 0.0) or 0.0)

    def _dcache_transfer_fits_locked(self, job, download_available=None,
                                     upload_available=None,
                                     s3_download_available=None):
        download_need, upload_need = self._dcache_slot_needs(job)
        s3_download_need = self._s3_download_slot_need(job)
        if download_available is None:
            download_available = self.dcache_download_total - self.dcache_download_inuse
        if upload_available is None:
            upload_available = self.dcache_upload_total - self.dcache_upload_inuse
        if s3_download_available is None:
            s3_download_available = self.s3_download_total - self.s3_download_inuse
        return (download_need <= max(0.0, float(download_available)) and
                upload_need <= max(0.0, float(upload_available)) and
                s3_download_need <= max(0.0, float(s3_download_available)))

    def _reserve_dcache_transfer_locked(self, job):
        download_need, upload_need = self._dcache_slot_needs(job)
        self.dcache_download_inuse += download_need
        self.dcache_upload_inuse += upload_need
        self.s3_download_inuse += self._s3_download_slot_need(job)
        self._eligible_cache_ts = 0.0

    def _release_dcache_transfer_locked(self, job):
        download_need, upload_need = self._dcache_slot_needs(job)
        self.dcache_download_inuse = max(
            0.0, self.dcache_download_inuse - download_need
        )
        self.dcache_upload_inuse = max(
            0.0, self.dcache_upload_inuse - upload_need
        )
        self.s3_download_inuse = max(
            0.0, self.s3_download_inuse - self._s3_download_slot_need(job)
        )
        self._eligible_cache_ts = 0.0

    def configure_transfer_limits(self, config):
        """Load dCache and S3 transfer limits from manager configuration."""
        cfg = config or {}
        legacy_total = cfg.get('dcache_transfer_slots', 4)
        raw_download = cfg.get('dcache_download_slots', legacy_total)
        raw_upload = cfg.get('dcache_upload_slots', legacy_total)
        raw_s3_download = cfg.get('s3_download_slots', 4)
        try:
            download_total = max(0.0, float(raw_download))
        except Exception:
            download_total = 4.0
        try:
            upload_total = max(0.0, float(raw_upload))
        except Exception:
            upload_total = 4.0
        try:
            s3_download_total = max(0.0, float(raw_s3_download))
        except Exception:
            s3_download_total = 4.0
        self.lock.acquire()
        try:
            self.dcache_download_total = download_total
            self.dcache_upload_total = upload_total
            self.s3_download_total = s3_download_total
            self._eligible_cache_ts = 0.0
        finally:
            self.lock.release()

    def _any_ssd_engine_available(self, need_gb):
        """True if some engine can host an ssd_use=='required' job needing need_gb of
        node-local SSD. Read-only, lock-free scan of the engine table (same style as
        the scheduler's other engine reads) so it is safe to call under jobs.lock
        without taking engines.lock (avoids lock-order inversion). Fails OPEN (True)
        if the table cannot be read, so a job is never marked ineligible by accident."""
        try:
            need = max(0.0, float(need_gb or 0.0))
        except Exception:
            need = 0.0
        try:
            eng = list(engines.engine_by_id.values())
        except Exception:
            return True
        for e in eng:
            if not getattr(e, 'has_ssd', False):
                continue
            if need <= 0.0:
                return True
            total = float(getattr(e, 'ssd_total_gb', 0.0) or 0.0)
            reserved = float(getattr(e, 'res_ssd_reserved_gb', 0.0) or 0.0)
            if (total - reserved) >= need:
                return True
        return False

    def _is_job_eligible_locked(self, job):
        st = getattr(job, 'state', None)
        if st == 'ASSIGNED':
            return True
        if st not in queue_states:
            return False
        if not self._dependency_allows_run_locked(job):
            return False
        if not self._resource_fits_locked(self.active_total, self.active_inuse, getattr(job, 'active_start_use_add', 0.0)):
            return False
        if not self._resource_fits_locked(self.dcache_total, self.dcache_inuse, getattr(job, 'dcache_start_use_add', 0.0)):
            return False
        if not self._resource_fits_locked(self.archive_total, self.archive_inuse, getattr(job, 'archive_start_use_add', 0.0)):
            return False
        if not self._dcache_transfer_fits_locked(job):
            return False
        # A job that hard-requires node-local SSD is only genuinely startable if some
        # engine actually has SSD with room. Without this, ssd_use=required jobs with
        # zero SSD engines inflate the reported "eligible" count while never placing.
        if str(getattr(job, 'ssd_use', 'no') or 'no') == 'required':
            if not self._any_ssd_engine_available(getattr(job, 'ssd_gb', 0.0)):
                return False
        return True

    def _recompute_eligible_counts_locked(self):
        now = time.time()
        if (now - self._eligible_cache_ts) < self._eligible_cache_ttl:
            return

        counts = {}
        download_available = max(
            0.0, self.dcache_download_total - self.dcache_download_inuse
        )
        upload_available = max(
            0.0, self.dcache_upload_total - self.dcache_upload_inuse
        )
        s3_download_available = max(
            0.0, self.s3_download_total - self.s3_download_inuse
        )
        for job in list(self.jobs_by_id.values()):
            if self._is_job_eligible_locked(job):
                if (
                    getattr(job, 'state', None) in queue_states
                    and not self._dcache_transfer_fits_locked(
                        job, download_available, upload_available,
                        s3_download_available
                    )
                ):
                    continue
                if getattr(job, 'state', None) in queue_states:
                    download_need, upload_need = self._dcache_slot_needs(job)
                    download_available -= download_need
                    upload_available -= upload_need
                    s3_download_available -= self._s3_download_slot_need(job)
                part = str(getattr(job, 'partition', 'compute') or 'compute')
                counts[part] = counts.get(part, 0) + 1

        self.eligible_jobs = counts
        self._eligible_cache_ts = now

    # ---- Agent / programmatic interface (read) -----------------------------
    def get_status_json(self):
        """Machine-readable budget + scheduler snapshot for an autonomous agent.

        The three storage budgets are not exposed by queue_stats(); this is the
        only place they are readable over RPC. pending_add is the sum of the
        *_start_use_add of dependency-ready PENDING/REQUEUED jobs (i.e. demand
        that can compete for resources but has not yet been reserved), and
        min_pending_add is the smallest positive add per tier (used by the
        budget_stall alarm in zsstatus)."""
        self.lock.acquire()
        try:
            pend_add = {'active': 0.0, 'dcache': 0.0, 'archive': 0.0}
            min_add = {'active': None, 'dcache': None, 'archive': None}
            pending_download_slots = 0.0
            pending_upload_slots = 0.0
            pending_s3_download_slots = 0.0
            pending_legacy_slots = 0.0
            n_pending = 0
            n_budget_pending = 0
            dependency_counts = {
                DEPENDENCY_WAITING: 0,
                DEPENDENCY_NEVER_SATISFIED: 0,
            }
            for job in self.jobs_by_id.values():
                if getattr(job, 'state', None) not in queue_states:
                    continue
                n_pending += 1
                dependency_state, _reason = self._dependency_status_locked(job)
                if dependency_state in dependency_counts:
                    dependency_counts[dependency_state] += 1
                if dependency_state != DEPENDENCY_SATISFIED:
                    continue
                download_need, upload_need = self._dcache_slot_needs(job)
                pending_download_slots += download_need
                pending_upload_slots += upload_need
                pending_s3_download_slots += self._s3_download_slot_need(job)
                pending_legacy_slots += float(
                    getattr(job, 'dcache_transfer_slots', 0.0) or 0.0
                )
                vals = {
                    'active': float(getattr(job, 'active_start_use_add', 0.0) or 0.0),
                    'dcache': float(getattr(job, 'dcache_start_use_add', 0.0) or 0.0),
                    'archive': float(getattr(job, 'archive_start_use_add', 0.0) or 0.0),
                }
                if any(v > 0 for v in vals.values()):
                    n_budget_pending += 1
                for k, v in vals.items():
                    pend_add[k] += v
                    if v > 0 and (min_add[k] is None or v < min_add[k]):
                        min_add[k] = v
            budgets = {
                'active':  {'total': float(self.active_total),  'inuse': float(self.active_inuse),  'pending_add': pend_add['active'],  'min_pending_add': min_add['active']},
                'dcache':  {'total': float(self.dcache_total),  'inuse': float(self.dcache_inuse),  'pending_add': pend_add['dcache'],  'min_pending_add': min_add['dcache']},
                'archive': {'total': float(self.archive_total), 'inuse': float(self.archive_inuse), 'pending_add': pend_add['archive'], 'min_pending_add': min_add['archive']},
            }
            cfg = getattr(status, 'config', {}) or {}
            return {
                'budgets': budgets,
                'dcache_transfers': {
                    'download': {
                        'total_slots': float(self.dcache_download_total),
                        'inuse_slots': float(self.dcache_download_inuse),
                        'pending_slots': pending_download_slots,
                    },
                    'upload': {
                        'total_slots': float(self.dcache_upload_total),
                        'inuse_slots': float(self.dcache_upload_inuse),
                        'pending_slots': pending_upload_slots,
                    },
                    'legacy_pending_slots': pending_legacy_slots,
                },
                's3_transfers': {
                    'download': {
                        'total_slots': float(self.s3_download_total),
                        'inuse_slots': float(self.s3_download_inuse),
                        'pending_slots': pending_s3_download_slots,
                    },
                },
                'scheduler': {
                    'lastin_first': bool(status.lastin_first),
                    'prio_fillmem_context': int(status.prio_fillmem_context),
                    'autogrow_enable': bool(status.autogrow_enable),
                    'autoconsolidate_enable': bool(status.autoconsolidate_enable),
                    'autogrow_max_compute_nodes': int(cfg.get('autogrow_max_compute_nodes', 0) or 0),
                },
                'pending_jobs': n_pending,
                'budgeted_pending_jobs': n_budget_pending,
                'dependency_waiting_jobs': dependency_counts[DEPENDENCY_WAITING],
                'dependency_never_satisfied_jobs': dependency_counts[DEPENDENCY_NEVER_SATISFIED],
            }
        finally:
            self.lock.release()

    def match_jobs(self, pattern):
        """Return [[jobid, name, state, partition], ...] for jobs whose name
        contains pattern. Dry-run helper before any prioritize/cancel-by-pattern."""
        pat = str(pattern)
        out = []
        self.lock.acquire()
        try:
            for jobid, job in self.jobs_by_id.items():
                if pat in str(getattr(job, 'job_name', '')):
                    out.append([jobid, job.job_name, job.state, job.partition])
            return out
        finally:
            self.lock.release()

    def whatif_budget(self, active_total=None, dcache_total=None, archive_total=None):
        """Read-only: how many PENDING jobs would be budget-eligible per partition
        at the proposed totals vs now. Reuses the same total>=inuse+add invariant
        the scheduler enforces; does NOT mutate state."""
        def fits(total, inuse, need):
            try:
                need = float(need)
            except Exception:
                need = 0.0
            return need <= 0.0 or float(total) >= float(inuse) + need
        self.lock.acquire()
        try:
            at = self.active_total if active_total is None else float(active_total)
            dt = self.dcache_total if dcache_total is None else float(dcache_total)
            rt = self.archive_total if archive_total is None else float(archive_total)
            cur = {}
            new = {}
            for job in self.jobs_by_id.values():
                if getattr(job, 'state', None) not in queue_states:
                    continue
                part = str(getattr(job, 'partition', 'compute') or 'compute')
                a = getattr(job, 'active_start_use_add', 0.0)
                d = getattr(job, 'dcache_start_use_add', 0.0)
                r = getattr(job, 'archive_start_use_add', 0.0)
                cur_ok = (fits(self.active_total, self.active_inuse, a)
                          and fits(self.dcache_total, self.dcache_inuse, d)
                          and fits(self.archive_total, self.archive_inuse, r))
                new_ok = (fits(at, self.active_inuse, a)
                          and fits(dt, self.dcache_inuse, d)
                          and fits(rt, self.archive_inuse, r))
                cur[part] = cur.get(part, 0) + (1 if cur_ok else 0)
                new[part] = new.get(part, 0) + (1 if new_ok else 0)
            delta = {p: new.get(p, 0) - cur.get(p, 0) for p in set(list(cur) + list(new))}
            return {
                'proposed_totals': {'active': at, 'dcache': dt, 'archive': rt},
                'current_eligible_by_partition': cur,
                'whatif_eligible_by_partition': new,
                'delta_by_partition': delta,
            }
        finally:
            self.lock.release()

    # ---- Agent / programmatic interface (write) ----------------------------
    def set_budgets(self, active_total=None, dcache_total=None, archive_total=None,
                    active_inuse=None, dcache_inuse=None, archive_inuse=None):
        """Set the three storage-budget totals/inuse the TUI keys 1-6 set. Takes
        jobs.lock (the TUI path does not; this is intentional hardening) and forces
        the eligible-count cache to recompute so a stall clears immediately.

        total < inuse is allowed (matches the TUI): it does not corrupt anything, it
        simply means "over budget" and blocks further budgeted dispatch until inuse
        drains -- the intended back-pressure. Use recompute_inuse_from_running() to
        re-derive inuse from running jobs if it has drifted."""
        self.lock.acquire()
        try:
            if active_total is not None:
                self.active_total = float(active_total)
            if dcache_total is not None:
                self.dcache_total = float(dcache_total)
            if archive_total is not None:
                self.archive_total = float(archive_total)
            if active_inuse is not None:
                self.active_inuse = float(active_inuse)
            if dcache_inuse is not None:
                self.dcache_inuse = float(dcache_inuse)
            if archive_inuse is not None:
                self.archive_inuse = float(archive_inuse)
            self._eligible_cache_ts = 0.0
            return {
                'active':  {'total': float(self.active_total),  'inuse': float(self.active_inuse)},
                'dcache':  {'total': float(self.dcache_total),  'inuse': float(self.dcache_inuse)},
                'archive': {'total': float(self.archive_total), 'inuse': float(self.archive_inuse)},
            }
        finally:
            self.lock.release()

    def set_transfer_limits(self, download_total=None, upload_total=None,
                            s3_download_total=None):
        """Set transfer concurrency without changing in-use reservations."""
        self.lock.acquire()
        try:
            if download_total is not None:
                self.dcache_download_total = max(0.0, float(download_total))
            if upload_total is not None:
                self.dcache_upload_total = max(0.0, float(upload_total))
            if s3_download_total is not None:
                self.s3_download_total = max(0.0, float(s3_download_total))
            self._eligible_cache_ts = 0.0
            return {
                'download': {
                    'total_slots': float(self.dcache_download_total),
                    'inuse_slots': float(self.dcache_download_inuse),
                },
                'upload': {
                    'total_slots': float(self.dcache_upload_total),
                    'inuse_slots': float(self.dcache_upload_inuse),
                },
                's3_download': {
                    'total_slots': float(self.s3_download_total),
                    'inuse_slots': float(self.s3_download_inuse),
                },
            }
        finally:
            self.lock.release()

    def list_jobs_detailed(self, owner=None, states=None):
        """Like list_jobs but named-key dicts with the extra signals an agent needs
        to spot stuck / OOM-looping jobs: requeue_remaining, current vs reserved mem
        (mem_pressure), runtime. Separate from list_jobs so the 14-field positional
        tuple (consumed by zsqueue and the Snakemake plugin) stays stable."""
        want_states = set(states) if states else None
        out = []
        self.lock.acquire()
        try:
            now = time.time()
            for job in self.jobs_by_id.values():
                if owner is not None and str(getattr(job, 'owner', None)) != str(owner):
                    continue
                st = getattr(job, 'state', None)
                if want_states is not None and st not in want_states:
                    continue
                dependency_state, dependency_reason = (
                    self._dependency_status_locked(job)
                )
                max_cores = float(getattr(job, 'max_ncpu', job.ncpu) or 0.0)
                max_mem = float(getattr(job, 'max_mem', job.mem) or 0.0)
                if st == "RUNNING":
                    held_cores = float(
                        getattr(job, 'held_ncpu', max_cores) or 0.0
                    )
                    mem_res = float(getattr(job, 'held_mem', max_mem) or 0.0)
                else:
                    held_cores = max_cores
                    mem_res = max_mem
                cur_mem = float(getattr(job, 'current_mem_usage', 0.0) or 0.0)
                runtime = (now - job.starttime) if getattr(job, 'starttime', None) else 0.0
                out.append({
                    'jobid': str(job.jobid),
                    'name': job.job_name,
                    'state': st,
                    'partition': job.partition,
                    'node': job.node_id if job.node_id is not None else "(Resources)",
                    'cores': held_cores,
                    'mem_reserved_mb': mem_res,
                    'max_cores': max_cores,
                    'max_mem_mb': max_mem,
                    'lease_epoch': int(getattr(job, 'lease_epoch', 0) or 0),
                    'current_mem_mb': cur_mem,
                    'mem_pressure': (cur_mem / mem_res) if mem_res > 0 else 0.0,
                    'current_cpu': float(getattr(job, 'current_cpu_usage', 0.0) or 0.0),
                    'runtime_s': float(runtime),
                    'requeue_remaining': int(getattr(job, 'requeue', 0) or 0),
                    'reqtime_s': float(getattr(job, 'reqtime', 0.0) or 0.0),
                    'active_use_gb': float(getattr(job, 'active_start_use_add', 0.0) - getattr(job, 'active_end_use_remove', 0.0)),
                    'dcache_use_gb': float(getattr(job, 'dcache_start_use_add', 0.0) - getattr(job, 'dcache_end_use_remove', 0.0)),
                    'arch_use_gb': float(getattr(job, 'archive_start_use_add', 0.0) - getattr(job, 'archive_end_use_remove', 0.0)),
                    'ssd_use': getattr(job, 'ssd_use', 'no'),
                    'ssd_gb': float(getattr(job, 'ssd_gb', 0.0) or 0.0),
                    'dcache_download_slots': float(
                        getattr(job, 'dcache_download_slots', 0.0) or 0.0
                    ),
                    'dcache_upload_slots': float(
                        getattr(job, 'dcache_upload_slots', 0.0) or 0.0
                    ),
                    'dcache_transfer_slots_legacy': float(
                        getattr(job, 'dcache_transfer_slots', 0.0) or 0.0
                    ),
                    's3_download_slots': float(
                        getattr(job, 's3_download_slots', 0.0) or 0.0
                    ),
                    'priority': int(getattr(job, 'priority', 0) or 0),
                    'dependency': getattr(job, 'dependency', None),
                    'dependency_state': dependency_state,
                    'dependency_reason': dependency_reason,
                    'comment': getattr(job, 'comment', ''),
                })
            return out
        finally:
            self.lock.release()

    def recompute_inuse_from_running(self):
        """Repair storage-budget drift: recompute each *_inuse as the sum of
        *_start_use_add over jobs currently RUNNING or ASSIGNED. Useful after a
        crash/restart or a missed reconcile (poll re-reservation can double-count).
        Returns the before/after inuse values."""
        self.lock.acquire()
        try:
            before = {'active': float(self.active_inuse), 'dcache': float(self.dcache_inuse),
                      'archive': float(self.archive_inuse),
                      'dcache_downloads': float(self.dcache_download_inuse),
                      'dcache_uploads': float(self.dcache_upload_inuse),
                      's3_downloads': float(self.s3_download_inuse)}
            sums = {'active': 0.0, 'dcache': 0.0, 'archive': 0.0,
                    'dcache_downloads': 0.0, 'dcache_uploads': 0.0,
                    's3_downloads': 0.0}
            for job in self.jobs_by_id.values():
                if getattr(job, 'state', None) in ('RUNNING', 'ASSIGNED'):
                    sums['active'] += float(getattr(job, 'active_start_use_add', 0.0) or 0.0)
                    sums['dcache'] += float(getattr(job, 'dcache_start_use_add', 0.0) or 0.0)
                    sums['archive'] += float(getattr(job, 'archive_start_use_add', 0.0) or 0.0)
                    download_need, upload_need = self._dcache_slot_needs(job)
                    sums['dcache_downloads'] += download_need
                    sums['dcache_uploads'] += upload_need
                    sums['s3_downloads'] += self._s3_download_slot_need(job)
            self.active_inuse = sums['active']
            self.dcache_inuse = sums['dcache']
            self.archive_inuse = sums['archive']
            self.dcache_download_inuse = sums['dcache_downloads']
            self.dcache_upload_inuse = sums['dcache_uploads']
            self.s3_download_inuse = sums['s3_downloads']
            self._eligible_cache_ts = 0.0
            return {'before': before, 'after': sums}
        finally:
            self.lock.release()

    def forecast_budget(self, plan):
        """Read-only: will a planned set of jobs fit the three storage budgets?

        plan = [ {name, partition, ncpu, mem, reqtime,
                  active_use_add, active_use_remove, dcache_use_add, dcache_use_remove,
                  arch_use_add|archive_use_add, arch_use_remove|archive_use_remove,
                  depends_on:[names]}, ... ]

        Two bounds per tier, starting from live inuse:
          worst_case_peak = inuse + sum(all *_use_add)   (every job reserved, none released)
          optimistic_peak = peak of a perfectly-serialized run in dependency order
                            (each job adds at start, releases its remove before the next)
        Verdict per tier:  worst<=total -> SAFE (any order);
          optimistic<=total<worst -> ORDER_SENSITIVE (feasible if depth-first/LIFO drains);
          optimistic>total -> INFEASIBLE.
        Overall verdict is the worst tier. Also reports the first job at which the
        optimistic peak crosses the total (first_blocking_job) and a light compute fit."""
        def g(d, *keys):
            for k in keys:
                if k in d and d[k] is not None:
                    try:
                        return float(d[k])
                    except Exception:
                        return 0.0
            return 0.0

        # normalize plan items
        items = []
        for i, j in enumerate(plan or []):
            j = j or {}
            items.append({
                'name': str(j.get('name', f'job{i}')),
                'partition': str(j.get('partition', 'compute') or 'compute'),
                'ncpu': g(j, 'ncpu', 'n', 'cores'),
                'mem': g(j, 'mem', 'mem_mb'),
                'add': {'active': g(j, 'active_use_add'), 'dcache': g(j, 'dcache_use_add'),
                        'archive': g(j, 'arch_use_add', 'archive_use_add')},
                'rem': {'active': g(j, 'active_use_remove'), 'dcache': g(j, 'dcache_use_remove'),
                        'archive': g(j, 'arch_use_remove', 'archive_use_remove')},
                'depends_on': list(j.get('depends_on', []) or []),
            })

        # topological order by depends_on (fall back to given order on cycle/missing)
        had_deps = any(it['depends_on'] for it in items)
        order = items
        try:
            byname = {it['name']: it for it in items}
            indeg = {it['name']: 0 for it in items}
            adj = {it['name']: [] for it in items}
            for it in items:
                for dep in it['depends_on']:
                    if dep in byname:
                        adj[dep].append(it['name'])
                        indeg[it['name']] += 1
            ready = [n for n in indeg if indeg[n] == 0]
            topo = []
            while ready:
                n = ready.pop(0)
                topo.append(byname[n])
                for m in adj[n]:
                    indeg[m] -= 1
                    if indeg[m] == 0:
                        ready.append(m)
            if len(topo) == len(items):
                order = topo
        except Exception:
            order = items

        # Snapshot engine maxima under engines.lock FIRST, then take jobs.lock for
        # budgets. Acquiring the two locks sequentially (never nested) avoids both a
        # lock-ordering deadlock and a concurrent-modification race on engine_by_id.
        try:
            engines.lock.acquire()
            try:
                eng = list(engines.engine_by_id.values())
            finally:
                engines.lock.release()
            max_eng_cores = max([float(getattr(e, 'cores', 0.0) or 0.0) for e in eng], default=0.0)
            max_eng_mem = max([float(getattr(e, 'totmem', 0.0) or 0.0) for e in eng], default=0.0)
        except Exception:
            max_eng_cores = max_eng_mem = 0.0

        self.lock.acquire()
        try:
            live = {'active': float(self.active_inuse), 'dcache': float(self.dcache_inuse),
                    'archive': float(self.archive_inuse)}
            totals = {'active': float(self.active_total), 'dcache': float(self.dcache_total),
                      'archive': float(self.archive_total)}
        finally:
            self.lock.release()

        tiers = ('active', 'dcache', 'archive')
        worst = {t: live[t] + sum(it['add'][t] for it in items) for t in tiers}
        opt_peak = {t: live[t] for t in tiers}
        running = {t: live[t] for t in tiers}
        first_block = {t: None for t in tiers}
        for it in order:
            for t in tiers:
                during = running[t] + it['add'][t]
                if during > opt_peak[t]:
                    opt_peak[t] = during
                if first_block[t] is None and it['add'][t] > 0 and during > totals[t]:
                    first_block[t] = it['name']
                running[t] = running[t] + it['add'][t] - it['rem'][t]

        def verdict_for(t):
            if worst[t] <= totals[t]:
                return 'SAFE'
            if opt_peak[t] <= totals[t]:
                return 'ORDER_SENSITIVE'
            return 'INFEASIBLE'

        rank = {'SAFE': 0, 'ORDER_SENSITIVE': 1, 'INFEASIBLE': 2}
        per_tier = {}
        overall = 'SAFE'
        for t in tiers:
            v = verdict_for(t)
            per_tier[t] = {
                'total': totals[t], 'current_inuse': live[t],
                'plan_add_total': sum(it['add'][t] for it in items),
                'worst_case_peak': worst[t], 'optimistic_peak': opt_peak[t],
                'headroom': totals[t] - live[t], 'verdict': v,
                'first_blocking_job': first_block[t],
            }
            if rank[v] > rank[overall]:
                overall = v

        sum_cores = sum(it['ncpu'] for it in items)
        max_job_cores = max([it['ncpu'] for it in items], default=0.0)
        max_job_mem = max([it['mem'] for it in items], default=0.0)
        compute = {
            'jobs': len(items),
            'sum_cores': sum_cores,
            'max_single_job_cores': max_job_cores,
            'max_single_job_mem_mb': max_job_mem,
            'max_engine_cores': max_eng_cores,
            'max_engine_totmem_mb': max_eng_mem,
            'oversized_job': bool(max_eng_cores > 0 and max_job_cores > max_eng_cores)
                             or bool(max_eng_mem > 0 and max_job_mem > max_eng_mem),
        }
        return {'verdict': overall, 'budgets': per_tier, 'compute': compute,
                'ordered_by_dependencies': bool(had_deps and order is not items)}

    def get_job_stats(self):
        self.lock.acquire()
        try:
            self._recompute_eligible_counts_locked()
            return (
                self.total_jobs,
                self.running_jobs,
                self.eligible_jobs,
                self.failed_jobs,
                self.done_jobs,
            )
        finally:
            self.lock.release()

    def active_engines(self):
        nodes = set()
        for job in list(self.jobs_by_id.values()):
            if not job.node_id is None:
                nodes.add(job.node_id)
        return nodes

    def _jobs_in_priority_order(self, lastin_first=False):
        """Return jobs ordered by numeric priority, preserving legacy order as
        the tie-breaker.

        Higher numbers run first. FIFO remains the default within a priority
        band; the existing compute-only LIFO mode reverses only that band. A
        bucketed implementation avoids sorting every individual job when many
        jobs share the same per-pipeline priority.
        """
        buckets = {}
        for job in self.jobs_by_id.values():
            try:
                priority = int(getattr(job, 'priority', 0) or 0)
            except (TypeError, ValueError):
                priority = 0
            buckets.setdefault(priority, []).append(job)

        ordered = []
        for priority in sorted(buckets, reverse=True):
            bucket = buckets[priority]
            if lastin_first:
                bucket = reversed(bucket)
            ordered.extend(bucket)
        return ordered

    def prioritize(self, job_pattern):
        self._reorder_jobs(job_pattern, not status.lastin_first)

    def deprioritize(self, job_pattern):
        self._reorder_jobs(job_pattern, status.lastin_first)

    def _reorder_jobs(self, job_pattern, up=True):
        self.lock.acquire()
        try:
            ndict = OrderedDict()
            if up:
                for jobid, job in list(self.jobs_by_id.items()):
                    if job_pattern in job.job_name:
                        ndict[jobid] = job
                for jobid, job in list(self.jobs_by_id.items()):
                    if not job_pattern in job.job_name:
                        ndict[jobid] = job
            else:
                for jobid, job in list(self.jobs_by_id.items()):
                    if not job_pattern in job.job_name:
                        ndict[jobid] = job
                for jobid, job in list(self.jobs_by_id.items()):
                    if job_pattern in job.job_name:
                        ndict[jobid] = job

            self.jobs_by_id = ndict
        finally:
            self.lock.release()

    def submit_job(
        self,
        job_name,
        cmd,
        cwd,
        env,
        ncpu,
        mem,
        reqtime,
        requeue,
        dependency,
        arch_use_add,
        arch_use_remove,
        dcache_use_add,
        dcache_use_remove,
        active_use_add,
        active_use_remove,
        partition,
        info_input_mb,
        info_output_file,
        comment="",
        ssd_use='no',
        ssd_gb=0,
        owner=None,
        idempotency_key=None,
        priority=DEFAULT_JOB_PRIORITY
    ):
        # weird xml-rpc problem?
        if len(env) == 1 and "data" in env:
            env = env["data"]

        def transfer_slots_from_env(name):
            try:
                return max(0.0, float(env.get(name, 0.0)))
            except Exception:
                return 0.0

        dcache_transfer_slots = transfer_slots_from_env(
            "ZSLURM_DCACHE_TRANSFER_SLOTS"
        )
        dcache_download_slots = transfer_slots_from_env(
            "ZSLURM_DCACHE_DOWNLOAD_SLOTS"
        )
        dcache_upload_slots = transfer_slots_from_env(
            "ZSLURM_DCACHE_UPLOAD_SLOTS"
        )
        s3_download_slots = transfer_slots_from_env(
            "ZSLURM_S3_DOWNLOAD_SLOTS"
        )
        parsed_dependency = parse_job_dependency(dependency)

        # Idempotency, dependency validation (including singleton predecessor
        # capture), id allocation and insertion are one atomic operation.  This
        # prevents concurrent singleton submissions from overlooking each other.
        self.lock.acquire()
        try:
            existing = (
                self.seen_tokens.get(str(idempotency_key))
                if idempotency_key else None
            )
            if existing is None:
                dependency_spec = self._prepare_dependency_locked(
                    parsed_dependency, job_name, owner, env
                )
                jobid = str(self.jobid_counter)
                self.jobid_counter += 1
                job = Job(
                    job_name,
                    jobid,
                    cmd,
                    cwd,
                    env,
                    ncpu,
                    mem,
                    reqtime,
                    requeue,
                    dependency,
                    float(arch_use_add),
                    float(arch_use_remove),
                    float(dcache_use_add),
                    float(dcache_use_remove),
                    float(active_use_add),
                    float(active_use_remove),
                    partition,
                    info_input_mb,
                    info_output_file,
                    comment,
                    ssd_use,
                    ssd_gb,
                    dcache_transfer_slots,
                    owner,
                    priority,
                    dcache_download_slots,
                    dcache_upload_slots,
                    s3_download_slots
                )
                job.dependency_spec = dependency_spec
                self.jobs_by_id[jobid] = job
                self.total_jobs[partition] = self.total_jobs.get(partition, 0) + 1
                self._eligible_cache_ts = 0.0
                if idempotency_key:
                    self.seen_tokens[str(idempotency_key)] = jobid
        finally:
            self.lock.release()

        if existing is not None:
            add_log_line(gb, f"Job {job_name} idempotency_key={idempotency_key} replayed -> jobid {existing}", YELLOW)
            return existing

        if (
            arch_use_add
            or arch_use_remove
            or dcache_use_add
            or dcache_use_remove
            or active_use_add
            or active_use_remove
            or dcache_transfer_slots
            or dcache_download_slots
            or dcache_upload_slots
            or s3_download_slots
        ):
            add_log_line(
                gb,
                f"Job {job_name} (id: {jobid}, priority: {job.priority}, ncore: {ncpu}, mem: {mem} mb, partition: {partition}, arch+: {arch_use_add} GB, arch-: {arch_use_remove} GB, d+: {dcache_use_add} GB, d-: {dcache_use_remove} GB, active+: {active_use_add} GB, active-: {active_use_remove} GB, dcache-download: {dcache_download_slots}, dcache-upload: {dcache_upload_slots}, s3-download: {s3_download_slots}, dcache-transfer-legacy: {dcache_transfer_slots}) submitted.",
                 GREEN,
            )
        else:
            add_log_line(
                gb,
                f"Job {job_name} (id: {jobid}, priority: {job.priority}, ncore: {ncpu}, mem: {mem} mb, partition: {partition}) submitted.",
                GREEN,
            )
        return jobid

    def cancel_job(self, jobid, requeue=False):
        self.lock.acquire()
        try:
            job = None
            if jobid in self.jobs_by_id:
                job = self.jobs_by_id[jobid]
                # A normal cancel must be terminal in every state. Without this
                # reset, PENDING/ASSIGNED jobs with retries left are requeued by
                # job_done() and then merely relabelled CANCELLED while still
                # present in jobs_by_id.
                if not requeue:
                    job.requeue = 0
                if job.state == "RUNNING":
                    node_id = job.node_id
                    if requeue:
                        job.requeue = max(job.requeue, 1)
                        job.reason = "Cancelling for restart"
                    else:
                        job.reason = "Awaiting cancellation at worker node"

                    try:
                        engines.send_command(node_id, zslurm_shared.CANCEL, jobid)
                    except:
                        pass

                    add_log_line(
                        gb,
                        "Job %s (id: %s, running on %s) has been send a cancel signal."
                        % (job.job_name, job.jobid, job.node_id),
                        YELLOW,
                    )
                    # now wait for cancel to propagate
                elif job.state == "ASSIGNED" and not requeue:
                    node_id = job.node_id
                    try:
                        engines.send_command(node_id, zslurm_shared.DEASSIGN, jobid)
                    except:
                        pass
                    self.job_done(job.jobid, RC_CANCELLED, "Cancelled by user")
                    
                elif not requeue:
                    self.job_done(job.jobid, RC_CANCELLED, "Cancelled by user")
                    add_log_line(
                        gb,
                        "Job %s (id: %s) cancelled." % (job.job_name, job.jobid),
                        YELLOW,
                    )
                    
            else:
                add_log_line(
                    gb, "Attempt to cancel unknown job (id: %s)." % jobid, YELLOW
                )
        finally:
            self.lock.release()

    def list_done_jobs(self, last_seen_jobid=None, owner=None,
                           include_priority=False):
        def serialize(job):
            if not job.starttime is None:
                runtime = job.endtime - job.starttime
            else:
                runtime = 0.0

            arch_use = job.archive_start_use_add - job.archive_end_use_remove
            active_use = job.active_start_use_add - job.active_end_use_remove
            dcache_use = job.dcache_start_use_add - job.dcache_end_use_remove

            return [
                job.jobid,
                job.job_name,
                job.state,
                runtime,
                job.ncpu,
                job.partition,
                job.node_id,
                job.current_cpu_usage,
                job.current_mem_usage,
                arch_use,
                active_use,
                dcache_use,
                job.cwd,
                job.comment,
            ] + ([int(getattr(job, 'priority', DEFAULT_JOB_PRIORITY))]
                 if include_priority else [])

        jobs = []
        target_jobid = None if last_seen_jobid is None else str(last_seen_jobid)
        target_owner = None if owner is None else str(owner)

        if owner is not None:
            jobs = self.finished_jobs_by_owner.get(target_owner, [])
        else:
            # materialize: reversed() below needs a sequence, and an itertools.chain
            # is not reversible (raised "'itertools.chain' object is not reversible").
            jobs = list(itertools.chain(*self.finished_jobs_by_owner.values()))
        

        results = []
        if target_jobid is not None and target_owner is not None:
            for job in reversed(jobs):            
                if str(job.jobid) == target_jobid:            
                    break           
                results.append(serialize(job))
        else:
            results = [serialize(job) for job in reversed(jobs)]

        return results

    def get_job_states(self, jobids, owner=None):
        """Return owner-scoped states for exact job ids.

        Unlike list_done_jobs(), this uses the compact terminal outcome index,
        so correctness does not depend on the bounded presentation history or
        on a polling cursor remaining inside that history window.
        """
        requested = []
        seen = set()
        for jobid in jobids or []:
            value = str(jobid)
            if value not in seen:
                seen.add(value)
                requested.append(value)

        target_owner = None if owner is None else str(owner)
        states = {}
        terminal = []
        with self.lock:
            for jobid in requested:
                job = self.jobs_by_id.get(jobid)
                if job is not None:
                    job_owner = getattr(job, "owner", None)
                    if (target_owner is None
                            or str(job_owner) == target_owner):
                        states[jobid] = str(getattr(job, "state", ""))
                    continue

                outcome = self.dependency_history.get(jobid)
                if outcome is None:
                    continue
                outcome_owner = outcome.get("owner")
                if (target_owner is None
                        # Snapshots from managers predating this RPC have no
                        # owner field. Exact ids are manager-global, so allow
                        # those legacy tombstones to repair in-flight clients.
                        or "owner" not in outcome
                        or ("owner" in outcome
                            and str(outcome_owner) == target_owner)):
                    states[jobid] = str(outcome.get("state", ""))
                    terminal.append(jobid)

        return {
            "schema_version": 1,
            "states": states,
            "terminal": terminal,
            "unknown": [jobid for jobid in requested if jobid not in states],
        }

    def queue_stats(self):
        # Aggregate cores/mem by status and partition
        totals = {
            'running': {'jobs': 0, 'cores': 0.0, 'mem_mb': 0.0},
            'pending': {'jobs': 0, 'cores': 0.0, 'mem_mb': 0.0},
        }
        by_part = {}
        states = {}


        for j in list(self.jobs_by_id.values()):
            part = str(getattr(j, 'partition', 'compute') or 'compute')
            st = str(getattr(j, 'state', ''))
            if st not in active_job_states:
                continue
            states[st] = states.get(st, 0) + 1
            try:
                cores = float(getattr(j, 'ncpu', 0.0))
            except Exception:
                cores = 0.0
            try:
                mem_mb = float(getattr(j, 'mem', 0.0))
            except Exception:
                mem_mb = 0.0
            if part not in by_part:
                by_part[part] = {
                    'running': {'jobs': 0, 'cores': 0.0, 'mem_mb': 0.0},
                    'pending': {'jobs': 0, 'cores': 0.0, 'mem_mb': 0.0},
                }
            is_pending = (st in queue_states) or (st == 'ASSIGNED')
            if st == 'RUNNING':
                cores = float(getattr(j, 'held_ncpu', cores) or 0.0)
                mem_mb = float(getattr(j, 'held_mem', mem_mb) or 0.0)
                buckets = (totals['running'], by_part[part]['running'])
            elif is_pending:
                buckets = (totals['pending'], by_part[part]['pending'])
            else:
                buckets = None
            if buckets is not None:
                for b in buckets:
                    b['jobs'] += 1
                    b['cores'] += cores
                    b['mem_mb'] += mem_mb

        qb = getattr(engines, 'cluster_queued_by_partition', {}) or {}
        rb = getattr(engines, 'cluster_running_by_partition', {}) or {}
        hb = getattr(engines, 'cluster_held_by_partition', {}) or {}
        qa = getattr(engines, 'cluster_queued_age_by_partition', {}) or {}
        qa_s = getattr(engines, 'cluster_queued_age_by_partition_by_scratch', {}) or {}
        engines_info = {
            'running_by_partition': dict(rb),
            'queued_by_partition': dict(qb),
            'held_by_partition': dict(hb),
            'queued_age_by_partition': dict(qa),
            'queued_age_by_partition_by_scratch': dict(qa_s),
            'running_total': int(getattr(engines, 'cluster_running_engines', 0)),
            'queued_total': int(getattr(engines, 'cluster_queued_engines', 0)),
            'held_total': int(getattr(engines, 'cluster_held_engines', 0)),
            'manager_held_total': int(len(getattr(engines, 'held_engine_cids', set()) or set())),
            'external_held_total': int(len(getattr(engines, 'external_held_engines_detail', []) or [])),
            'draining_total': int(sum(1 for e in engines.engine_by_id.values()
                                      if getattr(e, 'end_of_life_drain', False))),
        }
        return {
            'total': totals,
            'by_partition': by_part,
            'states': states,
            'engines': engines_info,
        }

    def list_jobs(self, owner=None, include_priority=False):
        jobs = []
        for job in list(self.jobs_by_id.values()):
            if getattr(job, 'state', None) not in active_job_states:
                continue
            if owner is not None and str(getattr(job, 'owner', None)) != str(owner):
                continue
            if not job.starttime is None:
                runtime = time.time() - job.starttime
            else:
                runtime = 0.0

            if job.node_id is None:
                node_id = "(Resources)"
            else:
                node_id = job.node_id
            arch_use = job.archive_start_use_add - job.archive_end_use_remove
            active_use = job.active_start_use_add - job.active_end_use_remove
            dcache_use = job.dcache_start_use_add - job.dcache_end_use_remove

            jobs.append(
                [
                    job.jobid,
                    job.job_name,
                    job.state,
                    runtime,
                    job.ncpu,
                    job.partition,
                    node_id,
                    job.current_cpu_usage,
                    job.current_mem_usage,
                    arch_use,
                    active_use,
                    dcache_use,
                    job.cwd,
                    job.comment
                ] + ([int(getattr(job, 'priority', DEFAULT_JOB_PRIORITY))]
                     if include_priority else [])
            )

        return jobs

    def request_jobs(self, myid, current_cpu, current_mem, partition):
        phaseout_window = None
        phaseout_backfill_min_age = 0.0
        now_ts = time.time()
        if not myid in engines.engine_by_id or engines.engine_by_id[myid] is None:
            timeleft = 5 * 24 * 60 * 60
            cores = 24.0
            totmem = 64000
        else:
            engine = engines.engine_by_id[myid]
            phaseout_window = None
            if engine.status == PHASING_OUT:
                # Not a flat refusal any more: an engine waiting on one long job can
                # still absorb work that is certain to finish first. See
                # phaseout_backfill_window() -- it returns 0 whenever that is not
                # clearly safe, which restores the old behaviour.
                phaseout_window = phaseout_backfill_window(engine)
                if phaseout_window <= 0:
                    return []
                phaseout_backfill_min_age = float(status.config.get(
                    "phaseout_backfill_min_job_age_sec",
                    getattr(status, 'phaseout_backfill_min_job_age_sec', 180.0)))
                # request_jobs is polled, so announce this once per engine only.
                if not getattr(engine, 'backfill_announced', False):
                    engine.backfill_announced = True
                    add_log_line(
                        gb,
                        f"Phase-out backfill: engine {engine.engine_id} waits "
                        f"{int(phaseout_window / 60)}m on its last job; accepting work "
                        f"that fits inside that window.",
                        CYAN,
                    )
            # Do not start or assign work to unmanaged cluster engines (seen as missing in squeue)
            if engine.cluster_id not in (None, False) and not engine.managed:
                add_log_line(
                    gb,
                    f"Node {myid} is currently unmanaged (cluster id {engine.cluster_id} not observed). No jobs will be assigned/started until managed again.",
                    YELLOW,
                )
                return []
            # Do not schedule work for engines that are stopping (teardown in progress)
            if engine.stopping:
                add_log_line(
                    gb,
                    f"Node {myid} is stopping. No jobs will be assigned/started until teardown completes.",
                    YELLOW,
                )
                return []
            timeleft = int(engines.engine_by_id[myid].timeleft)
            cores = float(engines.engine_by_id[myid].cores)
            totmem = engines.engine_by_id[myid].totmem
            if phaseout_window is not None:
                # Cap the horizon to the backfill window; every downstream fit check
                # already reasons against `timeleft`, so nothing else has to change.
                timeleft = min(timeleft, int(phaseout_window))
        e = engines.engine_by_id.get(myid, None)
        walltime_buffer = float(status.config.get(
            "job_walltime_buffer_sec",
            getattr(status, 'job_walltime_buffer_sec', 900.0)))

        self.lock.acquire()
        try:
            queued = []
            assigned = []

            jobs_view = self._jobs_in_priority_order(
                lastin_first=(status.lastin_first and partition != 'archive')
            )
            
            jobs_view_iter = iter(jobs_view)

            allres = []

            def _to_float(value, default=0.0):
                try:
                    if value is None:
                        return default
                    return float(value)
                except Exception:
                    return default

            def _ssd_free_gb(engine):
                if engine is None:
                    return 0.0
                total = _to_float(getattr(engine, 'ssd_total_gb', 0.0), 0.0)
                reserved = _to_float(getattr(engine, 'res_ssd_reserved_gb', 0.0), 0.0)
                return max(0.0, total - reserved)

            def _ssd_ok(job, engine):
                su = str(getattr(job, 'ssd_use', 'no') or 'no')
                need = max(0.0, _to_float(getattr(job, 'ssd_gb', 0.0), 0.0))
                has_ssd = bool(engine is not None and getattr(engine, 'has_ssd', False))
                if su == 'no':
                    return True
                if su == 'required':
                    if not has_ssd:
                        return False
                    if need > 0.0 and _ssd_free_gb(engine) < need:
                        return False
                    return True
                if su == 'possible':
                    if not has_ssd:
                        return True
                    if need > 0.0 and _ssd_free_gb(engine) < need:
                        return False
                    return True
                return True

            # Compare a job's CPU/memory shape with the node types that are
            # actually available to this manager.  This keeps fat nodes free for
            # memory-heavy jobs without hard-coding hostnames or partitions into
            # the job scheduler.  Per-candidate SSD filtering happens below.
            placement_profiles = []
            for profile_engine in list(engines.engine_by_id.values()):
                if profile_engine is None:
                    continue
                if getattr(profile_engine, 'partition', None) != partition:
                    continue
                if getattr(profile_engine, 'stopping', False):
                    continue
                if getattr(profile_engine, 'status', None) == PHASING_OUT:
                    continue
                if (
                    getattr(profile_engine, 'cluster_id', None) not in (None, False)
                    and not getattr(profile_engine, 'managed', True)
                ):
                    continue
                profile_cores = _to_float(
                    getattr(profile_engine, 'cores', 0.0), 0.0)
                profile_mem = _to_float(
                    getattr(profile_engine, 'totmem', 0.0), 0.0)
                if profile_cores <= 0.0 or profile_mem <= 0.0:
                    continue
                placement_profiles.append((
                    profile_cores,
                    profile_mem,
                    bool(getattr(profile_engine, 'has_ssd', False)),
                    _to_float(
                        getattr(profile_engine, 'ssd_total_gb', 0.0), 0.0),
                ))

            current_profile = (
                float(cores), float(totmem),
                bool(e is not None and getattr(e, 'has_ssd', False)),
                _to_float(getattr(e, 'ssd_total_gb', 0.0), 0.0),
            )
            if current_profile not in placement_profiles:
                placement_profiles.append(current_profile)

            profile_regret_cache = {}

            def _profile_regret(job):
                ssd_use = str(getattr(job, 'ssd_use', 'no') or 'no')
                ssd_need = max(
                    0.0, _to_float(getattr(job, 'ssd_gb', 0.0), 0.0))
                cache_key = (
                    float(job.ncpu), float(job.mem), ssd_use, ssd_need)
                if cache_key in profile_regret_cache:
                    return profile_regret_cache[cache_key]

                eligible_profiles = []
                for (
                    profile_cores, profile_mem, profile_has_ssd,
                    profile_ssd_total,
                ) in placement_profiles:
                    if ssd_use == 'required':
                        if not profile_has_ssd:
                            continue
                        if ssd_need > 0.0 and profile_ssd_total < ssd_need:
                            continue
                    eligible_profiles.append((profile_cores, profile_mem))

                regret = _placement_profile_regret(
                    job.ncpu, job.mem, cores, totmem, eligible_profiles)
                profile_regret_cache[cache_key] = regret
                return regret

            def eligible(job):
                if job.partition != partition:
                    return False
                if (
                    job.state != 'ASSIGNED'
                    and not self._dependency_allows_run_locked(job)
                ):
                    return False
                # Phase-out overflow gate: a draining engine may only pick up a
                # queued job after it has waited unclaimed for at least
                # phaseout_backfill_min_job_age_sec, giving the active (non-draining)
                # fleet first refusal. Inert (min_age == 0.0) on non-phasing engines.
                # ASSIGNED jobs are already committed to this engine -- never gate them.
                if phaseout_backfill_min_age > 0.0 and job.state != 'ASSIGNED':
                    if (now_ts - float(getattr(job, 'submit_ts', now_ts))) < phaseout_backfill_min_age:
                        return False
                # reqtime is an ESTIMATE, so a job that exactly fits is a job that
                # gets killed at the wall having burnt its whole runtime for nothing.
                # Require it to fit with room to spare.
                if job.reqtime + walltime_buffer > timeleft:
                    return False
                if job.ncpu > cores:
                    return False
                if job.mem > totmem:
                    return False
                if not _ssd_ok(job, e):
                    return False
                if job.active_start_use_add > 0 and (self.active_inuse + job.active_start_use_add) > self.active_total:
                    return False
                if job.dcache_start_use_add > 0 and (self.dcache_inuse + job.dcache_start_use_add) > self.dcache_total:
                    return False
                if job.archive_start_use_add > 0 and (self.archive_inuse + job.archive_start_use_add) > self.archive_total:
                    return False
                if job.state != 'ASSIGNED' and not self._dcache_transfer_fits_locked(job):
                    return False
                return True


            while len(queued) < (status.prio_fillmem_context + float(current_cpu)):
                try: 
                    next_job = next(jobs_view_iter)
                except StopIteration:
                    break
                if not eligible(next_job):
                    continue                
                if next_job.state in queue_states:
                    queued.append(next_job)
                elif next_job.state == 'ASSIGNED':
                    assigned.append(next_job)

            while queued:
                # prioritize jobs with a good memory profile (reorder jobs)
                if status.prio_fillmem_context > 1:
                    # Greedy best-of-window selection without sorting or rebuilding the list
                    startpos = 0
                    best_idx = None
                    best_score = None
                    found = 0

                    while startpos < len(queued) and found < status.prio_fillmem_context:
                        job_candidate = queued[startpos]
                        # can the job run? recheck as constraints may have changed due to other jobs being assigned
                        if ((
                                (
                                    self.active_total
                                    >= (self.active_inuse + job_candidate.active_start_use_add)
                                )
                                or job_candidate.active_start_use_add == 0
                            )
                            and (
                                (
                                    self.dcache_total
                                    >= (self.dcache_inuse + job_candidate.dcache_start_use_add)
                                )
                                or job_candidate.dcache_start_use_add == 0
                            )
                            and (
                                (
                                    self.archive_total
                                    >= (self.archive_inuse + job_candidate.archive_start_use_add)
                                )
                                or job_candidate.archive_start_use_add == 0
                            )
                            and self._dcache_transfer_fits_locked(job_candidate)
                        ) and _ssd_ok(job_candidate, e):
                            # Pipeline priority is strict. Memory/CPU packing
                            # optimizes only within the same priority band.
                            try:
                                candidate_priority = int(
                                    getattr(job_candidate, 'priority', 0) or 0
                                )
                            except (TypeError, ValueError):
                                candidate_priority = 0
                            prefer_local_ssd = bool(
                                job_candidate.ssd_use == 'possible'
                                and e is not None
                                and getattr(e, 'has_ssd', False)
                            )
                            prefer_no_ssd_job = bool(
                                job_candidate.ssd_use == 'no'
                                and e is not None
                                and not getattr(e, 'has_ssd', False)
                            )
                            score = _placement_score(
                                candidate_priority,
                                job_candidate.ncpu,
                                job_candidate.mem,
                                current_cpu,
                                current_mem,
                                cores,
                                totmem,
                                profile_regret=_profile_regret(job_candidate),
                                prefer_local_ssd=prefer_local_ssd,
                                prefer_no_ssd_job=prefer_no_ssd_job,
                            )
                            if (best_score is None) or (score < best_score):
                                best_score = score
                                best_idx = startpos
                            found += 1
                        startpos += 1

                    if best_idx is not None:
                        job = queued.pop(best_idx)
                    else:
                        # No eligible found in the window; default to pop fallback
                        fallback_idx = min(startpos, len(queued) - 1)
                        job = queued.pop(fallback_idx)
                        
                else:                    
                    job = queued.pop(0)
                # add_log_line(gb, str((job.state, job.reqtime, timeleft, job.ncpu, cores, job.mem, totmem, job.partition, partition)))
                # add_log_line(gb, str((self.active_total, self.active_inuse, job.active_start_use_add)))
                if ((
                        (
                            self.active_total
                            >= (self.active_inuse + job.active_start_use_add)
                        )
                        or job.active_start_use_add == 0
                    )
                    and (
                        (
                            self.dcache_total
                            >= (self.dcache_inuse + job.dcache_start_use_add)
                        )
                        or job.dcache_start_use_add == 0
                    )
                    and (
                        (
                            self.archive_total
                            >= (self.archive_inuse + job.archive_start_use_add)
                        )
                        or job.archive_start_use_add == 0
                    )
                    and self._dcache_transfer_fits_locked(job)
                    and _ssd_ok(job, e)
                ):

                    self.active_inuse += job.active_start_use_add
                    self.dcache_inuse += job.dcache_start_use_add
                    self.archive_inuse += job.archive_start_use_add
                    self._reserve_dcache_transfer_locked(job)

                    if not (job.ncpu <= current_cpu and job.mem <= current_mem):
                        add_log_line(
                            gb,
                            f"Job {job.job_name} (id: {job.jobid}) assigned to node {myid} ({current_cpu - job.ncpu:.1f}/{current_mem - job.mem:.2f} remaining)",
                            BLUE,
                        )
                        job.assigned(myid)
                    else:
                        add_log_line(
                            gb,
                            f"Job {job.job_name} (id: {job.jobid}) started on node {myid} ({current_cpu - job.ncpu:.1f}/{current_mem - job.mem:.2f} remaining)",
                            BLUE,
                        )
                        job.started(myid)
                        self._eligible_cache_ts = 0.0
                        self.running_jobs[job.partition] = (
                            self.running_jobs.get(job.partition, 0) + 1
                        )

                    current_cpu -= job.ncpu
                    current_mem -= job.mem

                    if job.state == "RUNNING": #set by job.started
                        e = engines.engine_by_id.get(myid, None)
                        if e is not None:
                            e.res_cpu_reserved += float(job.held_ncpu)
                            e.res_mem_reserved_mb += float(job.held_mem)
                            try:
                                if getattr(job, 'ssd_use', 'no') != 'no' and getattr(e, 'has_ssd', False):
                                    need = float(getattr(job, 'ssd_gb', 0.0))
                                    if need > 0.0:
                                        cap = max(0.0, float(getattr(e, 'ssd_total_gb', 0.0)) - float(getattr(e, 'res_ssd_reserved_gb', 0.0)))
                                        if cap >= need:
                                            e.res_ssd_reserved_gb += need
                                            job.ssd_alloc_gb = need
                            except Exception:
                                import traceback
                                traceback.print_exc()

                    res = (
                        job.jobid,
                        job.job_name,
                        job.command,
                        job.cwd,
                        job.env,
                        job.ncpu,
                        job.mem,
                        job.state,
                    )
                    allres.append(res)
                    if current_cpu <= 0 or current_mem <= 0:
                        break
                else:
                    #rescan queued jobs instead of popping one by one
                    new_queued = []
                    for job in queued:
                        if (job.active_start_use_add > 0 and (self.active_inuse + job.active_start_use_add) > self.active_total):
                            continue
                        if (job.dcache_start_use_add > 0 and (self.dcache_inuse + job.dcache_start_use_add) > self.dcache_total):
                            continue
                        if (job.archive_start_use_add > 0 and (self.archive_inuse + job.archive_start_use_add) > self.archive_total):
                            continue
                        if not self._dcache_transfer_fits_locked(job):
                            continue
                        if not _ssd_ok(job, e):
                            continue
                        new_queued.append(job)
                    queued = new_queued

                #refill queued
                while len(queued) < (status.prio_fillmem_context + float(current_cpu)):
                    try: 
                        next_job = next(jobs_view_iter)
                    except StopIteration:
                        break
                    if not eligible(next_job):
                        continue                    
                    if next_job.state in queue_states:
                        queued.append(next_job)
                    elif next_job.state == 'ASSIGNED':
                        assigned.append(next_job)

                    

            if current_cpu > 0:                                
                for job in assigned:
                    # FIXME; assume 5 days of time                    
                    if (                                                
                        job.ncpu <= current_cpu
                        and job.mem <= current_mem  
                        and _ssd_ok(job, e)
                    ):
                        # Ask the previous engine to drop assignment and reassign to this engine.
                        try:
                            engines.send_command(
                                job.node_id, zslurm_shared.DEASSIGN, job.jobid
                            )
                        except KeyError:
                            pass

                        # Reassign but do not start here; require handshake via can_run_assigned_job
                        job.assigned(myid)
                        add_log_line(
                            gb,
                            f"Job {job.job_name} (id: {job.jobid}) reassigned to node {myid} (ASSIGNED; will start after handshake) ({current_cpu}/{current_mem} remaining)",
                            BLUE,
                        )

                        current_cpu -= job.ncpu
                        current_mem -= job.mem

                        res = (
                            job.jobid,
                            job.job_name,
                            job.command,
                            job.cwd,
                            job.env,
                            job.ncpu,
                            job.mem,
                            job.state,
                        )
                        allres.append(res)
                        if current_cpu <= 0 or current_mem <= 0:
                            break
        except Exception as e:
            import traceback

            traceback.print_exc()
            raise
        finally:
            self.lock.release()
        return allres

    def engine_removed(self, engine_id, reason="Engine disappeared"):
        self.lock.acquire()
        try:
            for job in list(self.jobs_by_id.values()):
                if job.node_id == engine_id:
                    if job.state == "RUNNING":
                        self.job_done(job.jobid, RC_ENGINE_TERMINATED, reason=reason)
                    elif job.state == "ASSIGNED":
                        self.active_inuse -= float(
                            getattr(job, 'active_start_use_add', 0.0) or 0.0
                        )
                        self.dcache_inuse -= float(
                            getattr(job, 'dcache_start_use_add', 0.0) or 0.0
                        )
                        self.archive_inuse -= float(
                            getattr(job, 'archive_start_use_add', 0.0) or 0.0
                        )
                        self.active_inuse = max(0.0, self.active_inuse)
                        self.dcache_inuse = max(0.0, self.dcache_inuse)
                        self.archive_inuse = max(0.0, self.archive_inuse)
                        self._release_dcache_transfer_locked(job)
                        job.node_id = None
                        job.state = "PENDING"
        finally:
            self.lock.release()

    def can_run_assigned_job(self, nodeid, jobid):
        self.lock.acquire()
        try:
            res = False  # DROP
            if jobid in self.jobs_by_id:
                job = self.jobs_by_id[jobid]
                # Only the engine currently assigned to this job may start it
                engine = engines.engine_by_id.get(nodeid, None)
                if engine and engine.stopping:
                    # Do not allow starts on engines that are stopping
                    res = False
                elif job.state == "ASSIGNED" and job.node_id == nodeid:
                    su = str(getattr(job, 'ssd_use', 'no') or 'no')
                    try:
                        need = max(0.0, float(getattr(job, 'ssd_gb', 0.0) or 0.0))
                    except Exception:
                        need = 0.0
                    has_ssd = bool(engine is not None and getattr(engine, 'has_ssd', False))
                    free_ssd = 0.0
                    if engine is not None:
                        try:
                            free_ssd = max(0.0, float(getattr(engine, 'ssd_total_gb', 0.0)) - float(getattr(engine, 'res_ssd_reserved_gb', 0.0)))
                        except Exception:
                            free_ssd = 0.0
                    ssd_ok = True
                    if su == 'required':
                        if not has_ssd:
                            ssd_ok = False
                        elif need > 0.0 and free_ssd < need:
                            ssd_ok = False
                    elif su == 'possible':
                        if has_ssd and need > 0.0 and free_ssd < need:
                            ssd_ok = False

                    if ssd_ok:
                        self.job_start(nodeid, jobid)
                        res = True
                    else:
                        try:
                            # Release resource reservation from ASSIGNED state
                            self.active_inuse -= float(getattr(job, 'active_start_use_add', 0.0) or 0.0)
                            self.dcache_inuse -= float(getattr(job, 'dcache_start_use_add', 0.0) or 0.0)
                            self.archive_inuse -= float(getattr(job, 'archive_start_use_add', 0.0) or 0.0)
                            self._release_dcache_transfer_locked(job)
                            if self.active_inuse < 0:
                                self.active_inuse = 0
                            if self.dcache_inuse < 0:
                                self.dcache_inuse = 0
                            if self.archive_inuse < 0:
                                self.archive_inuse = 0
                        except Exception:
                            pass
                        job.node_id = None
                        job.state = "PENDING"
        finally:
            self.lock.release()
        return res

    def resize_running_job(self, nodeid, jobid, target_cpu, target_mem_mb):
        """Atomically set a running job's mutable CPU and memory reservation.

        Targets are absolute, making retries safe when an XML-RPC response is
        lost after the update was committed. The local chief remains the
        authority for admission and waiting; this manager method validates the
        immutable job limit and keeps engine telemetry/autogrow accounting exact.
        """

        self.lock.acquire()
        try:
            key = str(jobid)
            job = self.jobs_by_id.get(key)
            if job is None:
                return {
                    'ok': False,
                    'code': 3,
                    'message': f"unknown job {key}",
                }
            if job.state != "RUNNING" or str(job.node_id) != str(nodeid):
                return {
                    'ok': False,
                    'code': 3,
                    'message': (
                        f"job {key} is not running on engine {nodeid}"
                    ),
                }
            engine = engines.engine_by_id.get(nodeid)
            if engine is None:
                return {
                    'ok': False,
                    'code': 3,
                    'message': f"unknown engine {nodeid}",
                }
            try:
                target_cpu = float(target_cpu)
                target_mem_mb = float(target_mem_mb)
            except (TypeError, ValueError):
                return {
                    'ok': False,
                    'code': 2,
                    'message': "lease targets must be numeric",
                }
            if (
                not math.isfinite(target_cpu)
                or not math.isfinite(target_mem_mb)
                or target_cpu < 0.0
                or target_mem_mb < 0.0
            ):
                return {
                    'ok': False,
                    'code': 2,
                    'message': "lease targets must be finite and non-negative",
                }

            max_cpu = float(getattr(job, 'max_ncpu', job.ncpu))
            max_mem_mb = float(getattr(job, 'max_mem', job.mem))
            if target_cpu > max_cpu + 1e-9 or target_mem_mb > max_mem_mb + 1e-9:
                return {
                    'ok': False,
                    'code': 2,
                    'message': (
                        f"target {target_cpu} cores/{target_mem_mb} MB exceeds "
                        f"maximum {max_cpu} cores/{max_mem_mb} MB"
                    ),
                }

            old_cpu = float(getattr(job, 'held_ncpu', job.ncpu))
            old_mem_mb = float(getattr(job, 'held_mem', job.mem))
            if (
                abs(old_cpu - target_cpu) <= 1e-9
                and abs(old_mem_mb - target_mem_mb) <= 1e-9
            ):
                return {
                    'ok': True,
                    'code': 0,
                    'jobid': key,
                    'held_cores': old_cpu,
                    'held_mem_mb': old_mem_mb,
                    'max_cores': max_cpu,
                    'max_mem_mb': max_mem_mb,
                    'epoch': int(getattr(job, 'lease_epoch', 0) or 0),
                    'changed': False,
                }
            future_cpu = float(engine.res_cpu_reserved) - old_cpu + target_cpu
            future_mem_mb = (
                float(engine.res_mem_reserved_mb) - old_mem_mb + target_mem_mb
            )
            if (
                future_cpu > float(engine.cores) + 1e-9
                or future_mem_mb > float(engine.totmem) + 1e-9
            ):
                return {
                    'ok': False,
                    'code': 4,
                    'message': (
                        f"engine {nodeid} lacks capacity for target "
                        f"{target_cpu} cores/{target_mem_mb} MB"
                    ),
                }

            engine.res_cpu_reserved = max(0.0, future_cpu)
            engine.res_mem_reserved_mb = max(0.0, future_mem_mb)
            job.held_ncpu = target_cpu
            job.held_mem = target_mem_mb
            job.lease_epoch = int(getattr(job, 'lease_epoch', 0)) + 1
            add_log_line(
                gb,
                f"Job {job.job_name} (id: {key}) lease on {nodeid}: "
                f"{old_cpu:.2f}C/{old_mem_mb:.0f}MB -> "
                f"{target_cpu:.2f}C/{target_mem_mb:.0f}MB",
                CYAN,
            )
            return {
                'ok': True,
                'code': 0,
                'jobid': key,
                'held_cores': target_cpu,
                'held_mem_mb': target_mem_mb,
                'max_cores': max_cpu,
                'max_mem_mb': max_mem_mb,
                'epoch': job.lease_epoch,
                'changed': True,
            }
        finally:
            self.lock.release()

    def job_start(self, node_id, jobid):
        self.lock.acquire()
        try:
            job = self.jobs_by_id[jobid]
            self.running_jobs[job.partition] = (
                self.running_jobs.get(job.partition, 0) + 1
            )
            job.started(node_id)
            self._eligible_cache_ts = 0.0
            e = engines.engine_by_id.get(node_id, None)
            if e is not None:
                e.res_cpu_reserved += float(job.held_ncpu)
                e.res_mem_reserved_mb += float(job.held_mem)
                try:
                    if getattr(job, 'ssd_use', 'no') != 'no' and getattr(e, 'has_ssd', False):
                        need = float(getattr(job, 'ssd_gb', 0.0))
                        if need > 0.0:
                            cap = max(0.0, float(getattr(e, 'ssd_total_gb', 0.0)) - float(getattr(e, 'res_ssd_reserved_gb', 0.0)))
                            if cap >= need:
                                e.res_ssd_reserved_gb += need
                                job.ssd_alloc_gb = need
                except Exception:
                    import traceback
                    traceback.print_exc()
        finally:
            self.lock.release()

    def job_done(self, jobid, return_code, reason="No Reason"):
        # FIXME: add in requeue stuff
        self.lock.acquire()
        try:
            job = self.jobs_by_id.get(jobid, None)
            if not job is None:
                if not job.node_id is None:
                    self._release_dcache_transfer_locked(job)
                    if return_code == 0:
                        self.active_inuse -= job.active_end_use_remove
                        self.archive_inuse -= job.archive_end_use_remove
                        self.dcache_inuse -= job.dcache_end_use_remove
                    else:  # failed job, assume space is free again
                        self.active_inuse -= job.active_start_use_add
                        self.archive_inuse -= job.archive_start_use_add
                        self.dcache_inuse -= job.dcache_start_use_add
                    e = engines.engine_by_id.get(job.node_id, None)
                    if e is not None:
                        e.res_cpu_reserved -= float(
                            getattr(job, 'held_ncpu', job.ncpu)
                        )
                        e.res_mem_reserved_mb -= float(
                            getattr(job, 'held_mem', job.mem)
                        )
                        try:
                            alloc = float(getattr(job, 'ssd_alloc_gb', 0.0))
                            if alloc > 0.0:
                                e.res_ssd_reserved_gb -= alloc
                                if e.res_ssd_reserved_gb < 0:
                                    e.res_ssd_reserved_gb = 0.0
                            job.ssd_alloc_gb = 0.0
                        except Exception:
                            import traceback
                            traceback.print_exc()
                        if e.res_cpu_reserved < 0:
                            e.res_cpu_reserved = 0.0
                        if e.res_mem_reserved_mb < 0:
                            e.res_mem_reserved_mb = 0.0

                if (
                    job.state == "RUNNING"
                    and job.node_id is not None
                    and return_code != RC_CANCELLED
                ):
                    self.running_jobs[job.partition] = max(
                        0, self.running_jobs.get(job.partition, 0) - 1
                    )

                if (
                    return_code != RC_SUCCESS
                    and return_code != RC_TERMINATED
                    and job.requeue > 0
                ):
                    job.requeue -= 1
                    job.mem = job.mem * 2
                    newstate = "REQUEUED"
                    job.starttime = None
                    job.node_id = None
                elif (
                    return_code == RC_ENGINE_TERMINATED
                ):  # ENGINE DISAPPEARED/TERMINATED
                    newstate = "REQUEUED"
                    job.starttime = None
                    job.node_id = None
                else:
                    job = self.jobs_by_id[jobid]
                    
                    del self.jobs_by_id[jobid]
                    self.done_jobs[job.partition] = (
                        self.done_jobs.get(job.partition, 0) + 1
                    )
                    self.total_jobs[job.partition] = (
                        self.total_jobs.get(job.partition, 0) - 1
                    )
                    if (
                        return_code != RC_SUCCESS
                        and return_code != RC_CANCELLED
                        and return_code != RC_TERMINATED
                    ):
                        self.failed_jobs[job.partition] = (
                            self.failed_jobs.get(job.partition, 0) + 1
                        )
                        newstate = "FAILED"
                    elif return_code == RC_CANCELLED or return_code == RC_TERMINATED:
                        newstate = "CANCELLED"
                    else:
                        newstate = "COMPLETED"

                job.done(return_code, reason, newstate)
                if newstate not in queue_states:
                    self._remember_dependency_outcome_locked(job)
                self._eligible_cache_ts = 0.0
                with self.finished_jobs_lock:
                    if job.owner not in self.finished_jobs_by_owner:
                        self.finished_jobs_by_owner[job.owner] = []
                    
                    self.finished_jobs_by_owner[job.owner].append(job)
                    
                    if len(self.finished_jobs_by_owner[job.owner]) > (self.finished_jobs_max + 100):
                        self.finished_jobs_by_owner[job.owner] = self.finished_jobs_by_owner[job.owner][-self.finished_jobs_max:]                    
                        
                

        finally:
            self.lock.release()
        if not job is None:
            return job.job_name
        else:
            return ""

    def job_finished(self, myid, jobid, return_code, report):
        if return_code == 0:
            reason = "Job Finished"
        elif return_code == 143 or return_code == 15:
            reason = "Job Terminated"
        elif return_code == 137:
            reason = "Job Killed"
        elif return_code == 130:
            reason = "Job Interrupted"
        elif return_code == -254:
            reason = "Job Stuck (terminated by monitor)"
        else:
            reason = "Job Failed (errorcode: %d)" % return_code

        name = "unknown"
        comment = ""
        self.lock.acquire()
        core_reserved = 0
        mem_reserved = 0
        input_mb = 0
        output_file = ""
        try:
            if not jobid in self.jobs_by_id:
                add_log_line(
                    gb,
                    "Unknown job (id: %s) completed at %s (%s)" % (jobid, myid, reason),
                    YELLOW,
                )
                #insert a Dummy Job with the correct id so that we correctly report back to snakemake
                job = DummyJob(jobid)
                state = 'COMPLETED' if return_code == 0 else 'FAILED'
                job.done(return_code, reason, state)

            else:
                job = self.jobs_by_id[jobid]
                comment = job.comment
                mem_reserved = job.mem
                core_reserved = job.ncpu
                input_mb = job.input_mb
                output_file = job.output_file
                name = self.job_done(jobid, return_code, reason)

        finally:
            self.lock.release()

        if "starttime" in report:
            line = [
                name,
                comment,
                report.get("retcode", ""),
                myid,
                jobid,
                report.get("starttime", ""),
                report.get("endtime", ""),
                core_reserved,
                mem_reserved,
                input_mb,
                output_file,
            ]
            nostat = [""] * 7
            for lab in ["uss", "rss", "vms", "cpu_percentage"]:
                line.extend(report.get(lab, nostat))

            for lab in [
                "runtime",
                "montime",
                "avg_cpu_percentage",
                "nthreads_avg",
                "nthreads_max",
                "user",
                "system",
                "maxrss",
                "mon_user",
                "mon_system",
                "iowait",
                "read_count",
                "write_count",
                "read_bytes",
                "write_bytes",
            ]:
                line.append(report.get(lab, ""))
            line.append(report.get('memory_over_time',''))
            for field in LEASE_JOB_REPORT_FIELDS:
                line.append(report.get(field, ""))
            phases = report.get("lease_phases", []) or []
            with status.reports_lock:
                if status.reports_file is not None:
                    status.reports_file.write(
                        "\t".join([_tsv_value(e) for e in line]) + "\n"
                    )
                    status.reports_file.flush()
                if status.phase_reports_file is not None:
                    for phase in phases:
                        if not isinstance(phase, dict):
                            continue
                        status.phase_reports_file.write(
                            "\t".join(
                                _phase_report_row(
                                    name,
                                    comment,
                                    report.get("retcode", return_code),
                                    myid,
                                    jobid,
                                    phase,
                                )
                            )
                            + "\n"
                        )
                    status.phase_reports_file.flush()

        if return_code == 0:
            runtime = zslurm_shared.format_time(report.get("runtime", 0.0))
            add_log_line(
                gb,
                "Job %s (id: %s) completed after %s." % (name, jobid, runtime),
                GREEN,
            )
        else:
            add_log_line(
                gb,
                "Job %s (id: %s, node: %s) failed, reason: %s."
                % (name, jobid, myid, reason),
                YELLOW,
            )


