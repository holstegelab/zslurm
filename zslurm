    except Exception:
        return {"ok": False, "code": 3, "error": "n must be an integer"}
    if n < 1:
        return {"ok": False, "code": 3, "error": "n must be >= 1"}
    add_log_line(gb, f"[agent] shrink: stop {n} engine(s)", YELLOW)
    engines.stop_slurm(gb, n)
    return {"ok": True, "requested": n}


