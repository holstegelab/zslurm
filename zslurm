# ===========================================================================
# Agent / programmatic control interface (registered on the job server below).
# See docs/agent-interface-plan.md. Read RPCs are open; mutating RPCs are
# refused with {"ok": False, "code": 3, ...} unless enable_control_rpc is set,
# and require control_token when one is configured. Returning a structured
# {"ok": ...} dict (instead of raising) keeps the contract jsonable and lets
# clients map code 3 -> non-retryable exit without parsing XML-RPC Faults.
# ===========================================================================
SCHEMA_VERSION = 2
_MANAGER_START_TS = None
_CONTROLLER_THREAD = None


def _control_denied(token):
    if not getattr(status, 'enable_control_rpc', False):
        return {"ok": False, "code": 3,
                "error": "control RPC disabled; set 'enable_control_rpc: true' in "
                         "~/.zslurm/config.yaml (or start the manager with --enable-control)"}
    ct = getattr(status, 'control_token', None)
    if ct and str(token) != str(ct):
        return {"ok": False, "code": 3, "error": "invalid control token"}
    return None


def ping():
    up = None if _MANAGER_START_TS is None else (time.time() - _MANAGER_START_TS)
    return {
        "ok": True,
        "schema_version": SCHEMA_VERSION,
        "instance": getattr(status, 'instance_name', None),
        "uptime_s": up,
        "job_server_alive": Servers.job_server is not None,
        "manager_server_alive": Servers.manager_server is not None,
        "controller_alive": bool(_CONTROLLER_THREAD is not None and _CONTROLLER_THREAD.is_alive()),
        "lastin_first": bool(status.lastin_first),
        "prio_fillmem_context": int(status.prio_fillmem_context),
        "submit_job_priority": True,
        "default_job_priority": DEFAULT_JOB_PRIORITY,
        "list_jobs_priority": True,
        "targeted_job_status": True,
        "directional_dcache_slots": True,
        "s3_download_slots": True,
        "gpfs_io_metrics": True,
        "job_dependencies": True,
        "job_dependency_types": sorted(SUPPORTED_DEPENDENCY_TYPES),
        "control_enabled": bool(getattr(status, 'enable_control_rpc', False)),
        "explicit_handover": True,
        "handover_mode": str(getattr(status, 'handover_mode', 'ACTIVE')),
        "manager_uuid": str(getattr(status, 'manager_uuid', '')),
    }


