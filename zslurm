        values[f"rss_{percentile}"] = rss_percentiles[index]
    return [_tsv_value(values.get(field)) for field in LEASE_PHASE_REPORT_FIELDS]


def _cfg_bool(value, default=False):
    if value is None:
        return bool(default)
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return value != 0
    if isinstance(value, str):
        v = value.strip().lower()
        if v in ("1", "true", "yes", "y", "on"):
            return True
        if v in ("0", "false", "no", "n", "off"):
            return False
    return bool(default)


def _cfg_int(value, default=0):
    try:
        return int(value)
    except Exception:
        try:
            return int(float(value))
        except Exception:
            return int(default)


def _cfg_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return float(default)


def _cfg_string_list(value, default=None):
    if default is None:
        default = []
    if value is None:
        return list(default)
    if isinstance(value, str):
        items = [e.strip() for e in value.split(",") if e.strip()]
        return items or list(default)
    if isinstance(value, (list, tuple)):
        items = [str(e).strip() for e in value if str(e).strip()]
        return items or list(default)
    return list(default)


def _cfg_autogrow_prefer_partitions(value, default=None):
    if default is None:
        default = DEFAULT_AUTOGROW_PREFER_PARTITIONS
    if value is None:
        return list(default)
    out = []
    try:
        for item in value:
            if isinstance(item, (list, tuple)):
                if len(item) == 0:
                    continue
                part = str(item[0]).strip()
                scratch = _cfg_bool(item[1], False) if len(item) > 1 else False
            elif isinstance(item, dict):
                part = str(item.get("partition", "")).strip()
                scratch = _cfg_bool(item.get("scratch", False), False)
            else:
                part = str(item).strip()
                scratch = False
            if part:
                out.append((part, scratch))
    except Exception:
        return list(default)
    return out or list(default)


def _cfg_node_profiles(value, default=None):
    if default is None:
        default = DEFAULT_NODE_PROFILES
    if not isinstance(value, dict):
        return copy.deepcopy(default)
    out = {}
    for name, prof in value.items():
        if not isinstance(prof, dict):
            continue
        part = str(name).strip()
        if not part:
            continue
        out[part] = {
            "cores": _cfg_int(prof.get("cores"), 0),
            "mem_gb": _cfg_float(prof.get("mem_gb"), 0.0),
        }
    return out or copy.deepcopy(default)


def _cluster_defaults(config=None):
    """Return safe site defaults without requiring a site-specific fork.

    ``cluster_site`` is an explicit override for tests, login aliases and
    manager hosts whose FQDN does not contain the Slurm cluster name. Unknown
    clusters deliberately get no automatic growth policy: an incorrect node
    profile can otherwise submit real allocations that can never satisfy the
    queued workload.
    """
    cfg = config if isinstance(config, dict) else {}
    site = str(cfg.get("cluster_site", "") or "").strip().lower()
    if not site:
        hostname = zslurm_shared.get_full_hostname().lower()
        if "snellius" in hostname:
            site = "snellius"
        elif "spider" in hostname:
            site = "spider"
        else:
            site = "generic"

    defaults = {
        "cluster_site": site,
        "default_partition": "normal",
        "staging_partition": "staging",
        "enable_ssd_prompt": False,
        "ssd_feature_name": "scratch-node",
        "autogrow_prefer_partitions": [("normal", False)],
        "node_profiles": {},
        "autogrow_fallback_partition": "normal",
        "autogrow_fat_partitions": [],
        "maintenance_window_enable": False,
        "default_engine_cores": 0,
        "autogrow_engine_cores": 0,
        "autogrow_dynamic_engine_cores": False,
        "autogrow_require_idle_nodes": True,
        "autogrow_engine_min_cores": 1,
        "autogrow_engine_memory_mb_per_core": 0.0,
        "autogrow_engine_memory_headroom_fraction": 0.0,
        "autogrow_engine_memory_cap_fraction": 1.0,
        "autogrow_engine_memory_static_reserve_mb": 0.0,
        "autogrow_max_nonssd_fraction": 0.5,
        "autogrow_enable": False,
        "autogrow_max_compute_nodes": 0,
    }
    if site == "snellius":
        defaults.update({
            "default_partition": "genoa",
            "enable_ssd_prompt": True,
            "autogrow_prefer_partitions": list(
                DEFAULT_AUTOGROW_PREFER_PARTITIONS
            ),
            "node_profiles": copy.deepcopy(DEFAULT_NODE_PROFILES),
            "autogrow_fallback_partition": "genoa",
            "autogrow_fat_partitions": ["fat_genoa", "fat_rome"],
            "maintenance_window_enable": True,
            "autogrow_enable": True,
            "autogrow_max_compute_nodes": 40,
        })
    elif site == "spider":
        # Spider grants 8 GB per allocated core (DefMemPerCPU=8000). A
        # half-node-sized pilot is large enough for mixed workflow packing but
        # can share both 60-core Rome and 120-core Bergamo nodes. The profile
        # describes the allocation, not the physical RAM installed in a node.
        defaults.update({
            "default_partition": "normal",
            "ssd_feature_name": "ssd",
            "autogrow_prefer_partitions": [("normal", False)],
            "node_profiles": {
                "normal": {"cores": 30, "mem_gb": 240},
            },
            "autogrow_fallback_partition": "normal",
            "default_engine_cores": 30,
            "autogrow_engine_cores": 30,
            "autogrow_dynamic_engine_cores": True,
            # Spider schedules partial allocations into free cores on MIXED
            # nodes.  Requiring a completely IDLE node would strand runnable
            # work instead of letting Slurm queue/backfill the pilot.
            "autogrow_require_idle_nodes": False,
            "autogrow_engine_min_cores": 2,
            "autogrow_engine_memory_mb_per_core": 8000.0,
            "autogrow_engine_memory_headroom_fraction": 0.08,
