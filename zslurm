def render_control_status(gb, status):
    gb.lock.acquire()
    try:
        if gb.wcom:
            try:
                rows, width = gb.wcom.getmaxyx()
            except Exception:
                rows, width = (20, 80)
            right = max(2, width - 2)
            def draw_right(row, text, color):
                try:
                    t = str(text)
                    field_width = max(4, min(24, right - 1))
                    field_start = max(1, right - field_width)
                    gb.wcom.move(row, field_start)
                    gb.wcom.clrtoeol()
                    start = max(field_start, right - len(t))
                    gb.wcom.addstr(row, start, t, curses.color_pair(color))
                except Exception:
                    pass
            col = GREEN if getattr(status, 'autoconsolidate_enable', True) else YELLOW
            draw_right(3, ("ON" if status.autoconsolidate_enable else "OFF"), col)
            col = GREEN if status.lastin_first else YELLOW
            draw_right(9, ("ON" if status.lastin_first else "OFF"), col)
            try:
                val = int(status.prio_fillmem_context)
            except Exception:
                val = 0
            draw_right(10, str(val), GREEN)
            col = GREEN if getattr(status, 'autogrow_enable', True) else YELLOW
            draw_right(11, ("ON" if status.autogrow_enable else "OFF"), col)
            handover_mode = str(getattr(status, 'handover_mode', 'ACTIVE'))
            draw_right(
                13,
                handover_display_label(handover_mode),
                GREEN if handover_mode in ('ACTIVE', 'TARGET_ACTIVE') else YELLOW,
            )
            try:
                inst_row = max(1, min(rows - 2, 18))
                inst_name = str(getattr(status, 'instance_name', '') or '-')
                gb.wcom.move(inst_row, 1)
                gb.wcom.clrtoeol()
                gb.wcom.addstr(inst_row, 1, f"Instance: {inst_name}", curses.color_pair(GREEN))
            except Exception:
                pass
            gb.wcom.refresh()
    except Exception:
        pass
    finally:
        gb.lock.release()


# enter command in command window
def enter_command(gb, argument="Command: "):
    if gb.wcom is None:
        return
    gb.lock.acquire()
    try:
        command = ""
        size = gb.wcom.getmaxyx()
        x = size[0] - 1
        # Compute available width and draw a truncated prompt if needed
        width = max(0, size[1] - 2)
        shown_arg = argument[:width]
        gb.wcom.addstr(x, 1, shown_arg)
        gb.wcom.clrtoeol()
        gb.wcom.refresh()
        # Ensure keypad mode so special keys like KEY_ENTER/KEY_BACKSPACE are recognized
        try:
            gb.scr.keypad(True)
        except Exception:
            pass
        while 1:
            gb.lock.release()
            c = gb.scr.getch()
            gb.lock.acquire()
            # Enter pressed (handle LF, CR, keypad enter)
            if c in (curses.ascii.LF, curses.ascii.CR, getattr(curses, 'KEY_ENTER', -1)):
                break
            # Backspace/Delete handling (cover multiple keycodes)
            elif c in (curses.ascii.DEL, curses.ascii.BS, 127, getattr(curses, 'KEY_BACKSPACE', -1)):
                command = command[:-1]
            else:
                if c > 256:
                    # Ignore unsupported special keys
                    set_status_message(gb, "Keycode not supported: " + str(c))
                else:
                    command += chr(c)
            # Redraw prompt + current command, truncated to fit available width
            avail_cmd = max(0, width - len(shown_arg))
            shown_cmd = command[-avail_cmd:] if avail_cmd > 0 else ""
            gb.wcom.addstr(x, 1, shown_arg + shown_cmd)
            gb.wcom.clrtoeol()
            gb.wcom.refresh()

        gb.wcom.addstr(x, 1, "")
        gb.wcom.clrtoeol()
        gb.wcom.refresh()
    except:
        pass
    finally:
        gb.lock.release()
    return command


def get_number(gb, argument, default=0):
    cmd = enter_command(gb, argument)
    if not cmd:
        n = default
    else:
        try:
            n = int(cmd)
        except ValueError:
            set_status_message(gb, "Number of engines should be a number", YELLOW)
            n = None
    return n


def _is_port_available(host, port):
    # Test by actually BINDING both the manager port and its +1 job port, exactly
    # as the servers do (wildcard address + SO_REUSEADDR). A connect()-based probe
    # is wrong here: base_port 38864 lies inside the Linux ephemeral port range, so
    # it is sometimes already in use as another process's *client* port (an
    # ESTABLISHED connection with no listener). connect() to it is refused -> the
    # old probe reported "available" -> the server's bind() then failed with
    # EADDRINUSE. A bind() probe detects that case (and TIME_WAIT, and real listeners).
    try:
        base_port = int(port)
    except Exception:
        base_port = int(zslurm_shared.port)

    for candidate in (base_port, base_port + 1):
        s = None
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("", candidate))   # match the servers' bind("", port)
        except OSError:
            return False              # cannot bind this port -> not usable
        finally:
            if s is not None:
                s.close()
    return True


def _find_available_port(bind_host, start_port, attempts=100):
    try:
        base_port = int(start_port)
    except Exception:
        base_port = int(zslurm_shared.port)

    for offset in range(attempts):
        candidate = base_port + (offset * 2)
        if _is_port_available(bind_host, candidate):
            return candidate
    raise RuntimeError(f"Unable to find available port near {start_port} on host {bind_host}")


def _ping_instance(instance_name, timeout=10.0):
    try:
        url = zslurm_shared.get_manager_url(instance=instance_name)
        proxy = zslurm_shared.TimeoutServerProxy(url, timeout=timeout, allow_none=True)
        proxy.system.listMethods()
        return True
    except Exception:
        return False


def _cleanup_unreachable_instances():
    names = zslurm_shared.get_instance_names()
    now = time.time()
    for name in list(names):
        if _ping_instance(name):
            continue
        try:
            zslurm_shared.remove_instance(name)
        except Exception as ex:
            import traceback
            traceback.print_exc()


def _ensure_unique_instance(address, requested_name=None, recovery_config=None):
    #ensure instance name does not exist yet
    instance_name = str(requested_name or f'zslurm_{address}').strip()
    if not instance_name:
        instance_name = f'zslurm_{address}'
    if not re.match(r'^[A-Za-z0-9_.-]+$', instance_name):
        raise ValueError(
            "instance name may contain only letters, digits, '.', '_' and '-'")
    base_instance_name = instance_name
    pos = 0
    active = zslurm_shared.get_instance_names()
    if recovery_config and instance_name in active:
        raise RuntimeError(
            f"recovery instance {instance_name!r} is still registered")
    while instance_name in active:
        pos += 1
        instance_name = f"{base_instance_name}_{pos}"
        
    if recovery_config:
        try:
            free_port = int(recovery_config['base_port'])
        except (KeyError, TypeError, ValueError):
            raise RuntimeError(
                f"recovery instance {instance_name!r} has no valid base_port")
        if not _is_port_available(address, free_port):
            raise RuntimeError(
                f"recovery port {free_port} for {instance_name!r} is in use")
        rpcpath = str(recovery_config.get('rpcpath') or '').strip()
        if not rpcpath:
            raise RuntimeError(
                f"recovery instance {instance_name!r} has no rpcpath")
    else:
        free_port = _find_available_port(address, zslurm_shared.port)
        rpcpath = None

    instance_data = {
        "bind_host": address,
        "advertise_host": address,
        "base_port": free_port,
        "manager_uuid": status.manager_uuid,
        "handover_secret": status.handover_secret,
        "handover_state": "ACTIVE",
    }
    if rpcpath:
        # Explicit crash recovery keeps the old endpoint capability so chiefs
        # blocked in completion retries can reach the replacement manager.
        instance_data["rpcpath"] = rpcpath
    zslurm_shared.set_instance_config(instance_name, instance_data)

    return instance_name


def _prepare_explicit_recovery(instance_name, address):
    """Validate and capture a dead local instance before stale cleanup."""
    name = str(instance_name or '').strip()
    if not name:
        return None
    config = zslurm_shared.get_instance_config(name) or {}
    if not config:
        raise RuntimeError(f"recovery instance {name!r} does not exist")
    if _ping_instance(name):
        raise RuntimeError(
            f"recovery instance {name!r} is still reachable; use explicit "
            "manager handover instead")
    instance_host = (
        config.get('advertise_host') or config.get('bind_host') or '')
    if (zslurm_shared.short_name(str(instance_host)) !=
            zslurm_shared.short_name(str(address))):
        raise RuntimeError(
            f"recovery instance {name!r} belongs to host {instance_host!r}, "
            f"not {address!r}")
    return config


def _remove_owned_instance_records():
    names = set(getattr(status, 'handover_owned_aliases', set()) or set())
    if status.instance_name:
        names.add(str(status.instance_name))
    for name in names:
        zslurm_shared.remove_instance_if_manager(name, status.manager_uuid)


