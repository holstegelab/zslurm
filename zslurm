            elif c == ord("H"):
                old_instance = enter_command(
                    gb, "Old ZSlurm instance to take over: ")
                old_instance = str(old_instance or '').strip()
                if old_instance:
                    confirm = enter_command(
                        gb,
                        f"Take over {old_instance} into "
                        f"{status.instance_name}? Type yes: ",
                    )
                    if str(confirm or '').strip().lower() == 'yes':
                        set_status_message(
                            gb, f"Taking over {old_instance}...", YELLOW)
                        result = initiate_handover(old_instance)
                        if result.get('ok'):
                            add_log_line(
                                gb,
                                f"Handover complete: {old_instance} -> "
                                f"{status.instance_name}; jobs={result.get('jobs', 0)}, "
                                f"chiefs={result.get('chiefs', 0)}.",
                                GREEN,
                            )
                            set_status_message(
                                gb, f"Took over {old_instance}", GREEN)
                        else:
                            add_log_line(
                                gb,
                                f"Handover from {old_instance} rejected: "
                                f"{result.get('error', 'unknown error')}",
                                RED,
                            )
                            set_status_message(
                                gb, "Handover failed; see log", RED)
                        try:
                            render_control_status(gb, status)
                        except Exception:
                            pass
            elif c == ord("o"):
                cmd = enter_command(gb, "Enter name or [archive|compute] +/-nr:")
                r = engines.toggle_phasing_out(cmd)
                add_log_line(gb, r)

            elif c == ord("u"):  # Update ncurses screen
                gb.scr.refresh()
    except Exception:
        add_log_line(gb, "EXCEPTION!!! EMERGENCY SHUTDOWN IN PROGRESS!", RED)
        try:
            if not getattr(status, 'handover_preserve_engines', False):
                engines.stop_all()
            stop_status_display(status, t)
        except Exception:
            pass
        raise

    time.sleep(2)  # wait for all paint ops to finish and engines to terminate


def _open_report_files(config):
    """Open the per-job report TSV (job_finished writes to it) and, if enabled,
    the per-poll node-usage TSV. Shared by the curses and headless paths."""
    current_date = datetime.datetime.now().strftime('%Y-%m-%d_%H-%M')
    status.reports_file = open(config.get("reports_file_prefix", "report") + f'-{current_date}.tsv', "w")
    fieldnames = [
        "jobname", "comment", "retcode", "machine", "jobid",
        "starttime", "endtime", "cores_reserved", "mem_reserved_mb",
        "input_mb", "output_file",
    ]
    for lab in ["uss", "rss", "vms", "cpu_percentage"]:
        for j in [0, 5, 25, 50, 75, 95, 100]:
            fieldnames.append(lab + "_" + str(j))
    fieldnames.extend([
        "runtime", "montime", "avg_cpu_percentage", "nthreads_avg", "nthreads_max",
        "user", "system", "maxrss", "mon_user", "mon_system", "iowait",
        "read_count", "write_count", "read_bytes", "write_bytes", "memory_over_time",
    ])
    fieldnames.extend(LEASE_JOB_REPORT_FIELDS)
    status.reports_file.write("\t".join(fieldnames) + "\n")
    status.reports_file.flush()

    if bool(config.get("lease_phase_reports_enable", True)):
        status.phase_reports_file = open(
            config.get("lease_phase_reports_file_prefix", "lease_phases")
            + f'-{current_date}.tsv',
            "w",
        )
        status.phase_reports_file.write(
            "\t".join(LEASE_PHASE_REPORT_FIELDS) + "\n"
        )
        status.phase_reports_file.flush()

    if bool(config.get("node_reports_enable", True)):
        status.node_reports_file = open(config.get("node_reports_file_prefix", 'node_usage') + f'-{current_date}.tsv', "w")
        node_fields = [
            "ts_iso", "engine_id", "cluster_id", "partition", "status", "managed",
            "stopping", "cores", "totmem_mb", "cpu_pct", "mem_pct", "load",
            "sys_cpu_busy_pct", "sys_iowait_pct", "res_cores_reserved",
            "res_mem_reserved_mb", "jobs_running", "has_ssd", "ssd_total_gb",
            "ssd_used_gb", "res_ssd_reserved_gb", "gpfs_rx_mib_s",
            "gpfs_tx_mib_s", "gpfs_io_pct", "gpfs_io_available",
            "timeleft_sec", "uptime_sec",
            "pending_jobs", "pending_cores", "pending_mem_mb",
        ]
        status.node_reports_file.write("\t".join(node_fields) + "\n")
        status.node_reports_file.flush()


def main_headless(args):
    """Run the manager without the curses UI: just the RPC servers + controller
    thread. Required for autonomous/agent operation and for testing the agent
    interface (see docs/agent-interface-plan.md). add_log_line() already no-ops
    its window writes when gb.wlog is None, so logging goes to cluster.log only."""
    address = zslurm_shared.get_hostname()
    requested_recovery = getattr(args, 'recover_instance', None)
    recovery_config = _prepare_explicit_recovery(
        requested_recovery, address) if requested_recovery else None
    _cleanup_unreachable_instances()
    instance_name = _ensure_unique_instance(
        address,
        requested_recovery or getattr(args, 'instance_name', None),
        recovery_config=recovery_config,
    )
    config = zslurm_shared.get_config(instance=instance_name)

    status.instance_name = instance_name
    status.config = config
    _apply_cluster_config(status.config)
    jobs.configure_transfer_limits(status.config)
    if 'autogrow_max_compute_nodes' not in status.config:
        status.config['autogrow_max_compute_nodes'] = 40

    # CLI overrides: let an agent own scaling / control, and make testing safe
    # (autogrow defaults ON and would sbatch real Slurm engines).
    if getattr(args, 'no_autogrow', False):
        status.autogrow_enable = False
    if getattr(args, 'no_autoconsolidate', False):
        status.autoconsolidate_enable = False
    if getattr(args, 'enable_control', False):
        status.enable_control_rpc = True
    if getattr(args, 'control_token', None):
        status.control_token = args.control_token
        status.enable_control_rpc = True

    def _remove_own_instance():
        try:
            _remove_owned_instance_records()
        except Exception:
            pass
    atexit.register(_remove_own_instance)

    status.set_address(address, int(config["port"]))

    gb.lock = threading.RLock()
    gb.log_file = open("cluster.log", "a")
    gb.wlog = None  # explicit: no curses window -> add_log_line writes file only

    _open_report_files(config)

    add_log_line(gb, f"[manager] HEADLESS start instance={instance_name} "
                     f"manager_port={config['port']} job_port={int(config['port'])+1} "
                     f"rpcpath={config['rpcpath']}", GREEN)
    add_log_line(gb, f"[manager] control_enabled={status.enable_control_rpc} "
                     f"autogrow={status.autogrow_enable} "
                     f"autoconsolidate={status.autoconsolidate_enable}", CYAN)

    start_server(int(config["port"]), config["rpcpath"])

    # One machine-readable banner on stdout so a launcher can capture the endpoint.
    try:
        banner = {
            "ok": True,
            "instance": instance_name,
            "bind_host": address,
            "base_port": int(config["port"]),
            "job_port": int(config["port"]) + 1,
            "rpcpath": config["rpcpath"],
            "manager_url": zslurm_shared.get_manager_url(instance=instance_name),
            "job_url": zslurm_shared.get_job_url(instance=instance_name),
            "control_enabled": bool(status.enable_control_rpc),
        }
        sys.stdout.write(json.dumps(banner) + "\n")
        sys.stdout.flush()
    except Exception:
        pass

    stop_event = threading.Event()

    def _sig(signum, frame):
        add_log_line(gb, f"[manager] signal {signum} received, shutting down", YELLOW)
        stop_event.set()

    try:
        signal.signal(signal.SIGINT, _sig)
        signal.signal(signal.SIGTERM, _sig)
    except Exception:
        pass

    try:
        while not stop_event.wait(1.0):
            pass
    finally:
        try:
            if not getattr(status, 'handover_preserve_engines', False):
                engines.stop_all()
        except Exception:
            pass
        add_log_line(gb, "[manager] headless shutdown complete", YELLOW)


def _cli_main():
    parser = argparse.ArgumentParser(
        prog="zslurm",
        description="zslurm pilot-job meta-scheduler manager")
    parser.add_argument("--headless", action="store_true",
                        help="run without the curses UI (RPC servers + controller only); "
                             "for autonomous/agent operation")
    parser.add_argument("--no-autogrow", action="store_true",
                        help="(headless) start with autogrow disabled")
    parser.add_argument("--no-autoconsolidate", action="store_true",
                        help="(headless) start with autoconsolidation disabled")
    parser.add_argument("--enable-control", action="store_true",
                        help="(headless) enable mutating control RPCs "
                             "(set_budgets / set_scheduler_mode / set_autogrow / prioritize)")
    parser.add_argument("--control-token", default=None,
                        help="(headless) require this token for control RPCs (implies --enable-control)")
    parser.add_argument("--instance-name", default=None,
                        help="(headless) requested logical instance name; a numeric "
                             "suffix is added if it already exists")
    parser.add_argument(
        "--recover-instance", default=None,
        help="explicitly restart an unreachable local instance on its existing "
             "ports and RPC path so surviving chiefs can reconnect")
    args, _unknown = parser.parse_known_args()
    if args.headless:
        main_headless(args)
    else:
        curses.wrapper(main, cli_args=args)


if __name__ == "__main__":
    _cli_main()
