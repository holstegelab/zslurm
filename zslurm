def grow(token=None, n=1, partition=None, stime=None, constraint="", cores=0):
    """Start n Slurm-backed engines (wraps EngineManager.start_slurm). DANGEROUS:
    this sbatches real Slurm allocations and burns SBUs -- gate it and cap autogrow."""
    denied = _control_denied(token)
    if denied:
        return denied
    try:
        n = int(n)
    except Exception:
        return {"ok": False, "code": 3, "error": "n must be an integer"}
    if n < 1:
        return {"ok": False, "code": 3, "error": "n must be >= 1"}
    part = partition or status.default_partition
    walltime = stime or getattr(status, 'autogrow_runtime_default', "5-0:0:0")
    try:
        cores = int(cores)
    except Exception:
        cores = 0
    add_log_line(gb, f"[agent] grow: {n} engine(s) on {part} (cores={cores or 'exclusive'}, "
                     f"constraint={constraint or '-'}, t={walltime})", YELLOW)
    # start_slurm returns Engine objects (not XML-RPC serializable) or None on error;
    # surface only the serializable cluster ids + count.
    started = engines.start_slurm(gb, n, walltime, part, constraint or "", cores)
    cluster_ids = [str(getattr(e, 'cluster_id', '')) for e in (started or [])]
    return {"ok": bool(started), "requested": n, "partition": part, "cores": cores,
            "constraint": constraint or None, "stime": walltime,
            "started": len(cluster_ids), "cluster_ids": cluster_ids,
            "error": None if started else "sbatch submission failed (see cluster.log)"}


def shrink(token=None, n=1):
    """Stop n Slurm-backed engines (wraps EngineManager.stop_slurm; prefers queued
    > idle > oldest)."""
