def _handover_committed_source():
    return getattr(status, 'handover_mode', 'ACTIVE') == 'SOURCE_COMMITTED'


def _wait_for_handover_prepare():
    # A source snapshot is taken while holding jobs.lock. RPCs that entered
    # after SOURCE_PREPARING must decide their destination only after commit or
    # rollback; otherwise an in-flight completion could update the old copy.
    if getattr(status, 'handover_mode', 'ACTIVE') == 'SOURCE_PREPARING':
        jobs.lock.acquire()
        jobs.lock.release()


def _handover_proxy(worker=False):
    target = getattr(status, 'handover_target', None) or {}
    key = 'manager_url' if worker else 'job_url'
    url = target.get(key)
    if not url:
        raise RuntimeError("handover target endpoint is unavailable")
    return zslurm_shared.TimeoutServerProxy(
        str(url), timeout=120, allow_none=True)


def submit_job(*args):
    _wait_for_handover_prepare()
    if _handover_committed_source():
        return _handover_proxy(False).submit_job(*args)
    return jobs.submit_job(*args)


