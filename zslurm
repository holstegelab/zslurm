def _tsv_value(value):
    if value is None:
        return ""
    return str(value).replace("\t", " ").replace("\r", " ").replace("\n", " ")


def _phase_report_row(name, comment, return_code, machine, jobid, phase):
    cpu_percentiles = list(phase.get("cpu_cores_percentiles", []) or [])
    pss_percentiles = list(phase.get("pss_mb_percentiles", []) or [])
    rss_percentiles = list(phase.get("rss_mb_percentiles", []) or [])
    cpu_percentiles += [None] * (7 - len(cpu_percentiles))
    pss_percentiles += [None] * (7 - len(pss_percentiles))
    rss_percentiles += [None] * (7 - len(rss_percentiles))

    def _local_time(epoch):
        try:
            return time.strftime(
                '%b %d %Y %H:%M:%S', time.localtime(float(epoch))
            )
        except (TypeError, ValueError, OverflowError):
            return ""

    values = {
        "jobname": name,
        "comment": comment,
        "retcode": return_code,
        "machine": machine,
        "jobid": jobid,
        "starttime": _local_time(phase.get("started_at_epoch")),
        "endtime": _local_time(phase.get("ended_at_epoch")),
        "phase_index": phase.get("phase_index"),
        "phase_name": phase.get("phase_name"),
        "event": phase.get("event"),
        "transition_id": phase.get("transition_id"),
        "lease_epoch": phase.get("lease_epoch"),
        "requested_cores": phase.get("requested_cores"),
        "requested_mem_mb": phase.get("requested_mem_mb"),
        "cores_reserved": phase.get("held_cores"),
        "mem_reserved_mb": phase.get("held_mem_mb"),
        "runtime": phase.get("duration_s"),
        "sample_count": phase.get("sample_count"),
        "sampled_duration_s": phase.get("sampled_duration_s"),
        "avg_cpu_percentage": phase.get("avg_cpu_cores"),
        "pss_avg_mb": phase.get("avg_pss_mb"),
        "rss_sample_count": phase.get("rss_sample_count"),
        "rss_sampled_duration_s": phase.get("rss_sampled_duration_s"),
        "rss_avg_mb": phase.get("avg_rss_mb"),
        "rss_max_mb": phase.get("rss_max_mb"),
        "lease_reserved_core_seconds": phase.get("reserved_core_seconds"),
        "lease_sampled_reserved_core_seconds": phase.get(
            "sampled_reserved_core_seconds"
        ),
        "lease_used_core_seconds": phase.get("used_core_seconds"),
        "lease_reserved_mem_mb_seconds": phase.get("reserved_mem_mb_seconds"),
        "lease_sampled_reserved_mem_mb_seconds": phase.get(
            "sampled_reserved_mem_mb_seconds"
        ),
        "lease_pss_mb_seconds": phase.get("pss_mb_seconds"),
        "lease_rss_mb_seconds": phase.get("rss_mb_seconds"),
        "lease_cpu_efficiency": phase.get("cpu_efficiency"),
        "lease_memory_efficiency": phase.get("memory_efficiency"),
