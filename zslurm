# On a non-SSD engine, let an ssd_use=no job absorb up to ten percent of a
# node-equivalent more CPU/memory packing imbalance than ssd_use=possible work.
# Priority, immediate fit, and overcommit remain strict tuple fields.
NON_SSD_JOB_AFFINITY_BONUS = 0.10


def _placement_profile_cost(job_cores, job_mem_mb, profile_cores, profile_mem_mb):
    """Return the normalized CPU/memory imbalance left on an empty node.

    A result of zero means that the job consumes CPU and memory in exactly the
    node's native ratio.  ``None`` means that the job cannot fit on the profile.
    All memory values are in MB; converting memory to core equivalents before
    comparing it with CPU keeps the score dimensionally consistent.
    """
    job_cores = float(job_cores)
    job_mem_mb = float(job_mem_mb)
    profile_cores = float(profile_cores)
    profile_mem_mb = float(profile_mem_mb)
    if profile_cores <= 0.0 or profile_mem_mb <= 0.0:
        return None
    if job_cores > profile_cores or job_mem_mb > profile_mem_mb:
        return None

    mem_per_core = profile_mem_mb / profile_cores
    remaining_cores = profile_cores - job_cores
    remaining_mem_cores = (profile_mem_mb - job_mem_mb) / mem_per_core
    return abs(remaining_cores - remaining_mem_cores) / profile_cores


def _placement_profile_regret(
        job_cores, job_mem_mb, current_profile_cores,
        current_profile_mem_mb, eligible_profiles):
    """Cost of using the current node rather than the best eligible node type."""
    current_cost = _placement_profile_cost(
        job_cores, job_mem_mb, current_profile_cores, current_profile_mem_mb)
    if current_cost is None:
        return 0.0

    best_cost = current_cost
    for profile_cores, profile_mem_mb in eligible_profiles:
        cost = _placement_profile_cost(
            job_cores, job_mem_mb, profile_cores, profile_mem_mb)
        if cost is not None:
            best_cost = min(best_cost, cost)
    return max(0.0, current_cost - best_cost)


def _placement_score(
        priority, job_cores, job_mem_mb, free_cores, free_mem_mb,
        node_cores, node_mem_mb, profile_regret=0.0,
        prefer_local_ssd=False, prefer_no_ssd_job=False):
    """Lexicographic score used by the greedy same-priority packer.

    Lower is better.  The fields are: strict pipeline priority, fits the
    currently free resources, overcommit in core equivalents, a combined
    normalized profile/packing/affinity cost, its component tie-breakers, and
    the existing final local-SSD tie-breaker.  On a plain engine,
    ``ssd_use=no`` receives a bounded affinity bonus.  It may beat a somewhat
    better CPU/memory shape, but cannot cross a numeric-priority, immediate-fit,
    or overcommit boundary.
    """
    job_cores = float(job_cores)
    job_mem_mb = float(job_mem_mb)
    free_cores = float(free_cores)
    free_mem_mb = float(free_mem_mb)
    node_cores = float(node_cores)
    node_mem_mb = float(node_mem_mb)

    mem_per_core = (
        node_mem_mb / node_cores
        if node_cores > 0.0 and node_mem_mb > 0.0
        else 1.0
    )
    remaining_cores = free_cores - job_cores
    remaining_mem_mb = free_mem_mb - job_mem_mb
    epsilon = 1e-9
    fits_now = (
        remaining_cores >= -epsilon and remaining_mem_mb >= -epsilon)
    deficit = (
        max(-remaining_cores, 0.0)
        + max(-remaining_mem_mb, 0.0) / mem_per_core
    )
    if deficit < epsilon:
        deficit = 0.0
    stranded = abs(
        max(remaining_cores, 0.0)
        - max(remaining_mem_mb, 0.0) / mem_per_core
    )
    profile_regret = max(0.0, float(profile_regret))
    normalized_stranded = (
        stranded / node_cores if node_cores > 0.0 else stranded
    )
    combined_placement_cost = profile_regret + normalized_stranded
    if prefer_no_ssd_job:
        combined_placement_cost -= NON_SSD_JOB_AFFINITY_BONUS

    return (
        -int(priority),
        0 if fits_now else 1,
        deficit,
        combined_placement_cost,
        profile_regret,
        stranded,
        -1 if prefer_local_ssd else 0,
    )


def _consolidation_job_resources(job):
    """Return the resources autoconsolidation must retain for one job.

    Pending work has not released anything yet and therefore needs its full
    submission request. A running job can have returned CPU and memory through
    a dynamic lease, in which case retaining capacity for its maximum request
    prevents otherwise idle engines from ever being phased out.
    """

    cpu = getattr(job, "ncpu", 0.0)
    mem_mb = getattr(job, "mem", 0.0)
    if getattr(job, "state", None) == "RUNNING":
        held_cpu = getattr(job, "held_ncpu", None)
        held_mem_mb = getattr(job, "held_mem", None)
        if held_cpu is not None:
            cpu = held_cpu
        if held_mem_mb is not None:
            mem_mb = held_mem_mb
    return max(0.0, float(cpu)), max(0.0, float(mem_mb))



