class RequestHandler(SimpleXMLRPCRequestHandler):
    def __init__(self, rpc_path):
        rpc_paths = (f"/{rpc_path}",)

def thread_start_job_server(port, rpc_path):
    request_handeler=SimpleXMLRPCRequestHandler
    request_handeler.rpc_paths=(f"/{rpc_path}",)
    with ReuseAddrXMLRPCServer(
        ("", int(port)),
        logRequests=False,
        allow_none=True,
        requestHandler=request_handeler) as server:
        server.register_introspection_functions()

        server.register_function(submit_job, "submit_job")
        server.register_function(cancel_job, "cancel_job")
        server.register_function(list_jobs, "list_jobs")
        server.register_function(list_done_jobs, "list_done_jobs")
        server.register_function(get_job_states, "get_job_states")
        server.register_function(queue_stats, "queue_stats")
        server.register_function(list_nodes, "list_nodes")
        # Agent / programmatic interface (see docs/agent-interface-plan.md)
        server.register_function(ping, "ping")
        server.register_function(health, "health")
        server.register_function(get_status_json, "get_status_json")
        server.register_function(match_jobs, "match_jobs")
        server.register_function(whatif_budget, "whatif_budget")
        server.register_function(set_budgets, "set_budgets")
        server.register_function(set_transfer_limits, "set_transfer_limits")
        server.register_function(set_scheduler_mode, "set_scheduler_mode")
        server.register_function(set_autogrow, "set_autogrow")
        server.register_function(rpc_prioritize, "prioritize")
        server.register_function(rpc_deprioritize, "deprioritize")
        # Phase 3/4: planning, observability, repair, fleet
        server.register_function(forecast_budget, "forecast_budget")
        server.register_function(list_jobs_detailed, "list_jobs_detailed")
        server.register_function(get_autogrow_plan, "get_autogrow_plan")
        server.register_function(recompute_inuse_from_running, "recompute_inuse_from_running")
        server.register_function(grow, "grow")
        server.register_function(shrink, "shrink")
        server.register_function(rpc_handover_from, "handover_from")
        # Source-side endpoint.  The target's public handover_from RPC calls
        # this on the old manager.  Target-side callbacks live on the separate
        # manager RPC server, so this single-threaded job server cannot
        # deadlock while the source transfers the snapshot back.
        server.register_function(handover_to, "handover_to")
        add_log_line(gb, f"[job] started on port {port} with rpc path {rpc_path}", GREEN)
        Servers.job_server = server
        server.serve_forever()





class Engine(object):
    def __init__(
        self,
        engine_id="?",
        cores=0,
        totmem=0,
        partition="",
        cluster_id=None,
        managed=False,
        instance=None,
        slurm_partition=None,
    ):
        self.engine_id = engine_id
        self.cluster_id = cluster_id
        self.instance = instance
        self.managed = managed
        self.partition = partition
        # ``partition`` is the manager-side job partition (compute/archive).
        # Keep the actual Slurm partition as well so queued workers, which have
        # not registered yet, can still be selected by the cancellation UI.
        self.slurm_partition = slurm_partition
        self.slurm_state = None
        # Slurm gives an instantiated array task its own numeric JobId. Keep it
        # separate from cluster_id (ArrayJobId_ArrayTaskId), because scontrol
        # hold/release is more reliable with the numeric JobId on Snellius.
        self.slurm_job_id = None

        self.cores = cores
        self.totmem = totmem
        self.jobs = set()
        self.status = ""

        self.cpu_usage = 0.0
        self.mem_usage = 0.0
        self.load = 0.0
        self.sys_cpu_busy = 0.0
        self.sys_iowait = 0.0
        self.gpfs_rx_mib_s = 0.0
        self.gpfs_tx_mib_s = 0.0
        self.gpfs_io_pct = 0.0
        self.gpfs_io_available = False
        self.res_cpu_reserved = 0.0
        self.res_mem_reserved_mb = 0.0

        self.starttime = time.time()
        self.timeleft = 5 * 24 * 60 * 60
        self.lastseen = time.time()

        self.pending_commands = []
        self.observed_hits = 0
        self.missing_hits = 0
        self.stopping = False
        self.end_of_life_drain = False   # set when phased out because walltime is nearly up
        self.backfill_announced = False   # phase-out backfill logged once per engine

        self.has_ssd = False
        self.ssd_total_gb = 0.0
        self.ssd_used_gb = 0.0        
        self.res_ssd_reserved_gb = 0.0


class EngineManager(object):
    def __init__(self):
        self.lock = threading.RLock()
        self.engine_by_id = {}

        self.engine_by_clusterid = {}
        self.local_engine_process = None

        self.cluster_queued_engines = 0
        self.cluster_running_engines = 0
        self.cluster_held_engines = 0

        self.cluster_queued_engines_archive = 0
        self.cluster_running_engines_archive = 0
        self.cluster_held_engines_archive = 0
        self.cluster_queued_by_partition = {}
        self.cluster_running_by_partition = {}
        self.cluster_held_by_partition = {}
        self.cluster_queued_age_by_partition = {}
        self.cluster_queued_age_by_partition_by_scratch = {}
        self.last_squeue_ts = 0.0
        self.archive_failed_nodes = set()
        # Queued (not-yet-started) compute engine allocations, and the subset put on
        # hold through explicit administrative control. The automatic controllers do
        # not hold, release, or cancel queued engine allocations.
        self.queued_engines_detail = []   # [(cid, partition, age_sec, is_scratch)] -- excludes held
        self.queued_engine_capacity_by_cid = {}  # cid -> (cores, expected schedulable MB)
        self.held_engine_cids = set()     # cids successfully held by this manager
        self.actual_held_engine_cids = set()  # all cids Slurm currently reports held
        self.held_engines_detail = []     # manager-held [(cid, partition, age_sec, is_scratch)]
        self.external_held_engines_detail = []  # held outside this manager; never auto-release

    def toggle_phasing_out(self, engine_id):
        with self.lock:
            cmd = ("" if engine_id is None else str(engine_id)).strip()

            if not cmd:
                return "No engine specified."

            engine = self.engine_by_id.get(cmd)
            if engine is not None:
                if engine.status == PHASING_OUT:
                    engine.status = ""
                    return f"Engine {cmd} is no longer phasing out."
                engine.status = PHASING_OUT
                return f"Engine {cmd} is now phasing out."

            partition_map = {
                "archive": "archive",
                "arch": "archive",
                "a": "archive",
                "compute": "compute",
                "comp": "compute",
                "c": "compute",
            }

            partition_hint = None
            nr_str = cmd

            parts = cmd.split(None, 1)
            if len(parts) == 2 and parts[0].lower() in partition_map:
                partition_hint = partition_map[parts[0].lower()]
                nr_str = parts[1].strip()

            try:
                nr_of_engines = int(nr_str)
            except ValueError:
                known = ", ".join(sorted(self.engine_by_id.keys()))
                return f"Engine '{cmd}' not found. Known engines: {known}."

            target_partition = (partition_hint or "compute").lower()

            def matches_partition(candidate):
                part = (getattr(candidate, "partition", "") or "").lower()
                if target_partition == "archive":
                    return part == "archive"
                return part != "archive"

            if nr_of_engines == 0:
                return "No engines selected for phase change (0 requested)."

            if nr_of_engines > 0:
                candidates = [
                    e
                    for e in self.engine_by_id.values()
                    if e.status != PHASING_OUT and matches_partition(e)
                ]
                candidates.sort(key=lambda e: len(e.jobs))
                selected = candidates[: nr_of_engines]
                for item in selected:
                    item.status = PHASING_OUT
                count = len(selected)
                if count == 0:
                    return f"No {target_partition} engines available to phase out."
                names = ", ".join(e.engine_id for e in selected)
                msg = (
                    f"Phasing out {count} {target_partition}"
                    f" engine{'s' if count != 1 else ''}: {names}."
                )
                if count < nr_of_engines:
                    missing = nr_of_engines - count
                    msg += (
                        f" Skipped {missing} requested engine"
                        f"{'s' if missing != 1 else ''} due to availability."
                    )
                return msg

            desired = -nr_of_engines
            candidates = [
                e
                for e in self.engine_by_id.values()
                if e.status == PHASING_OUT and matches_partition(e)
            ]
            candidates.sort(key=lambda e: len(e.jobs), reverse=True)
            selected = candidates[:desired]
            for item in selected:
                item.status = ""
            count = len(selected)
            if count == 0:
                return f"No phased-out {target_partition} engines to restore."
            names = ", ".join(e.engine_id for e in selected)
            msg = (
                f"Dephasing {count} {target_partition}"
                f" engine{'s' if count != 1 else ''}: {names}."
            )
            if count < desired:
                missing = desired - count
                msg += (
                    f" Skipped {missing} requested engine"
                    f"{'s' if missing != 1 else ''} due to availability."
                )
            return msg

    def job_running(self, eid, job):
        engine = self.engine_by_id.get(eid, None)
        if engine:
            engine.jobs.add(job)

    def job_stopped(self, eid, job):
        engine = self.engine_by_id.get(eid, None)
        if engine:
            engine.jobs.discard(job)

    def list_nodes(self):
        result = []
        for e in list(self.engine_by_id.values()):
            result.append(
                (
                    e.partition,
                    e.engine_id,
                    e.cluster_id if e.cluster_id is not False else "NA",
                    e.cores,
                    e.totmem,
                    time.time() - e.starttime,
                    e.timeleft,
                    len(e.jobs),
                    e.cpu_usage,
                    e.mem_usage,
                    e.load,
                    e.status,
                    e.sys_cpu_busy,
                    e.sys_iowait,
                    getattr(e, 'res_cpu_reserved', 0.0),
                    getattr(e, 'res_mem_reserved_mb', 0.0),
                    bool(getattr(e, 'has_ssd', False)),
                    float(getattr(e, 'ssd_total_gb', 0.0)),
                    float(getattr(e, 'ssd_used_gb', 0.0)),
                    float(getattr(e, 'res_ssd_reserved_gb', 0.0)),
                    float(getattr(e, 'gpfs_rx_mib_s', 0.0)),
                    float(getattr(e, 'gpfs_tx_mib_s', 0.0)),
                    float(getattr(e, 'gpfs_io_pct', 0.0)),
                    bool(getattr(e, 'gpfs_io_available', False)),
                )
            )
        return result

    def send_command(self, nodeid, command, param=None):
        self.lock.acquire()
        try:
            engines.engine_by_id[nodeid].pending_commands.append((command, param))
        finally:
            self.lock.release()

    def check_local_engine(self):
        if (
            not self.local_engine_process is None
            and self.local_engine_process.poll() != None
        ):
            self.lock.acquire()
            if (
                not self.local_engine_process is None
                and self.local_engine_process.poll() != None
            ):  # recheck within lock
                self.local_engine_process = None
            self.lock.release()

        return self.local_engine_process != None

    def _check_cluster_engines(self):
        # After an explicit handover, imported allocations retain the old
        # Slurm job name.  Query all logical instance names represented by our
        # placeholders, while still excluding the user's independent managers.
        instance_names = {str(status.instance_name)}
        for known_engine in self.engine_by_clusterid.values():
            known_instance = getattr(known_engine, 'instance', None)
            if known_instance:
                instance_names.add(str(known_instance))
        args = [
            "squeue", "-h", "-r", "--user", getpass.getuser(),
            "--name", ",".join(sorted(instance_names)),
            "-O",
            "jobid:|,arrayjobid:|,arraytaskid:|,name:|,timeleft:|,statecompact:|,"
            "nodelist:|,partition:|,pendingtime:|,feature:|,numcpus:|,reason",
        ]
        try:
            p = Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            output, error = p.communicate()
            if p.returncode not in (None, 0):
                if isinstance(error, bytes):
                    error = error.decode("utf-8", errors="replace")
                add_log_line(
                    gb,
                    "Unable to query Slurm engine allocations (exit %s): %s"
                    % (p.returncode, str(error or "").strip()),
                    RED,
                )
                return
            if isinstance(output, bytes):
                output = output.decode("utf-8")
        except OSError:
            # lets assume this is temporary
            return

        output = [e.strip().split("|") for e in output.split("\n") if e]

        z = defaultdict(int)

        observed_cluster_ids = set()
        ages_any = defaultdict(float)
        ages_scratch = defaultdict(float)
        ages_noscratch = defaultdict(float)
        nqueue = 0
        nqueue_archive = 0
        nrunning = 0
        nrunning_archive = 0
        nheld = 0
        nheld_archive = 0
        queued_by = defaultdict(int)
        running_by = defaultdict(int)
        held_by = defaultdict(int)
        queued_engines_detail = []  # (cid, partition, age_sec, is_scratch) for non-R, non-staging, non-held engine allocations
        queued_capacity_by_cid = {}
        held_detail = []            # same tuple for allocations this manager actually holds
        external_held_detail = []   # actual Slurm holds not owned by this manager
        actual_held_cids = set()
        manager_held_still_pending = set()  # verified manager holds (prunes stale bookkeeping)
        expected_held_cids = set(self.held_engine_cids)


        try:
            for slurm_job_id, jid_raw, atask, cname, ctime, cstate, cnode, cpartition, cpending, cfeatures, cnumcpus, creason in output:
                task = (atask or "").strip()
                if task and task != "N/A":
                    cid = f"{jid_raw}_{task}"
                else:
                    cid = jid_raw
        

                observed_cluster_ids.add(cid)

                if cstate == "CG":  # cleaning up
                    continue

                # Keep a placeholder for every matching Slurm allocation.  This
                # also adopts jobs that were queued before a manager restart, so
                # the user can cancel them before a worker has registered.
                engine = self.engine_by_clusterid.get(cid)
                if engine is None:
                    local_partition = (
                        "archive"
                        if cpartition == getattr(status, "staging_partition", "staging")
                        else "compute"
                    )
                    engine = Engine(
                        cluster_id=cid,
                        partition=local_partition,
                        managed=True,
                        instance=status.instance_name,
                        slurm_partition=cpartition,
                    )
                    self.engine_by_clusterid[cid] = engine
                engine.slurm_partition = cpartition
                engine.slurm_state = cstate
                engine.slurm_job_id = str(slurm_job_id or "").strip() or cid
                expected_cores, expected_mem_mb = _autogrow_engine_capacity(
                    cpartition, cnumcpus
                )
                if expected_cores > 0.0:
                    engine.cores = expected_cores
                if expected_mem_mb > 0.0:
                    engine.totmem = expected_mem_mb
                if engine.engine_id == "?":
                    engine.partition = (
                        "archive"
                        if cpartition == getattr(status, "staging_partition", "staging")
                        else "compute"
                    )

                # indicate this engine is observed; apply gating to reduce flapping                
                engine.missing_hits = 0
                engine.observed_hits = engine.observed_hits + 1
                if (not engine.managed) and engine.observed_hits >= SQUEUE_OBSERVED_CONFIRMS:
                    engine.managed = True
                    add_log_line(
                        gb,
                        f"Engine {engine.engine_id} @ {engine.cluster_id} is managed again after {engine.observed_hits} observations.",
                        CYAN,
                    )
                if cstate == "R":
                    engine.timeleft = parse_timeleft(ctime)

                try:
                    features_str = (cfeatures or "").strip()
                except Exception:
                    features_str = ""

                # Track max pending age per Slurm partition for zslurm engine jobs; split by constraint (scratch-node)
                if cstate != "R":
                    try:
                        age_sec = parse_timeleft(cpending)
                    except Exception:
                        age_sec = 0.0
                    try:
                        ages_any[cpartition] = max(float(ages_any.get(cpartition, 0.0)), float(age_sec))
                        if getattr(status, 'ssd_feature_name', '') and getattr(status, 'ssd_feature_name', '') in features_str:
                            ages_scratch[cpartition] = max(float(ages_scratch.get(cpartition, 0.0)), float(age_sec))
                        else:
                            ages_noscratch[cpartition] = max(float(ages_noscratch.get(cpartition, 0.0)), float(age_sec))
                    except Exception:
                        pass

                try:
                    _is_scratch = bool(
                        getattr(status, 'ssd_feature_name', '')
                        and getattr(status, 'ssd_feature_name', '') in (features_str or '')
                    )
                except Exception:
                    _is_scratch = False
                is_archive = cpartition == getattr(status, 'staging_partition', 'staging')
                is_held = cstate != "R" and _slurm_reason_is_hold(creason)

                if cstate == "R":
                    # Count running engines even if not yet registered; they occupy cluster capacity.
                    if is_archive:
                        nrunning_archive += 1
                    else:
                        nrunning += 1
                    running_by[cpartition] += 1
                elif is_held:
                    # Slurm is authoritative. A remembered hold without a matching
                    # JobHeld* reason must be treated as runnable queued capacity.
                    actual_held_cids.add(cid)
                    held_by[cpartition] += 1
                    if is_archive:
                        nheld_archive += 1
                    else:
                        nheld += 1
                        detail = (cid, cpartition, float(age_sec), _is_scratch)
                        if cid in expected_held_cids:
                            manager_held_still_pending.add(cid)
                            held_detail.append(detail)
                        else:
                            # Never auto-release a hold placed outside this manager.
                            external_held_detail.append(detail)
                else:
                    if is_archive:
                        nqueue_archive += 1
                    else:
                        nqueue += 1
                        # Remember each still-queued compute engine allocation with
                        # its pending age, so the controller can hold/cancel stuck or
                        # surplus ones instead of growing while shrinking.
                        queued_engines_detail.append(
                            (cid, cpartition, float(age_sec), _is_scratch)
                        )
                        queued_capacity_by_cid[cid] = (
                            float(engine.cores), float(engine.totmem)
                        )
                    queued_by[cpartition] += 1



                z[cstate] += 1
        except Exception as ex:
            add_log_line(
                gb,
                f"Exception while parsing squeue output in _check_cluster_engines: {ex}",
                RED,
            )
            add_log_line(gb, traceback.format_exc(), RED)
            return

        for cid, engine in list(self.engine_by_clusterid.items()):
            if engine is None:
                self.engine_by_clusterid.pop(cid, None)
                continue
            if (
                not engine.cluster_id is False
                and not engine.cluster_id in observed_cluster_ids
            ):
                # Missed this cycle; increment misses and reset observations
                engine.observed_hits = 0
                engine.missing_hits = engine.missing_hits + 1
                # Only mark unmanaged after tolerance to avoid flapping
                if engine.managed and engine.missing_hits >= SQUEUE_MISSING_TOLERANCE:
                    engine.managed = False
                    add_log_line(
                        gb,
                        f"Engine {engine.engine_id} @ {engine.cluster_id} not observed in Slurm {engine.missing_hits} times; deferring unregister until TIMEOUT.",
                        YELLOW,
                    )
                # Queued/unregistered placeholders otherwise live forever after
                # cancellation or a rejected Slurm submission.
                if engine.engine_id == "?" and engine.missing_hits >= SQUEUE_MISSING_TOLERANCE:
                    self.engine_by_clusterid.pop(cid, None)
                    self.held_engine_cids.discard(str(cid))

        self.cluster_queued_engines = nqueue
        self.cluster_running_engines = nrunning
        self.cluster_held_engines = nheld
        self.cluster_queued_engines_archive = nqueue_archive
        self.cluster_running_engines_archive = nrunning_archive
        self.cluster_held_engines_archive = nheld_archive
        self.last_observed_cids = set(observed_cluster_ids)
        stale_holds = (
            expected_held_cids.intersection(observed_cluster_ids)
            - actual_held_cids
        )
        if stale_holds:
            shown = ",".join(sorted(stale_holds)[:8])
            if len(stale_holds) > 8:
                shown += "..."
            add_log_line(
                gb,
                "Slurm no longer reports %d remembered engine hold(s); "
                "treating them as queued: %s" % (len(stale_holds), shown),
                YELLOW,
            )
        # Per-Slurm-partition counts (e.g., genoa, rome, fat_genoa, fat_rome)
        try:
            self.cluster_queued_by_partition = dict(queued_by)
            self.cluster_running_by_partition = dict(running_by)
            self.cluster_held_by_partition = dict(held_by)
            self.queued_engines_detail = list(queued_engines_detail)
            self.queued_engine_capacity_by_cid = dict(queued_capacity_by_cid)
            self.held_engines_detail = list(held_detail)
            self.external_held_engines_detail = list(external_held_detail)
            self.actual_held_engine_cids = set(actual_held_cids)
            # Preserve a hold recorded after this squeue snapshot; otherwise retain
            # only manager-owned holds that Slurm verified in this snapshot.
            newly_recorded = set(self.held_engine_cids) - expected_held_cids
            self.held_engine_cids = set(manager_held_still_pending) | newly_recorded
        except Exception:
            self.cluster_queued_by_partition = {}
            self.cluster_running_by_partition = {}
            self.cluster_held_by_partition = {}
            self.queued_engines_detail = []
            self.queued_engine_capacity_by_cid = {}
            self.held_engines_detail = []
            self.external_held_engines_detail = []
            self.actual_held_engine_cids = set()
        try:
            self.cluster_queued_age_by_partition = dict(ages_any)
            keys = set(list(ages_scratch.keys()) + list(ages_noscratch.keys()))
            by_s = {}
            for p in keys:
                by_s[p] = {
                    'scratch': float(ages_scratch.get(p, 0.0)),
                    'no_scratch': float(ages_noscratch.get(p, 0.0)),
                }
            self.cluster_queued_age_by_partition_by_scratch = by_s
            self.last_squeue_ts = time.time()
        except Exception:
            pass

    def _matches_cluster_group(self, engine, group=None):
        """Match a worker against the UI groups compute/staging/all."""
        target = str(group or "all").strip().lower()
        if target in ("all", "*"):
            return True

        manager_partition = str(getattr(engine, "partition", "") or "").lower()
        slurm_partition = str(getattr(engine, "slurm_partition", "") or "").lower()
        staging_partition = str(getattr(status, "staging_partition", "staging") or "staging").lower()

        if target in ("staging", "archive"):
            return manager_partition == "archive" or slurm_partition == staging_partition
        if target == "compute":
            return manager_partition != "archive" and slurm_partition != staging_partition
        return False

    def count_cluster_engines(self, group=None):
        with self.lock:
            return sum(
                1
                for engine in self.engine_by_clusterid.values()
                if engine is not None and self._matches_cluster_group(engine, group)
            )

    def count_phasing_out(self, group=None):
        """Count registered Slurm workers that are draining/phasing out."""
        with self.lock:
            return sum(
                1
                for engine in self.engine_by_id.values()
                if engine.cluster_id not in (None, False, "")
                and engine.status == PHASING_OUT
                and self._matches_cluster_group(engine, group)
            )

    def start_local(self, gb, ncpu, mem):
        self.lock.acquire()
        try:
            if not self.local_engine_process is None:
                set_status_message(gb, "Local engine already started!", YELLOW)
            elif ncpu <= 0 or mem <= 0:
                set_status_message(
                    gb,
                    "Invalid cpu (%d) or mem (%.2g gb) constraint. "
                    % (ncpu, mem / 1024.0),
                    YELLOW,
                )
            else:
                set_status_message(gb, "Starting local engines", YELLOW)
                chief_path = "zslurm_chief"
                cmd = (
                    chief_path
                    + f" -a {status.address} -p {status.port} "
                    + f"--instance {status.instance_name} -c {ncpu} -m {mem} -u"
                )
                add_log_line(gb, "Starting local engine using: " + cmd, GREEN)
                args = shlex.split(cmd)

                e = Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                log_output(e.stdout, gb, MAGENTA)
                log_output(e.stderr, gb, RED)
                self.local_engine_process = e

                set_status_message(gb, "Local engine started", GREEN)
                add_log_line(gb, "Local engine started", MAGENTA)
        finally:
            self.lock.release()

    def stop_local(self, gb):
        if self.local_engine_process is None:
            set_status_message(gb, "No local engine running", YELLOW)
        else:
            set_status_message(gb, "Stopping local engine", YELLOW)
            stop_engine = self.local_engine_process
            if stop_engine.poll() is None:
                add_log_line(gb, "Termination signal send to local engine", MAGENTA)
                stop_engine.terminate()

            for engine in list(self.engine_by_id.values()):
                if engine.cluster_id is False:
                    self.send_command(engine.engine_id, zslurm_shared.DIE)

            counter = 65
            while counter > 0 and stop_engine.poll() is None:
                if (counter % 10) == 0:
                    add_log_line(
                        gb,
                        "Waiting %d seconds for local engine to terminate..." % counter,
                        MAGENTA,
                    )
                time.sleep(1)
                counter -= 1
            if stop_engine.poll() is None:
                stop_engine.kill()
                add_log_line(gb, "Send local engine a kill signal...", RED)

            self.local_engine_process = None
            set_status_message(gb, "Local engine terminated", GREEN)

    # FIXME
    def start_slurm(self, gb, n, stime, partition, constraint, cores):
        self.lock.acquire()
        started_engines = []
        try:
            if n < 0:
                set_status_message(
                    gb, "Invalid number of engines to be started: " + str(n), YELLOW
                )
            else:
                set_status_message(gb, "Starting SLURM engines", YELLOW)
                # Ask for `stime` but let backfill shorten it to whatever fits before
                # the next (invisible) maintenance reservation -- see the note in
                # zslurm_shared. An engine shorter than the floor spends more on
                # startup and drain than it returns, so below that we stay queued
                # and the capacity simply comes back after the window.
                time_min = None
                if bool(getattr(status, 'maintenance_window_enable', True)):
                    time_min = zslurm_shared.submission_time_min(
                        stime,
                        getattr(status, 'maintenance_time_min_sec',
                                zslurm_shared.DEFAULT_TIME_MIN_SECONDS))
                    if time_min:
                        add_log_line(
                            gb,
                            "Requesting engine walltime %s with --time-min %s; Slurm "
                            "truncates it to what fits before the next reservation"
                            % (stime, time_min),
                            YELLOW,
                        )
                # Build sbatch command as a list to avoid quoting issues
                args = [
                    "sbatch", "-N", "1", "-p", str(partition),
                ]
                if cores > 0:
                    args.append(f"--cpus-per-task={int(cores)}")
                else:
                    args.append("--exclusive")
                if constraint:
                    args.extend(["--constraint", str(constraint)])
                if time_min:
                    args.extend(["--time-min", str(time_min)])
                args.append("--parsable")
                if n > 1:
                    args.append(f"--array=0-{int(n)-1}")
                args.extend(["-J", str(status.instance_name), "-t", str(stime)])

                # Partition mapping for manager side
                if partition == getattr(status, 'staging_partition', 'staging'):
                    # check for existing and failed archive nodes to exclude
                    xlist = []
                    for eid, engine in self.engine_by_id.items():
                        if engine.partition == "archive":
                            eid = eid.split('-')[0]
                            xlist.append(eid)
                    xlist.extend(list(self.archive_failed_nodes))
                    if xlist:
                        args.append("--exclude=" + ",".join(sorted(set(filter(None, xlist)))))
                    lpartition = "archive"
                else:
                    lpartition = "compute"

                # Add command to run under sbatch and its arguments
                args.extend([
                    "slurm_to_zslurm",
                    "-a", str(status.address),
                    "-p", str(status.port),
                    "--instance", str(status.instance_name),
                    "-t", str(lpartition),
                ])
                if cores > 0:
                    args.extend(["-c", str(int(cores))])

                eid = Popen(
                    args, stdout=subprocess.PIPE, stderr=subprocess.PIPE
                ).communicate()[0]
                if isinstance(eid, bytes):
                    eid = eid.decode("utf-8")

                eid = eid.strip()
                try:
                    log_cmd = " ".join(shlex.quote(str(a)) for a in args)
                except Exception:
                    log_cmd = "sbatch ..."
                add_log_line(gb, "Queueing engines (%s) using: " % eid + log_cmd, GREEN)
                if "error" in eid or not eid:
                    add_log_line(gb, "Error during SLURM submission.", RED)
                    return

                planned_cores, planned_mem_mb = _autogrow_engine_capacity(
                    partition, cores
                )

                if n == 1:
                    self.engine_by_clusterid[eid] = Engine(
                        cluster_id=eid,
                        cores=planned_cores,
                        totmem=planned_mem_mb,
                        partition=lpartition,
                        managed=True,
                        instance=status.instance_name,
                        slurm_partition=partition,
                    )
                    self.engine_by_clusterid[eid].slurm_state = "PENDING"
                    started_engines.append(self.engine_by_clusterid[eid])
                else:
                    for i in range(n):
                        cid = eid + "_" + str(i)                        
                        self.engine_by_clusterid[cid] = Engine(
                            cluster_id=cid,
                            cores=planned_cores,
                            totmem=planned_mem_mb,
                            partition=lpartition,
                            managed=True,
                            instance=status.instance_name,
                            slurm_partition=partition,
                        )
                        self.engine_by_clusterid[cid].slurm_state = "PENDING"
                        started_engines.append(self.engine_by_clusterid[cid])
                time.sleep(3)
                set_status_message(gb, "SLURM engines queued", GREEN)
                add_log_line(gb, str(n) + " SLURM engines queued", MAGENTA)
        finally:
            self.lock.release()
        return started_engines

    # FIXME: jobs running removal, priority of cancelling less active nodes
    def stop_slurm(self, gb, n, group=None):
        self.lock.acquire()
        try:
            target = str(group or "all").strip().lower()
            if target not in ("all", "*", "compute", "staging", "archive"):
                set_status_message(gb, "Unknown engine group: " + target, YELLOW)
                return

            available = self.count_cluster_engines(target)
            group_label = "staging" if target == "archive" else target
            if available == 0 and n != 0:
                set_status_message(gb, f"No {group_label} SLURM engines found", YELLOW)
            elif n < 0 or n > available:
                set_status_message(
                    gb,
                    f"Invalid number of {group_label} engines to be stopped: {n} (available: {available})",
                    YELLOW,
                )
            else:
                set_status_message(gb, f"Stopping {n} {group_label} SLURM engines", YELLOW)

                candidates = [
                    (cid, engine)
                    for cid, engine in self.engine_by_clusterid.items()
                    if engine is not None and self._matches_cluster_group(engine, target)
                ]

                # stop queued engines
                stop_engines = sorted(
                    [
                        cid
                        for cid, engine in candidates
                        if getattr(engine, "slurm_state", None) != "R"
                        or engine.engine_id == "?"
                    ],
                    reverse=True,
                )  # cancel youngest non-running engine

                # stop idle engines
                if len(stop_engines) < n:
                    stop_engines2 = sorted(
                        [
                            cid
                            for cid, engine in candidates
                            if cid not in stop_engines
                            and engine.managed
                            and len(engine.jobs) == 0
                        ]
                    )  # cancel oldest running engine
                    stop_engines = stop_engines + stop_engines2

                # stop oldest engines
                if len(stop_engines) < n:
                    stop_engines2 = sorted(
                        [
                            cid
                            for cid, engine in candidates
                            if cid not in stop_engines and engine.managed
                        ]
                    )  # cancel oldest running engine
                    stop_engines = stop_engines + stop_engines2

                # as a last resort, include any remaining engines regardless of managed state
                if len(stop_engines) < n:
                    for cid, engine in candidates:
                        if cid not in stop_engines:
                            stop_engines.append(cid)

                stop_engines = stop_engines[:n]
                if stop_engines:
                    add_log_line(gb, "Stop engines: %s" % str(stop_engines), CYAN)

                    set_progress_bar(gb, 0.0)
                    for pos, eid in enumerate(stop_engines):
                        self.cancel_cid(eid)
                        set_progress_bar(gb, float(pos + 1) / float(n))

                    time.sleep(2)
                    stop_progress_bar(gb)
                    set_status_message(gb, "SLURM engines stopped", GREEN)
                    add_log_line(gb, f"{n} {group_label} SLURM engines stopped", MAGENTA)
        finally:
            self.lock.release()

    def cancel_cid(self, cid, unregister_after=True):
        self.lock.acquire()
        try:
            cmd = "scancel " + str(cid)
            args = shlex.split(cmd)
            add_log_line(gb, "Cancelling using command: " + cmd, CYAN)
            p = Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            log_output(p.stdout, gb, WHITE)
            log_output(p.stderr, gb, RED)
            p.wait()

            if cid in self.engine_by_clusterid:
                e = self.engine_by_clusterid[cid]
                if not e is None:
                    # mark as stopping while Slurm cancellation propagates
                    e.stopping = True
                    if unregister_after:
                        self._unregister(e, reason="Engine stopped")
        finally:
            self.lock.release()

    def _run_cluster_control(self, gb, args, description):
        """Run one Slurm allocation mutation and report failures accurately."""
        try:
            process = Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            stdout, stderr = process.communicate()
            returncode = process.returncode
            if returncode is None:
                returncode = process.wait()
        except Exception as ex:
            add_log_line(gb, f"Failed to {description}: {ex}", RED)
            return False

        def _text(value):
            if isinstance(value, bytes):
                value = value.decode("utf-8", errors="replace")
            return str(value or "").strip()

        if returncode != 0:
            detail = _text(stderr) or _text(stdout) or "no diagnostic output"
            add_log_line(
                gb,
                f"Failed to {description} (exit {returncode}): {detail}",
                RED,
            )
            return False
        return True

    def _slurm_control_id(self, cid):
        """Return Slurm's numeric JobId for an instantiated array task."""
        engine = self.engine_by_clusterid.get(str(cid))
        control_id = getattr(engine, "slurm_job_id", None) if engine else None
        return str(control_id or cid)

    def hold_or_cancel_queued(self, gb, cids, action='hold'):
        """Explicitly hold or cancel still-queued engine allocations.

        Automatic growth and consolidation never call this method. A failed hold is
        deliberately left queued; it must never degrade into an implicit cancel.
        """
        if action not in {'hold', 'cancel'}:
            raise ValueError("queued engine action must be 'hold' or 'cancel'")
        held_done = []
        cancelled_done = []
        for cid in list(cids):
            cid = str(cid)
            control_id = self._slurm_control_id(cid)
            if action == 'hold':
                if self._run_cluster_control(
                    gb,
                    ["scontrol", "hold", control_id],
                    f"hold queued engine {cid}",
                ):
                    self.held_engine_cids.add(cid)
                    held_done.append(cid)
                continue
            if self._run_cluster_control(
                gb,
                ["scancel", control_id],
                f"cancel queued engine {cid}",
            ):
                # Drop the placeholder created at start_slurm so the cancelled
                # allocation isn't re-counted as cluster capacity.
                self.lock.acquire()
                try:
                    self.engine_by_clusterid.pop(cid, None)
                    self.held_engine_cids.discard(cid)
                finally:
                    self.lock.release()
                cancelled_done.append(cid)
        if held_done:
            shown = ",".join(held_done[:8]) + ("..." if len(held_done) > 8 else "")
            add_log_line(
                gb,
                f"Held {len(held_done)} queued engine allocation(s): {shown}",
                YELLOW,
            )
        if cancelled_done:
            shown = ",".join(cancelled_done[:8]) + ("..." if len(cancelled_done) > 8 else "")
            add_log_line(
                gb,
                f"Cancelled {len(cancelled_done)} queued engine allocation(s): {shown}",
                YELLOW,
            )
        return held_done + cancelled_done

    def release_held(self, gb, cids):
        """Explicitly release previously-held engine allocations."""
        done = []
        for cid in list(cids):
            cid = str(cid)
            control_id = self._slurm_control_id(cid)
            if self._run_cluster_control(
                gb,
                ["scontrol", "release", control_id],
                f"release held engine {cid}",
            ):
                self.held_engine_cids.discard(cid)
                done.append(cid)
        if done:
            shown = ",".join(done[:8]) + ("..." if len(done) > 8 else "")
            add_log_line(gb, f"Released {len(done)} held engine allocation(s): {shown}", GREEN)
        return done

    def _is_cid_present(self, cid):
        """Return True if the given Slurm cluster job id is still present in squeue."""
        try:
            cids = getattr(self, 'last_observed_cids', set()) or set()
            return str(cid) in cids
        except Exception:
            return False

    def _wait_for_cid_termination(self, cid, timeout_seconds=60, poll_interval=2):
        """Wait up to timeout_seconds for the Slurm job cid to disappear from squeue."""
        if cid is None or cid is False:
            return
        start = time.time()
        while time.time() - start < timeout_seconds:
            if not self._is_cid_present(cid):
                add_log_line(gb, f"Confirmed SLURM job {cid} is no longer present.", CYAN)
                return
            time.sleep(poll_interval)
        add_log_line(gb, f"Timed out waiting for SLURM job {cid} to disappear; proceeding.", YELLOW)

    def stop_all(self):
        if self.count_cluster_engines() > 0:
            add_log_line(gb, "Terminating SLURM engines.", RED)
            self.stop_slurm(gb, self.count_cluster_engines())
        if self.check_local_engine():
            add_log_line(gb, "Terminating local engine.", RED)
            self.stop_local(gb)


    def failed_node(self, myip, partition, cluster_jobid):        
        add_log_line(gb, f"Node {myip} at {cluster_jobid} in {partition} reports a failed node, and will exit.")
        if str(partition) == "archive" and myip:
            self.lock.acquire()
            try:
                self.archive_failed_nodes.add(myip)
            finally:
                self.lock.release()

    def register(
        self,
        myip,
        cores,
        totmem,
        partition,
        cluster_jobid,
        ssd_total_gb,
        ssd_used_gb,
        logical_instance=None,
    ):
        self.lock.acquire()
        try:
            myid = zslurm_shared.short_name(myip)

            myx = myid
            counter = 1
            while myx in self.engine_by_id:
                counter += 1
                myx = f"{myid}-{counter}"
            myid = myx

            prev = self.engine_by_clusterid.get(cluster_jobid, None) if cluster_jobid not in (None, "", False) else None
            if (
                prev is not None
                and getattr(prev, 'engine_id', None) in self.engine_by_id
                and self.engine_by_id.get(prev.engine_id) is prev
            ):
                # Idempotent re-registration after a lost migration response.
                myid = prev.engine_id
            if prev is not None:
                # Reuse placeholder to preserve managed/observed state
                e = prev
                e.engine_id = myid
                e.cores = cores
                e.totmem = totmem
                e.partition = partition
                if getattr(status, 'handover_mode', '') not in (
                        'TARGET_IMPORTED', 'TARGET_MIGRATING', 'TARGET_ACTIVE'):
                    e.status = ""
            else:
                e = Engine(myid, cores, totmem, partition)
                # Capture pre-existing engines as managed on registration; squeue will demote if missing later
                if cluster_jobid not in (None, "", False):
                    e.managed = True
                if cluster_jobid not in (None, "", False):
                    self.engine_by_clusterid[cluster_jobid] = e

            self.engine_by_id[myid] = e
            if myid == zslurm_shared.short_name(status.address) or cluster_jobid == "":
                e.cluster_id = False
            else:
                e.cluster_id = cluster_jobid
                self.engine_by_clusterid[cluster_jobid] = e
            e.instance = (
                logical_instance or getattr(e, 'instance', None)
                or status.instance_name)

            preserve_handover_reservation = bool(
                prev is not None
                and getattr(status, 'handover_mode', '') in (
                    'TARGET_IMPORTED', 'TARGET_MIGRATING', 'TARGET_ACTIVE'))
            e.has_ssd = False
            e.ssd_total_gb = float(ssd_total_gb)
            e.ssd_used_gb = float(ssd_used_gb)            
            if not preserve_handover_reservation:
                e.res_ssd_reserved_gb = 0.0
            e.has_ssd = e.ssd_total_gb > 0.0

            totalgb = totmem / 1024.0
            average_use = totalgb / float(cores)

            add_log_line(
                gb,
                "Engine ("
                + str(cores)
                + "C:"
                + "{:1.1f}".format(average_use)
                + f" GB, {e.ssd_total_gb:.1f} GB SSD, {partition}) on {myid} is now online @ {cluster_jobid}",
                CYAN,
            )

        except Exception as e:
            add_log_line(gb, "Exception in register: " + str(e), RED)
        finally:
            self.lock.release()
        return myid

    def poll(
        self,
        myid,
        cpu_usage,
        mem_usage,
        load,
        mode,
        idle,
        current_cpu_usage,
        current_mem_usage,
        sys_cpu_busy,
        sys_iowait,
        ssd_total_gb,
        ssd_used_gb,
        gpfs_rx_mib_s=None,
        gpfs_tx_mib_s=None,
        gpfs_io_pct=None,
        gpfs_io_available=False,
    ):
        try:
            e = self.engine_by_id[myid]
            e.cpu_usage = cpu_usage
            e.mem_usage = mem_usage
            e.load = load
            try:
                e.sys_cpu_busy = float(sys_cpu_busy) if not sys_cpu_busy is None else 0.0
            except Exception:
                e.sys_cpu_busy = 0.0
            try:
                e.sys_iowait = float(sys_iowait) if not sys_iowait is None else 0.0
            except Exception:
                e.sys_iowait = 0.0

            def _to_float(value, default=None):
                if value is None:
                    return default
                try:
                    return float(value)
                except Exception:
                    return default

            total_ssd = _to_float(ssd_total_gb, None)
            if total_ssd is not None:
                total_ssd = max(0.0, total_ssd)
                e.ssd_total_gb = total_ssd
                e.has_ssd = total_ssd > 0.0
            elif getattr(e, "ssd_total_gb", None) is None:
                e.ssd_total_gb = 0.0
                e.has_ssd = False

            used_ssd = _to_float(ssd_used_gb, None)
            if used_ssd is not None:
                used_ssd = max(0.0, used_ssd)
                if getattr(e, "ssd_total_gb", 0.0) > 0.0:
                    used_ssd = min(used_ssd, e.ssd_total_gb)
                e.ssd_used_gb = used_ssd
            elif getattr(e, "ssd_used_gb", None) is None:
                e.ssd_used_gb = 0.0

            e.gpfs_io_available = bool(gpfs_io_available)
            if e.gpfs_io_available:
                e.gpfs_rx_mib_s = max(
                    0.0, _to_float(gpfs_rx_mib_s, 0.0))
                e.gpfs_tx_mib_s = max(
                    0.0, _to_float(gpfs_tx_mib_s, 0.0))
                e.gpfs_io_pct = min(
                    100.0, max(0.0, _to_float(gpfs_io_pct, 0.0)))
            else:
                e.gpfs_rx_mib_s = 0.0
                e.gpfs_tx_mib_s = 0.0
                e.gpfs_io_pct = 0.0
            
            e.lastseen = time.time()

            # Node usage report: write one line per poll
            try:
                if getattr(status, 'node_reports_file', None):
                    parts = None
                    try:
                        raw_parts = (getattr(status, 'config', {}) or {}).get('node_reports_include_partitions', None)
                        if raw_parts is None:
                            parts = None
                        else:
                            parts = _cfg_string_list(raw_parts, [])
                    except Exception:
                        parts = None
                    should_report = (e.partition == 'compute') if parts is None else (e.partition in parts)
                    if should_report:
                        ts_iso = datetime.datetime.now().isoformat()
                        # Queue stats for this partition
                        pending_jobs = 0
                        pending_cores = 0.0
                        pending_mem_mb = 0.0
                        try:
                            for j in list(jobs.jobs_by_id.values()):
                                if j.partition == e.partition and j.state in queue_states:
                                    pending_jobs += 1
                                    try:
                                        pending_cores += float(j.ncpu)
                                    except Exception:
                                        pending_cores += 0.0
                                    try:
                                        pending_mem_mb += float(j.mem)
                                    except Exception:
                                        pending_mem_mb += 0.0
                        except Exception:
                            # ensure we still log a line even if queue scan fails
                            pass

                        row = [
                            ts_iso,
                            e.engine_id,
                            (e.cluster_id if e.cluster_id is not False else "NA"),
                            e.partition,
                            e.status,
                            1 if getattr(e, 'managed', False) else 0,
                            1 if getattr(e, 'stopping', False) else 0,
                            int(e.cores),
                            float(e.totmem),
                            float(e.cpu_usage),
                            float(e.mem_usage),
                            float(e.load),
                            float(getattr(e, 'sys_cpu_busy', 0.0)),
                            float(getattr(e, 'sys_iowait', 0.0)),
                            float(getattr(e, 'res_cpu_reserved', 0.0)),
                            float(getattr(e, 'res_mem_reserved_mb', 0.0)),
                            int(len(getattr(e, 'jobs', []))),
                            1 if bool(getattr(e, 'has_ssd', False)) else 0,
                            float(getattr(e, 'ssd_total_gb', 0.0)),
                            float(getattr(e, 'ssd_used_gb', 0.0)),
                            float(getattr(e, 'res_ssd_reserved_gb', 0.0)),
                            float(getattr(e, 'gpfs_rx_mib_s', 0.0)),
                            float(getattr(e, 'gpfs_tx_mib_s', 0.0)),
                            float(getattr(e, 'gpfs_io_pct', 0.0)),
                            1 if bool(getattr(
                                e, 'gpfs_io_available', False)) else 0,
                            float(getattr(e, 'timeleft', 0.0)),
                            float(time.time() - float(getattr(e, 'starttime', time.time()))),
                            int(pending_jobs),
                            float(pending_cores),
                            float(pending_mem_mb),
                        ]
                        try:
                            status.reports_lock.acquire()
                            status.node_reports_file.write("\t".join([str(x) for x in row]) + "\n")
                            status.node_reports_file.flush()
                        finally:
                            status.reports_lock.release()
            except Exception as ex:
                try:
                    import traceback
                    add_log_line(
                        gb,
                        f"Exception writing node usage report for engine {myid}: {ex}",
                        RED,
                    )
                    add_log_line(gb, traceback.format_exc(), RED)
                    traceback.print_exc()
                except Exception:
                    pass

            # If this engine is stopping, do not reconcile or assign; force STOP
            if e.stopping:
                self.lock.acquire()
                commands = e.pending_commands
                e.pending_commands = []
                self.lock.release()
                commands.append((zslurm_shared.STOP, None))
                return commands

            commands = e.pending_commands
            # kill if idle for 3 minutes, but not if local engine or archive engine  (except if no extra jobs)
            if idle > 0.0 and e.status == PHASING_OUT:
                add_log_line(gb, "Stopping phased out engine: " + myid, YELLOW)
                commands.append((zslurm_shared.STOP, None))
            

            if commands:
                self.lock.acquire()
                commands = e.pending_commands
                e.pending_commands = []
                self.lock.release()

            for jobid, value in current_cpu_usage.items():
                job = jobs.jobs_by_id.get(jobid, None)
                if not job is None:
                    job.current_cpu_usage = value
                    mem = current_mem_usage.get(jobid, 0.0)
                    job.current_mem_usage = mem

            # Reconcile jobs after reregister events: if engine reports a job running
            # that the manager currently does not consider RUNNING, mark it RUNNING
            # and re-reserve resources if needed.
            jobs.lock.acquire()
            try:
                for jobid in list(current_cpu_usage.keys()):
                    job = jobs.jobs_by_id.get(jobid, None)
                    if job is None:
                        continue
                    if job.state != "RUNNING":
                        # If the job was queued (PENDING/REQUEUED), re-reserve storage resources
                        if job.state in queue_states:
                            jobs.active_inuse += job.active_start_use_add
                            jobs.dcache_inuse += job.dcache_start_use_add
                            jobs.archive_inuse += job.archive_start_use_add
                            jobs._reserve_dcache_transfer_locked(job)
                        # Transition to RUNNING on this engine (increments running_jobs and updates node_id)
                        jobs.job_start(myid, job.jobid)
                        add_log_line(
                            gb,
                            f"Reconciled job {job.job_name} (id: {job.jobid}) back to RUNNING on node {myid}",
                            BLUE,
                        )
            finally:
                jobs.lock.release()

        except KeyError:
            commands = []
            if mode == zslurm_shared.STOPPING:
                add_log_line(
                    gb,
                    "Poll for unknown engine id: " + myid + ". Engine is stopping.",
                    RED,
                )
                commands.append((zslurm_shared.STOP, None))
            else:                
                add_log_line(
                    gb,
                    "Poll for unknown engine id: " + myid + ". Taking ownership.",
                    RED,
                )
                commands.append((zslurm_shared.REREGISTER, None))

        return commands

    def unregister(self, myid):
        if myid in self.engine_by_id:
            e = self.engine_by_id[myid]
            self._unregister(e, "Engine unregistered")
            add_log_line(gb, "Engine with id " + myid + " unregistered", CYAN)
        else:
            add_log_line(gb, "Unregister request for unknown engine: " + myid, RED)

        return True

    def terminate_engine(self, myid):
        self.lock.acquire()
        try:
            e = self.engine_by_id[myid]
            # mark as stopping to prevent any further scheduling/starts
            e.stopping = True
            if (
                not (e.cluster_id is None or e.cluster_id is False)
                and e.cluster_id in self.engine_by_clusterid
            ):
                self.cancel_cid(e.cluster_id)
            if e.cluster_id is False:
                self.stop_local(gb)
        finally:
            self.lock.release()

    def _unregister(self, engine, reason="Engine disappeared"):
        jobs.engine_removed(engine.engine_id, reason=reason)
        self.lock.acquire()
        try:
            self.engine_by_id.pop(engine.engine_id, "")
            self.engine_by_clusterid.pop(engine.cluster_id, "")

        finally:
            self.lock.release()


engines = EngineManager()


def _migration_command_payload():
    target = copy.deepcopy(getattr(status, 'handover_target', None) or {})
    # The manager-to-manager secret authorizes state import only and must never
    # be sent to a chief or exposed through health/status output.
    target.pop('handover_secret', None)
    return target


def register(*args):
    myid = engines.register(*args)
    if getattr(status, 'handover_mode', '') in (
            'TARGET_IMPORTED', 'TARGET_MIGRATING', 'TARGET_ACTIVE'):
        try:
            cluster_id = str(args[4])
            status.handover_registered_cluster_ids.add(cluster_id)
            _maybe_finish_chief_migration()
        except Exception:
            pass
    if _handover_committed_source() and myid not in (None, 'DENIED'):
        engines.send_command(
            myid, zslurm_shared.MIGRATE_MANAGER,
            _migration_command_payload())
    return myid


def unregister(*args):
    _wait_for_handover_prepare()
    if _handover_committed_source():
        return _handover_proxy(True).unregister(*args)
    return engines.unregister(*args)


def poll(*args):
    _wait_for_handover_prepare()
    if _handover_committed_source():
        # Do not let the old controller leak STOP/DEASSIGN/lease commands after
        # commit.  A chief retries this idempotent migration on every old-server
        # poll until its target registration succeeds.
        return [(zslurm_shared.MIGRATE_MANAGER,
                 _migration_command_payload())]
    return engines.poll(*args)


def poll_with_gpfs(*args):
    """Extended chief poll; kept separate for rolling RPC compatibility."""
    return poll(*args)


def list_nodes(*args):
    if _handover_committed_source():
        return _handover_proxy(False).list_nodes(*args)
    return engines.list_nodes(*args)


def failed_node(*args):
    if _handover_committed_source():
        return _handover_proxy(True).failed_node(*args)
    return engines.failed_node(*args)


HANDOVER_SCHEMA_VERSION = 1


def _rpc_safe(value):
    """Convert manager state to XML-RPC-safe primitives."""
    if value is None or isinstance(value, (str, bytes, bool, int, float)):
        return value
    if isinstance(value, dict):
        return {str(key): _rpc_safe(item) for key, item in value.items()}
    if isinstance(value, (list, tuple, set, deque)):
        return [_rpc_safe(item) for item in value]
    try:
        scalar = value.item()
        if isinstance(scalar, (bool, int, float, str)):
            return scalar
    except Exception:
        pass
    return str(value)


def _manager_descriptor(instance_name=None, include_secret=False):
    name = str(instance_name or status.instance_name or "")
    cfg = zslurm_shared.get_instance_config(name) or {}
    host = cfg.get('advertise_host') or cfg.get('bind_host') or status.address
    port = int(cfg.get('base_port', status.port))
    rpcpath = cfg.get('rpcpath') or (getattr(status, 'config', {}) or {}).get('rpcpath')
    descriptor = {
        'instance': name,
        'manager_uuid': str(cfg.get('manager_uuid') or status.manager_uuid),
        'advertise_host': str(host),
        'base_port': port,
        'rpcpath': str(rpcpath),
        'manager_url': f"http://{host}:{port}/{rpcpath}",
        'job_url': f"http://{host}:{port + 1}/{rpcpath}",
    }
    if include_secret:
        descriptor['handover_secret'] = str(
            cfg.get('handover_secret') or status.handover_secret)
    return descriptor


def _instance_names_owned_by(manager_uuid):
    owned = []
    for name in zslurm_shared.get_instance_names():
        cfg = zslurm_shared.get_instance_config(name) or {}
        if str(cfg.get('manager_uuid') or '') == str(manager_uuid or ''):
            owned.append(str(name))
    return sorted(set(owned))


def _snapshot_job(job, requeue_assigned=False):
    data = copy.deepcopy(getattr(job, '__dict__', {}))
    if requeue_assigned and data.get('state') == 'ASSIGNED':
        data['state'] = 'PENDING'
        data['node_id'] = None
        data['current_cpu_usage'] = 0.0
        data['current_mem_usage'] = 0.0
        data['ssd_alloc_gb'] = 0.0
    return _rpc_safe(data)


def _build_handover_snapshot(
        handover_id, target_descriptor, autogrow_enable=None,
        autoconsolidate_enable=None):
    """Build a consistent source snapshot while caller holds both manager locks."""
    assigned_jobs = [
        job for job in jobs.jobs_by_id.values()
        if getattr(job, 'state', None) == 'ASSIGNED'
    ]
    active_inuse = float(jobs.active_inuse)
    dcache_inuse = float(jobs.dcache_inuse)
    archive_inuse = float(jobs.archive_inuse)
    download_inuse = float(jobs.dcache_download_inuse)
    upload_inuse = float(jobs.dcache_upload_inuse)
    s3_inuse = float(jobs.s3_download_inuse)
    for job in assigned_jobs:
        active_inuse -= float(getattr(job, 'active_start_use_add', 0.0) or 0.0)
        dcache_inuse -= float(getattr(job, 'dcache_start_use_add', 0.0) or 0.0)
        archive_inuse -= float(getattr(job, 'archive_start_use_add', 0.0) or 0.0)
        down, up = jobs._dcache_slot_needs(job)
        download_inuse -= down
        upload_inuse -= up
        s3_inuse -= jobs._s3_download_slot_need(job)

    engine_records = []
    for cluster_id, engine in engines.engine_by_clusterid.items():
        if engine is None:
            continue
        record = copy.deepcopy(getattr(engine, '__dict__', {}))
        record['cluster_id'] = cluster_id
        record['jobs'] = list(getattr(engine, 'jobs', set()) or set())
        record['pending_commands'] = list(
            getattr(engine, 'pending_commands', []) or [])
        engine_records.append(_rpc_safe(record))

    manager_values = {
        'jobid_counter': int(jobs.jobid_counter),
        'active_total': float(jobs.active_total),
        'active_inuse': max(0.0, active_inuse),
        'dcache_total': float(jobs.dcache_total),
        'dcache_inuse': max(0.0, dcache_inuse),
        'archive_total': float(jobs.archive_total),
        'archive_inuse': max(0.0, archive_inuse),
        'dcache_download_total': float(jobs.dcache_download_total),
        'dcache_download_inuse': max(0.0, download_inuse),
        'dcache_upload_total': float(jobs.dcache_upload_total),
        'dcache_upload_inuse': max(0.0, upload_inuse),
        's3_download_total': float(jobs.s3_download_total),
        's3_download_inuse': max(0.0, s3_inuse),
        'total_jobs': jobs.total_jobs,
        'running_jobs': jobs.running_jobs,
        'failed_jobs': jobs.failed_jobs,
        'done_jobs': jobs.done_jobs,
    }
    scheduler_values = {
        'lastin_first': bool(status.lastin_first),
        'prio_fillmem_context': int(status.prio_fillmem_context),
        'autogrow_enable': bool(
            status.autogrow_enable
            if autogrow_enable is None else autogrow_enable),
        'autoconsolidate_enable': bool(
            status.autoconsolidate_enable
            if autoconsolidate_enable is None else autoconsolidate_enable),
        'autogrow_max_compute_nodes': int(
            (getattr(status, 'config', {}) or {}).get(
                'autogrow_max_compute_nodes', 0) or 0),
    }
    finished = []
    for owner, owner_jobs in jobs.finished_jobs_by_owner.items():
        finished.append({
            'owner': owner,
            'jobs': [_snapshot_job(job) for job in owner_jobs],
        })

    return _rpc_safe({
        'schema_version': HANDOVER_SCHEMA_VERSION,
        'handover_id': str(handover_id),
        'source': _manager_descriptor(status.instance_name, include_secret=False),
        'source_instance_names': _instance_names_owned_by(status.manager_uuid),
        'target_manager_uuid': target_descriptor.get('manager_uuid'),
        'created_at': time.time(),
        'jobs': [
            _snapshot_job(job, requeue_assigned=True)
            for job in jobs.jobs_by_id.values()
        ],
        'finished_jobs': finished,
        'seen_tokens': jobs.seen_tokens,
        'dependency_history': list(jobs.dependency_history.items()),
        'manager': manager_values,
        'scheduler': scheduler_values,
        'engines': engine_records,
        'archive_failed_nodes': list(engines.archive_failed_nodes),
        'held_engine_cids': list(engines.held_engine_cids),
        'registered_cluster_ids': [
            str(engine.cluster_id)
            for engine in engines.engine_by_id.values()
            if getattr(engine, 'cluster_id', None) not in (None, False, '')
        ],
    })


def _job_from_handover(data):
    job = Job.__new__(Job)
    job.__dict__.update(copy.deepcopy(data or {}))
    return job


def _apply_handover_snapshot(snapshot):
    """Import a source snapshot into an already-validated empty target."""
    manager = snapshot.get('manager', {}) or {}
    scheduler = snapshot.get('scheduler', {}) or {}

    jobs.jobs_by_id = OrderedDict()
    for data in snapshot.get('jobs', []) or []:
        job = _job_from_handover(data)
        jobs.jobs_by_id[str(job.jobid)] = job
    jobs.finished_jobs_by_owner = {}
    for owner_record in snapshot.get('finished_jobs', []) or []:
        owner = owner_record.get('owner')
        jobs.finished_jobs_by_owner[owner] = [
            _job_from_handover(data)
            for data in owner_record.get('jobs', []) or []
        ]
    jobs.seen_tokens = dict(snapshot.get('seen_tokens', {}) or {})
    jobs.dependency_history = OrderedDict(
        (str(key), value)
        for key, value in (snapshot.get('dependency_history', []) or [])
    )
    jobs.jobid_counter = int(manager.get('jobid_counter', jobs.jobid_counter))
    for name in (
        'active_total', 'active_inuse', 'dcache_total', 'dcache_inuse',
        'archive_total', 'archive_inuse', 'dcache_download_total',
        'dcache_download_inuse', 'dcache_upload_total',
        'dcache_upload_inuse', 's3_download_total', 's3_download_inuse',
    ):
        if name in manager:
            setattr(jobs, name, float(manager[name]))
    for name in ('total_jobs', 'running_jobs', 'failed_jobs', 'done_jobs'):
        setattr(jobs, name, dict(manager.get(name, {}) or {}))
    jobs._eligible_cache_ts = 0.0

    engines.engine_by_id = {}
    engines.engine_by_clusterid = {}
    for data in snapshot.get('engines', []) or []:
        record = copy.deepcopy(data or {})
        cluster_id = record.get('cluster_id')
        engine = Engine()
        engine.__dict__.update(record)
        engine.cluster_id = cluster_id
        # Keep the Slurm job name under which this allocation was submitted.
        # The target's own logical instance name differs after handover.
        engine.instance = (
            record.get('instance')
            or (snapshot.get('source', {}) or {}).get('instance')
            or status.handover_source_instance)
        engine.jobs = set(record.get('jobs', []) or [])
        engine.pending_commands = [
            tuple(command) for command in record.get('pending_commands', []) or []
        ]
        engines.engine_by_clusterid[str(cluster_id)] = engine
    engines.archive_failed_nodes = set(
        snapshot.get('archive_failed_nodes', []) or [])
    engines.held_engine_cids = set(snapshot.get('held_engine_cids', []) or [])

    status.lastin_first = bool(scheduler.get(
        'lastin_first', status.lastin_first))
    status.prio_fillmem_context = max(1, int(scheduler.get(
        'prio_fillmem_context', status.prio_fillmem_context)))
    status.handover_saved_autogrow = bool(scheduler.get(
        'autogrow_enable', False))
    status.handover_saved_autoconsolidate = bool(scheduler.get(
        'autoconsolidate_enable', False))
    status.handover_expected_cluster_ids = set(
        str(value)
        for value in snapshot.get('registered_cluster_ids', []) or [])
    status.handover_registered_cluster_ids = set()
    status.handover_owned_aliases = set(
        str(value)
        for value in snapshot.get('source_instance_names', []) or [])
    status.autogrow_enable = False
    status.autoconsolidate_enable = False
    if isinstance(getattr(status, 'config', None), dict):
        status.config['autogrow_max_compute_nodes'] = int(scheduler.get(
            'autogrow_max_compute_nodes',
            status.config.get('autogrow_max_compute_nodes', 0)) or 0)


def receive_handover(secret, handover_id, snapshot):
    """Target-side import called by the explicitly selected source manager."""
    if not secrets.compare_digest(
            str(secret or ''), str(status.handover_secret or '')):
        return {'ok': False, 'code': 3, 'error': 'invalid handover secret'}
    if int(snapshot.get('schema_version', -1)) != HANDOVER_SCHEMA_VERSION:
        return {'ok': False, 'code': 3, 'error': 'incompatible handover schema'}
    if str(snapshot.get('target_manager_uuid') or '') != str(status.manager_uuid):
        return {'ok': False, 'code': 3, 'error': 'snapshot targets another manager'}
    if getattr(status, 'handover_mode', 'ACTIVE') != 'ACTIVE':
        return {'ok': False, 'code': 3,
                'error': f"target is in handover state {status.handover_mode}"}

    jobs.lock.acquire()
    engines.lock.acquire()
    try:
        if (jobs.jobs_by_id or jobs.finished_jobs_by_owner
                or engines.engine_by_id or engines.engine_by_clusterid):
            return {'ok': False, 'code': 3,
                    'error': 'target manager is not empty'}
        status.handover_mode = 'TARGET_IMPORTED'
        status.handover_source_instance = (
            snapshot.get('source', {}) or {}).get('instance')
        _apply_handover_snapshot(snapshot)
    finally:
        engines.lock.release()
        jobs.lock.release()
    add_log_line(
        gb,
        f"Handover {handover_id}: imported {len(jobs.jobs_by_id)} active jobs "
        f"from {status.handover_source_instance}.",
        CYAN,
    )
    return {
        'ok': True,
        'handover_id': str(handover_id),
        'jobs': len(jobs.jobs_by_id),
        'engines': len(engines.engine_by_clusterid),
    }


def activate_received_handover(secret, handover_id):
    if not secrets.compare_digest(
            str(secret or ''), str(status.handover_secret or '')):
        return {'ok': False, 'code': 3, 'error': 'invalid handover secret'}
    if getattr(status, 'handover_mode', '') not in (
            'TARGET_IMPORTED', 'TARGET_MIGRATING', 'TARGET_ACTIVE'):
        return {'ok': False, 'code': 3,
                'error': f"target is in handover state {status.handover_mode}"}
    if status.handover_mode != 'TARGET_ACTIVE':
        status.handover_mode = 'TARGET_MIGRATING'
    # Source ownership is committed before this call. Scheduling controls may
    # resume now; chief registration completion is tracked independently and
    # must not leave throughput disabled when a chief disappears mid-handover.
    status.autogrow_enable = bool(status.handover_saved_autogrow)
    status.autoconsolidate_enable = bool(
        status.handover_saved_autoconsolidate)
    _maybe_finish_chief_migration()
    remaining = sorted(
        status.handover_expected_cluster_ids
        - status.handover_registered_cluster_ids)
    add_log_line(
        gb,
        f"Handover {handover_id}: target imported; waiting for "
        f"{len(remaining)} chief migration(s).",
        GREEN if not remaining else YELLOW,
    )
    return {
        'ok': True,
        'handover_id': str(handover_id),
        'remaining_chiefs': len(remaining),
    }


def _maybe_finish_chief_migration():
    expected = set(getattr(status, 'handover_expected_cluster_ids', set()) or set())
    registered = set(
        getattr(status, 'handover_registered_cluster_ids', set()) or set())
    if expected - registered:
        return False
    if getattr(status, 'handover_mode', '') in (
            'TARGET_IMPORTED', 'TARGET_MIGRATING'):
        status.handover_mode = 'TARGET_ACTIVE'
        status.autogrow_enable = bool(status.handover_saved_autogrow)
        status.autoconsolidate_enable = bool(
            status.handover_saved_autoconsolidate)
    return True


def abort_received_handover(secret, handover_id):
    global jobs, engines
    if not secrets.compare_digest(
            str(secret or ''), str(status.handover_secret or '')):
        return {'ok': False, 'code': 3, 'error': 'invalid handover secret'}
    if getattr(status, 'handover_mode', '') != 'TARGET_IMPORTED':
        return {'ok': False, 'code': 3,
                'error': f"target is in handover state {status.handover_mode}"}
    jobs = JobManager()
    jobs.configure_transfer_limits(getattr(status, 'config', {}) or {})
    engines = EngineManager()
    status.handover_mode = 'ACTIVE'
    status.handover_source_instance = None
    status.handover_owned_aliases = set()
    status.handover_expected_cluster_ids = set()
    status.handover_registered_cluster_ids = set()
    status.autogrow_enable = False
    status.autoconsolidate_enable = False
    add_log_line(gb, f"Handover {handover_id}: target import rolled back.", YELLOW)
    return {'ok': True, 'handover_id': str(handover_id)}


def handover_to(secret, target_descriptor):
    """Source-side transaction requested by a specifically named new manager."""
    if not secrets.compare_digest(
            str(secret or ''), str(status.handover_secret or '')):
        return {'ok': False, 'code': 3, 'error': 'invalid handover secret'}
    previous_mode = getattr(status, 'handover_mode', 'ACTIVE')
    if previous_mode not in ('ACTIVE', 'TARGET_ACTIVE', 'TARGET_MIGRATING'):
        return {'ok': False, 'code': 3,
                'error': f"source is in handover state {status.handover_mode}"}
    if str(target_descriptor.get('manager_uuid') or '') == str(status.manager_uuid):
        return {'ok': False, 'code': 3, 'error': 'cannot hand over to self'}
    required = ('instance', 'manager_uuid', 'manager_url', 'job_url',
                'advertise_host', 'base_port', 'rpcpath', 'handover_secret')
    missing = [key for key in required if not target_descriptor.get(key)]
    if missing:
        return {'ok': False, 'code': 3,
                'error': 'target descriptor misses ' + ', '.join(missing)}

    local_engines = [
        engine.engine_id for engine in engines.engine_by_id.values()
        if getattr(engine, 'cluster_id', None) in (None, False, '')
    ]
    if local_engines:
        return {'ok': False, 'code': 3,
                'error': 'local/unmanaged engines cannot be handed over: '
                         + ', '.join(local_engines)}

    handover_id = str(uuid.uuid4())
    previous_autogrow = bool(status.autogrow_enable)
    previous_consolidate = bool(status.autoconsolidate_enable)
    status.handover_mode = 'SOURCE_PREPARING'
    status.autogrow_enable = False
    status.autoconsolidate_enable = False

    # handover_to itself runs on the source job RPC.  Call back on the target's
    # manager RPC, not its job RPC: handover may have been initiated through
    # the latter and SimpleXMLRPCServer handles one request at a time.
    target_proxy = zslurm_shared.TimeoutServerProxy(
        str(target_descriptor['manager_url']), timeout=300, allow_none=True)
    imported = False
    replaced_instance_configs = {}
    jobs.lock.acquire()
    engines.lock.acquire()
    try:
        snapshot = _build_handover_snapshot(
            handover_id,
            target_descriptor,
            autogrow_enable=previous_autogrow,
            autoconsolidate_enable=previous_consolidate,
        )
        result = target_proxy.receive_handover(
            str(target_descriptor['handover_secret']), handover_id, snapshot)
        if not isinstance(result, dict) or not result.get('ok'):
            error = (result or {}).get('error', 'target rejected snapshot') \
                if isinstance(result, dict) else 'invalid target response'
            raise RuntimeError(str(error))
        imported = True

        # Redirect the source's primary name and any aliases inherited through
        # an earlier handover. Keep originals so a filesystem error can roll
        # the records back together with the target snapshot.
        source_names = list(snapshot.get('source_instance_names', []) or [])
        if status.instance_name not in source_names:
            source_names.append(status.instance_name)
        for source_name in source_names:
            current = zslurm_shared.get_instance_config(source_name) or {}
            if str(current.get('manager_uuid') or '') != str(status.manager_uuid):
                continue
            replaced_instance_configs[source_name] = current
            alias_config = {
                'name': str(source_name),
                'bind_host': str(target_descriptor['advertise_host']),
                'advertise_host': str(target_descriptor['advertise_host']),
                'base_port': int(target_descriptor['base_port']),
                'rpcpath': str(target_descriptor['rpcpath']),
                'manager_uuid': str(target_descriptor['manager_uuid']),
                'handover_secret': str(target_descriptor['handover_secret']),
                'handover_state': 'ALIAS',
                'alias_of': str(target_descriptor['instance']),
            }
            zslurm_shared.set_instance_config(source_name, alias_config)
        if status.instance_name not in replaced_instance_configs:
            raise RuntimeError('source instance ownership changed during handover')

        status.handover_target = copy.deepcopy(target_descriptor)
        status.handover_mode = 'SOURCE_COMMITTED'
        status.handover_preserve_engines = True
        payload = _migration_command_payload()
        for engine in engines.engine_by_id.values():
            # Existing commands were imported with the engine placeholder and
            # will be delivered by the target after registration. The source
            # may now issue only the migration itself.
            engine.pending_commands = [
                (zslurm_shared.MIGRATE_MANAGER, copy.deepcopy(payload))]
    except Exception as error:
        for source_name, original in replaced_instance_configs.items():
            try:
                zslurm_shared.set_instance_config(source_name, original)
            except Exception:
                pass
        status.handover_mode = previous_mode
        status.autogrow_enable = previous_autogrow
        status.autoconsolidate_enable = previous_consolidate
        if imported:
            try:
                target_proxy.abort_received_handover(
                    str(target_descriptor['handover_secret']), handover_id)
            except Exception:
                pass
        add_log_line(gb, f"Handover {handover_id} failed: {error}", RED)
        return {'ok': False, 'code': 3, 'error': str(error),
                'handover_id': handover_id}
    finally:
        engines.lock.release()
        jobs.lock.release()

    try:
        activation = target_proxy.activate_received_handover(
            str(target_descriptor['handover_secret']), handover_id)
    except Exception as error:
        activation = {
            'ok': False,
            'code': 2,
            'error': f'target activation response was lost: {error}',
        }
    if not isinstance(activation, dict) or not activation.get('ok'):
        add_log_line(
            gb,
            f"Handover {handover_id}: state transferred, but target activation "
            f"needs attention: {activation}",
            RED,
        )
    add_log_line(
        gb,
        f"Handover {handover_id}: transferred to "
        f"{target_descriptor['instance']}; {len(engines.engine_by_id)} chiefs "
        f"have been instructed to migrate.",
        GREEN,
    )
    return {
        'ok': True,
        'handover_id': handover_id,
        'source_instance': status.instance_name,
        'target_instance': target_descriptor['instance'],
        'jobs': len(jobs.jobs_by_id),
        'chiefs': len(engines.engine_by_id),
        'target_activation': activation,
    }


def initiate_handover(old_instance):
    """Target-side entry point used by Shift-H and the control RPC."""
    old_name = str(old_instance or '').strip()
    if not old_name:
        return {'ok': False, 'code': 3, 'error': 'old instance name is empty'}
    if old_name == str(status.instance_name):
        return {'ok': False, 'code': 3, 'error': 'cannot hand over from self'}
    if jobs.jobs_by_id or jobs.finished_jobs_by_owner \
            or engines.engine_by_id or engines.engine_by_clusterid:
        return {'ok': False, 'code': 3, 'error': 'new target manager is not empty'}
    old_cfg = zslurm_shared.get_instance_config(old_name) or {}
    old_secret = old_cfg.get('handover_secret')
    if not old_secret:
        return {'ok': False, 'code': 3,
                'error': 'old instance does not support explicit handover'}
    try:
        source_proxy = zslurm_shared.TimeoutServerProxy(
            zslurm_shared.get_job_url(instance=old_name),
            timeout=300, allow_none=True)
        return source_proxy.handover_to(
            str(old_secret), _manager_descriptor(
                status.instance_name, include_secret=True))
    except Exception as error:
        return {'ok': False, 'code': 2,
                'error': f"could not contact old instance {old_name}: {error}"}


def _partial_engine_schedulable_memory_mb(cores):
    """Mirror the chief's memory envelope for a partial Slurm allocation."""
    try:
        cores = max(0, int(cores))
        per_core = max(
            0.0,
            float(getattr(status, 'autogrow_engine_memory_mb_per_core', 0.0)),
        )
    except (TypeError, ValueError):
        return 0.0
    if cores <= 0 or per_core <= 0.0:
        return 0.0
    hard_limit_mb = float(cores) * per_core
    reserve_mb = max(
        0.0,
        float(getattr(status, 'autogrow_engine_memory_static_reserve_mb', 0.0)),
    )
    headroom = min(
        0.99,
        max(
            0.0,
            float(getattr(status, 'autogrow_engine_memory_headroom_fraction', 0.0)),
        ),
    )
    cap_fraction = min(
        1.0,
        max(
            0.0,
            float(getattr(status, 'autogrow_engine_memory_cap_fraction', 1.0)),
        ),
    )
    return max(
        0.0,
        min(
            cap_fraction * hard_limit_mb,
            (1.0 - headroom) * max(0.0, hard_limit_mb - reserve_mb),
        ),
    )


def _autogrow_engine_capacity(partition, requested_cores):
    """Return the capacity a queued engine is expected to advertise."""
    prof = status.node_profiles.get(str(partition)) or {}
    if bool(getattr(status, 'autogrow_dynamic_engine_cores', False)):
        try:
            cores = max(0, int(requested_cores))
        except (TypeError, ValueError):
            cores = 0
        memory_mb = _partial_engine_schedulable_memory_mb(cores)
        if cores > 0 and memory_mb > 0.0:
            return float(cores), float(memory_mb)
    return (
        max(0.0, float(prof.get('cores', 0.0) or 0.0)),
        max(0.0, float(prof.get('mem_gb', 0.0) or 0.0) * 1024.0),
    )


def _autogrow_requested_engine_cores(
        eligible, best_part, size_cpu, size_mem_mb, raw_best_nodes):
    """Size one partial pilot to demand, while retaining a configured hard cap."""
    configured = max(0, int(getattr(status, 'autogrow_engine_cores', 0) or 0))
    if configured <= 0 or not bool(
            getattr(status, 'autogrow_dynamic_engine_cores', False)):
        return configured
    profile = status.node_profiles.get(str(best_part)) or {}
    profile_cores = max(0, int(float(profile.get('cores', 0.0) or 0.0)))
    maximum = min(configured, profile_cores) if profile_cores > 0 else configured
    minimum = min(
        maximum,
        max(1, int(getattr(status, 'autogrow_engine_min_cores', 1) or 1)),
    )
    if int(raw_best_nodes or 0) > 1:
        return maximum

    largest_cpu = max(
        [max(0.0, float(getattr(job, 'ncpu', 0.0) or 0.0)) for job in eligible]
        or [0.0]
    )
    largest_mem_mb = max(
        [max(0.0, float(getattr(job, 'mem', 0.0) or 0.0)) for job in eligible]
        or [0.0]
    )
    needed_cpu = int(math.ceil(max(float(size_cpu), largest_cpu, 0.0)))
    needed_mem_mb = max(float(size_mem_mb), largest_mem_mb, 0.0)
    memory_cores = 0
    for candidate in range(1, maximum + 1):
        if _partial_engine_schedulable_memory_mb(candidate) + 1e-9 >= needed_mem_mb:
            memory_cores = candidate
            break
    if memory_cores == 0 and needed_mem_mb > 0.0:
        memory_cores = maximum
    return min(maximum, max(minimum, needed_cpu, memory_cores))


def compute_autogrow_plan(all_engines, partition):    
    eligible = []
    download_available = max(
        0.0, jobs.dcache_download_total - jobs.dcache_download_inuse
    )
    upload_available = max(
        0.0, jobs.dcache_upload_total - jobs.dcache_upload_inuse
    )
    s3_download_available = max(
        0.0, jobs.s3_download_total - jobs.s3_download_inuse
    )
    for j in list(jobs.jobs_by_id.values()):
        if (
            j.partition == partition
            and j.state in queue_states
            and jobs.dependency_status(j)["state"] == DEPENDENCY_SATISFIED
            and ((jobs.active_total >= (jobs.active_inuse + j.active_start_use_add)) or j.active_start_use_add == 0)
            and ((jobs.dcache_total >= (jobs.dcache_inuse + j.dcache_start_use_add)) or j.dcache_start_use_add == 0)
            and ((jobs.archive_total >= (jobs.archive_inuse + j.archive_start_use_add)) or j.archive_start_use_add == 0)
            and jobs._dcache_transfer_fits_locked(
                j, download_available, upload_available,
                s3_download_available
            )
        ):
            eligible.append(j)
            download_need, upload_need = jobs._dcache_slot_needs(j)
            download_available -= download_need
            upload_available -= upload_need
            s3_download_available -= jobs._s3_download_slot_need(j)

    unique_part = list(set([part_name for part_name,_ in status.autogrow_prefer_partitions]))
    fallback_part = str(getattr(status, 'autogrow_fallback_partition', '') or '')
    fallback_prof = status.node_profiles.get(fallback_part) or {}
    if not fallback_prof and status.node_profiles:
        fallback_part = next(iter(status.node_profiles.keys()))
        fallback_prof = status.node_profiles.get(fallback_part) or {}

    #Reserved resources
    res_cpu = sum(float(getattr(e, 'res_cpu_reserved', 0.0)) for e in all_engines if e.partition == partition)
    res_mem_mb = sum(float(getattr(e, 'res_mem_reserved_mb', 0.0)) for e in all_engines if e.partition == partition)

    #Pending resources
    pend_cpu = sum(float(j.ncpu) for j in eligible)
    pend_mem_mb = sum(float(j.mem) for j in eligible)

    #Total capacity of the partition
    tot_cpu_cap = sum(float(getattr(e, 'cores', 0.0)) for e in all_engines if e.partition == partition)
    tot_mem_cap_mb = sum(float(getattr(e, 'totmem', 0.0)) for e in all_engines if e.partition == partition)


    #Add queued resources
    queue_cpu_cap = 0.0
    queue_mem_cap_mb = 0.0

    queued_detail_counts = defaultdict(int)
    queued_capacity = getattr(engines, 'queued_engine_capacity_by_cid', {}) or {}
    for detail in list(getattr(engines, 'queued_engines_detail', []) or []):
        try:
            cid, part_name, _age, _scratch = detail
        except (TypeError, ValueError):
            continue
        if part_name not in unique_part:
            continue
        queued_detail_counts[part_name] += 1
        prof = status.node_profiles.get(part_name) or {}
        capacity = queued_capacity.get(str(cid))
        try:
            queued_cores = float(capacity[0])
            queued_mem_mb = float(capacity[1])
        except (TypeError, ValueError, IndexError):
            queued_cores = float(prof.get('cores', 0.0) or 0.0)
            queued_mem_mb = float(prof.get('mem_gb', 0.0) or 0.0) * 1024.0
        queue_cpu_cap += max(0.0, queued_cores)
        queue_mem_cap_mb += max(0.0, queued_mem_mb)

    # Preserve compatibility with old snapshots or transient squeue rows that do
    # not yet expose per-allocation capacity: only those unmatched allocations use
    # the full configured profile as a conservative legacy fallback.
    for part_name in unique_part:
        nqueued_engines = int(
            (getattr(engines, 'cluster_queued_by_partition', {}) or {}).get(
                part_name, 0
            ) or 0
        )
        unmatched = max(0, nqueued_engines - queued_detail_counts[part_name])
        prof = status.node_profiles.get(part_name) or {}
        queue_cpu_cap += unmatched * float(prof.get('cores', 0.0) or 0.0)
        queue_mem_cap_mb += (
            unmatched * float(prof.get('mem_gb', 0.0) or 0.0) * 1024.0
        )

        
    fat_partitions = list(getattr(status, 'autogrow_fat_partitions', []) or [])

    # Largest single-node cpu / mem across the known profiles (for the "only grow
    # if we can fill an engine" gate -- must consider BOTH axes, else a memory-bound
    # backlog with a small core count never triggers growth).
    largest_cores = 0
    largest_mem_mb = 0.0
    try:
        if status.node_profiles:
            largest_cores = max(int((prof or {}).get('cores', 0) or 0) for prof in status.node_profiles.values())
            largest_mem_mb = max(float((prof or {}).get('mem_gb', 0.0) or 0.0) for prof in status.node_profiles.values()) * 1024.0
    except Exception:
        largest_cores = 0
        largest_mem_mb = 0.0
    if largest_cores <= 0:
        largest_cores = int(fallback_prof.get('cores', 0) or 0)
    if largest_mem_mb <= 0.0:
        largest_mem_mb = float(fallback_prof.get('mem_gb', 0.0) or 0.0) * 1024.0

    # Smallest mem/core among the thin (non-fat) profiles: the ceiling of what a
    # cheap node can offer per core. A backlog demanding more GB/core than this
    # can only be cleared efficiently on fat nodes.
    thin_mpc = 0.0
    for _pname, _prof in status.node_profiles.items():
        if str(_pname) in fat_partitions:
            continue
        _c = float(_prof.get('cores', 0.0) or 0.0)
        _m = float(_prof.get('mem_gb', 0.0) or 0.0)
        if _c > 0.0:
            _mpc = _m / _c
            thin_mpc = _mpc if thin_mpc == 0.0 else min(thin_mpc, _mpc)
    if thin_mpc <= 0.0:
        thin_mpc = 1.75

    # Does any *eligible* pending job actually require node-local SSD? Only then do
    # we restrict growth to the scarce scratch-node pool; otherwise we grow onto the
    # much larger plain-node pools (this is why full genoa-scratch stranded engines
    # while rome and plain genoa sat idle).
    ssd_eligible = [j for j in eligible if str(getattr(j, 'ssd_use', 'no') or 'no') == 'required']
    need_ssd = len(ssd_eligible) > 0

    # SSD-required work can ONLY run on scratch-node engines, so its residual demand
    # must be sized against SSD-engine free capacity alone -- plain free cores never
    # help it. Without this a large plain-node backlog masks stuck ssd_use=required
    # jobs and autogrow reports "no nodes needed" while deepvariant/glnexus hang.
    ssd_pend_cpu = sum(float(getattr(j, 'ncpu', 0.0) or 0.0) for j in ssd_eligible)
    ssd_pend_mem_mb = sum(float(getattr(j, 'mem', 0.0) or 0.0) for j in ssd_eligible)
    free_ssd_cpu = sum(
        max(0.0, float(getattr(e, 'cores', 0.0) or 0.0) - float(getattr(e, 'res_cpu_reserved', 0.0) or 0.0))
        for e in all_engines if e.partition == partition and getattr(e, 'has_ssd', False))
    free_ssd_mem_mb = sum(
        max(0.0, float(getattr(e, 'totmem', 0.0) or 0.0) - float(getattr(e, 'res_mem_reserved_mb', 0.0) or 0.0))
        for e in all_engines if e.partition == partition and getattr(e, 'has_ssd', False))

    # A scratch-constrained Slurm engine that is already queued will become
    # usable by ssd_use=required jobs once it starts.  The general residual
    # below already deducts every queued engine, but the SSD-only residual used
    # to look solely at running SSD engines.  That made the same scratch demand
    # pull in fresh engines on every autogrow cycle while earlier allocations
    # were still waiting in Slurm.  Count only non-held queued allocations whose
    # recorded constraint really is scratch-node; plain queued engines cannot
    # satisfy this demand.  Unknown profiles are ignored conservatively.
    queued_ssd_cpu = 0.0
    queued_ssd_mem_mb = 0.0
    for detail in list(getattr(engines, 'queued_engines_detail', []) or []):
        try:
            _cid, queued_part, _age, is_scratch = detail
        except (TypeError, ValueError):
            continue
        if not is_scratch:
            continue
        prof = status.node_profiles.get(str(queued_part)) or {}
        capacity = queued_capacity.get(str(_cid))
        try:
            queued_cpu = max(0.0, float(capacity[0]))
            queued_mem_mb = max(0.0, float(capacity[1]))
        except (TypeError, ValueError, IndexError):
            if not prof:
                continue
            queued_cpu = max(0.0, float(prof.get('cores', 0.0) or 0.0))
            queued_mem_mb = max(
                0.0, float(prof.get('mem_gb', 0.0) or 0.0) * 1024.0
            )
        queued_ssd_cpu += queued_cpu
        queued_ssd_mem_mb += queued_mem_mb

    ssd_required_cpu = max(
        0.0, ssd_pend_cpu - free_ssd_cpu - queued_ssd_cpu
    )
    ssd_required_mem_mb = max(
        0.0, ssd_pend_mem_mb - free_ssd_mem_mb - queued_ssd_mem_mb
    )

    # Free cluster capacity across currently running engines after pending jobs
    free_cpu_total = max(0.0, tot_cpu_cap - res_cpu)
    free_mem_total_mb = max(0.0, tot_mem_cap_mb - res_mem_mb)

    #Required resources.
    #The 1.1 is to not overgrow the cluster too much and have to shrink it too soon.
    required_cpu = max(0.0, pend_cpu - free_cpu_total * 1.1 - queue_cpu_cap)
    required_mem_mb = max(0.0, pend_mem_mb - free_mem_total_mb * 1.1 - queue_mem_cap_mb)

    # Memory-per-core pressure for info only
    avail_mpc = ((tot_mem_cap_mb + queue_mem_cap_mb) / 1024.0) / max(1.0, (tot_cpu_cap + queue_cpu_cap))
    required_mpc = ((res_mem_mb + pend_mem_mb) / 1024.0) / max(1.0, (res_cpu + pend_cpu))

    # mem/core of the UNMET (residual) backlog. When memory is the binding
    # constraint the cluster runs out of RAM headroom while cores remain free, so
    # required_cpu -> 0 while required_mem stays high -> req_mpc spikes -> fat wins.
    req_mpc = (required_mem_mb / 1024.0) / max(1.0, required_cpu)
    need_fat = req_mpc > (thin_mpc * 1.05)

    # Only decline to grow when a full engine's worth of work is unmet on NEITHER
    # axis. Previously this gate was CPU-only, so a memory-bound backlog (many small
    # cores, lots of RAM) never grew fat nodes even under heavy memory pressure.
    if (required_cpu <= largest_cores and required_mem_mb <= largest_mem_mb
            and ssd_required_cpu <= 0.0 and ssd_required_mem_mb <= 0.0
            and tot_cpu_cap > 0):
        return {
            'has_eligible': len(eligible) > 0,
            'eligible_n': len(eligible),
            'plan_part': None,
            'plan_nodes': 0.0,
            'plan_use_scratch': need_ssd,
            'plan_need_ssd': need_ssd,
            'needed_cpu': required_cpu / max(1.0, float(fallback_prof.get('cores', 0.0) or 1.0)),
            'needed_mem': required_mem_mb / (max(1.0, float(fallback_prof.get('mem_gb', 0.0) or 1.0)) * 1024.0),
            'avail_mpc': avail_mpc,
            'required_mpc': required_mpc,
            'raw_best_nodes': 0.0,
            'fat_cap_applied': False,
        }

    try:
        parts_states_by_scratch = zslurm_shared.slurm_partition_state_counts_by_scratch(60)
    except Exception:
        parts_states_by_scratch = {}

    best_part = None
    best_use_scratch = need_ssd
    best_idle = 0
    best_score = -1e18

    def safe_float(x, default=0.0):
        try:
            return float(x)
        except Exception:
            return default

    for pref_rank, (part, scratch) in enumerate(status.autogrow_prefer_partitions):
        prof = status.node_profiles.get(part) or {}
        if not prof:
            continue

        # Real idle-node availability for this (partition, scratch) class, straight
        # from `scontrol show nodes`. An engine sbatched onto a class with zero idle
        # nodes just parks PENDING forever -- this term used to be hard-wired to 1
        # (#FIXME), which is exactly why full genoa-scratch kept getting picked while
        # rome and plain genoa sat idle. Availability is now the dominant factor.
        pinfo = parts_states_by_scratch.get(part, {}) or {}
        grp = pinfo.get('scratch' if scratch else 'no_scratch', {}) or {}
        idle = int((grp.get('states', {}) or {}).get('IDLE', 0))

        ncores = safe_float(prof.get('cores', 0.0), 0.0)
        nmem_mb = safe_float(prof.get('mem_gb', 0.0), 0.0) * 1024.0
        prof_mpc = (nmem_mb / 1024.0) / max(1.0, ncores)
        is_fat = str(part) in fat_partitions

        sc = 0.0

        # (1) Availability dominates: only grow where a node can actually start now.
        if idle <= 0:
            sc -= 100.0
        else:
            sc += float(min(idle, 4)) * 6.0   # saturates once a few nodes are free

        # (2) SSD preference: scratch-node nodes are equal-cost and strictly more
        #     capable (any rule runs there; ssd_use=required rules run ONLY there),
        #     so ALWAYS prefer scratch. Plain is a last resort -- penalised enough to
        #     lose to any scratch class that still has idle nodes, but not enough to
        #     beat the idle<=0 disqualifier, so when NO scratch is idle we still fall
        #     back to plain (subject to the caller's non-SSD moderation cap).
        if scratch:
            sc += 20.0
        else:
            sc -= 20.0

        # (3) Memory-per-core adequacy. Under memory pressure reward how well a
        #     profile's mem/core COVERS the residual demand: a profile that fully
        #     covers req_mpc scores highest, thin nodes that barely cover score low,
        #     so fat wins as pressure rises (and the fattest available wins when even
        #     fat can't fully cover, i.e. himem territory) -- without overpaying for
        #     fat under only-mild pressure. With no pressure, avoid pricier fat nodes.
        if need_fat:
            coverage = min(prof_mpc / max(req_mpc, 1e-6), 1.0)
            sc += 18.0 * coverage
        else:
            if is_fat:
                sc -= 8.0

        # (4) Cheaper / earlier-preferred partitions as a mild tie-breaker.
        sc -= float(pref_rank) * 0.5

        if sc > best_score:
            best_score = sc
            best_part = part
            best_use_scratch = bool(scratch)
            best_idle = idle

    if best_part is None:
        best_part = fallback_part or status.default_partition
        best_use_scratch = need_ssd
        best_idle = 0

    # SSD-preference moderation: plain (non-scratch) growth is a last resort. Even
    # when no scratch is idle, cap plain engines at autogrow_max_nonssd_fraction of
    # the fleet, so a transient scratch shortage cannot drift us onto a mostly-plain
    # cluster. Scratch growth is never capped here (equal cost, always preferred).
    if best_part is not None and not best_use_scratch:
        max_nonssd_frac = float(status.config.get(
            "autogrow_max_nonssd_fraction",
            getattr(status, 'autogrow_max_nonssd_fraction', 0.5)))
        part_engines_all = [e for e in all_engines if e.partition == partition]
        n_part = len(part_engines_all)
        n_nonssd = sum(1 for e in part_engines_all if not getattr(e, 'has_ssd', False))
        if n_part > 0 and (n_nonssd + 1) > max_nonssd_frac * (n_part + 1):
            return {
                'has_eligible': len(eligible) > 0,
                'eligible_n': len(eligible),
                'plan_part': None,
                'plan_nodes': 0.0,
                'plan_use_scratch': False,
                'plan_need_ssd': need_ssd,
                'needed_cpu': required_cpu / max(1.0, float(fallback_prof.get('cores', 0.0) or 1.0)),
                'needed_mem': required_mem_mb / (max(1.0, float(fallback_prof.get('mem_gb', 0.0) or 1.0)) * 1024.0),
                'avail_mpc': avail_mpc,
                'required_mpc': required_mpc,
                'raw_best_nodes': 0.0,
                'fat_cap_applied': False,
                'plan_reason': 'ssd-preferred: non-SSD engine cap reached, waiting for scratch capacity',
            }

    # Some sites only schedule whole-node pilots and should wait for a currently
    # idle node.  Spider pilots are partial allocations, however: they can
    # backfill on MIXED nodes and Slurm (not zslurm) should decide when they run.
    if best_idle <= 0 and bool(
            getattr(status, 'autogrow_require_idle_nodes', True)):
        return {
            'has_eligible': len(eligible) > 0,
            'eligible_n': len(eligible),
            'plan_part': None,
            'plan_nodes': 0.0,
            'plan_use_scratch': need_ssd,
            'plan_need_ssd': need_ssd,
            'needed_cpu': required_cpu / max(1.0, float(fallback_prof.get('cores', 0.0) or 1.0)),
            'needed_mem': required_mem_mb / (max(1.0, float(fallback_prof.get('mem_gb', 0.0) or 1.0)) * 1024.0),
            'avail_mpc': avail_mpc,
            'required_mpc': required_mpc,
            'raw_best_nodes': 0.0,
            'fat_cap_applied': False,
            'plan_reason': 'no idle nodes in any preferred partition',
        }

    prof = status.node_profiles.get(best_part) or {}
    # When growing scratch, size for the larger of the general residual and the
    # SSD-only residual, so stuck ssd_use=required work actually pulls in scratch
    # nodes even while plain free cores cover the general backlog.
    size_cpu = max(required_cpu, ssd_required_cpu) if best_use_scratch else required_cpu
    size_mem_mb = max(required_mem_mb, ssd_required_mem_mb) if best_use_scratch else required_mem_mb
    try:
        nodes_cpu = max(0.0, size_cpu / float(max(1.0, float(prof.get('cores', 0.0)))))
    except Exception:
        nodes_cpu = 0.0
    try:
        nodes_mem = max(0.0, size_mem_mb / (float(max(1.0, float(prof.get('mem_gb', 0.0)))) * 1024.0))
    except Exception:
        nodes_mem = 0.0

    raw_best_nodes = int(math.ceil(max(nodes_cpu, nodes_mem))) if (size_cpu > 0.0 or size_mem_mb > 0.0) else 0
    best_nodes = raw_best_nodes

    if best_nodes > 1 and str(best_part) not in getattr(status, 'autogrow_fat_partitions', []):
        best_nodes = max(int(math.ceil(0.2 * best_nodes)), 1)

    fat_cap_applied = False
    if str(best_part) in getattr(status, 'autogrow_fat_partitions', []) and best_nodes > 1:
        best_nodes = 1
        fat_cap_applied = True

    requested_engine_cores = _autogrow_requested_engine_cores(
        eligible, best_part, size_cpu, size_mem_mb, raw_best_nodes
    )

    plan = {
        'has_eligible': len(eligible) > 0,
        'eligible_n': len(eligible),

        'plan_part': best_part,
        'plan_use_scratch': best_use_scratch,
        'plan_need_ssd': need_ssd,
        'plan_nodes': best_nodes,
        'best_part': best_part,
        'best_nodes': best_nodes,
        'engine_cores': requested_engine_cores,

        'needed_cpu': nodes_cpu,
        'needed_mem': nodes_mem,
        
        'avail_mpc': avail_mpc,
        'required_mpc': required_mpc,
        'raw_best_nodes': raw_best_nodes,
        'fat_cap_applied': fat_cap_applied,
        'plan_reason': (
            'submitted to Slurm queue despite zero fully idle nodes'
            if best_idle <= 0 else None
        ),
    }
    
    return plan

def engine_drain_seconds(engine, now=None):
    """Seconds until this engine runs empty if we assign it no further work.

    That is the max remaining reqtime over the jobs running on it, which is what
    phasing the engine out actually costs: a phased-out engine keeps its node
    allocated (and billed) until its last job ends while accepting no new work.
    So a SHORT drain is cheap to phase out and a long one is not -- and an engine
    holding a long job cannot have that capacity reclaimed by phasing it out
    anyway, since the job runs to completion either way.

    Returns 0.0 for an idle engine, which is exactly the "free to drop" case.
    Falls back to the job's full reqtime when starttime is missing, so a job we
    cannot age yet is treated as just-started rather than as finished.
    """
    now = time.time() if now is None else now
    worst = 0.0
    for job in list(getattr(engine, 'jobs', ()) or ()):
        try:
            reqtime = float(getattr(job, 'reqtime', 0.0) or 0.0)
        except Exception:
            continue
        started = getattr(job, 'starttime', None)
        elapsed = max(0.0, now - float(started)) if started else 0.0
        worst = max(worst, max(0.0, reqtime - elapsed))
    return worst


def phaseout_backfill_window(engine, now=None):
    """Runtime a PHASING_OUT engine may still hand out, or 0.0 to hand out none.

    A phased-out engine holds its node until its last job ends. When that job still
    has hours to run, the rest of the node sits idle for those hours. We can fill
    that gap, but only with work certain to finish first, so the engine still stops
    at about the moment it would have stopped anyway -- delaying the phase-out would
    defeat the point of it.

    Conservative by construction: it returns 0.0, i.e. the old flat refusal, unless
    all of the following hold.

      * backfilling is enabled;
      * the engine is NOT draining because its node walltime is nearly up -- that
        one is already racing a hard kill and must not be handed more to lose;
      * the engine still has running work, because letting an empty one die is
        exactly what phasing out is for;
      * at least `min_window` seconds remain after subtracting the margin, so we
        only bother when the reclaimed gap is worth a job's startup cost.

    The margin is subtracted twice over: once from the drain estimate and once from
    the node walltime, and callers still apply job_walltime_buffer_sec on top.
    """
    if not bool(status.config.get(
            "phaseout_backfill_enable",
            getattr(status, 'phaseout_backfill_enable', True))):
        return 0.0
    if getattr(engine, 'end_of_life_drain', False):
        return 0.0
    if getattr(engine, 'stopping', False):
        return 0.0
    if not (getattr(engine, 'jobs', None) or ()):
        return 0.0
    margin = float(status.config.get(
        "phaseout_backfill_margin_sec",
        getattr(status, 'phaseout_backfill_margin_sec', 1800.0)))
    min_window = float(status.config.get(
        "phaseout_backfill_min_window_sec",
        getattr(status, 'phaseout_backfill_min_window_sec', 3600.0)))
    window = engine_drain_seconds(engine, now) - margin
    if window < min_window:
        return 0.0
    node_left = float(getattr(engine, 'timeleft', 0.0) or 0.0) - margin
    return max(0.0, min(window, node_left))


def thread_check_commands():
    
    autogrow_last_plan_ts = 0.0
    autoconsolidate_last_plan_ts = 0.0

    

    while 1:
        if _handover_committed_source():
            # Ownership has moved. Keep only the RPC forwarding shell alive;
            # timeout/consolidation/autogrow actions here could otherwise
            # cancel allocations that are already managed by the target.
            time.sleep(5)
            continue
        engines.lock.acquire()
        try:
            engines._check_cluster_engines()
            all_engines = list(engines.engine_by_id.values())
        finally:
            engines.lock.release()

        now = time.time()
        for engine in all_engines:
            if now - engine.lastseen > TIMEOUT:
                # Attempt to kill SLURM allocation for this engine first without unregistering yet
                cid = engine.cluster_id
                # mark as stopping to avoid further assignments/starts and reconciliation
                engine.stopping = True
                try:
                    if cid is False:
                        # Local engine
                        engines.stop_local(gb)
                    elif cid is not None:
                        engines.cancel_cid(cid, unregister_after=False)
                except Exception as ex:
                    import traceback
                    add_log_line(gb, f"Exception when terminating engine {engine.engine_id} (cid={cid}): {ex}", RED)
                    add_log_line(gb, traceback.format_exc(), RED)
                # Wait briefly for the SLURM job to actually disappear
                try:
                    engines._wait_for_cid_termination(cid, timeout_seconds=60, poll_interval=2)
                except Exception as ex:
                    import traceback
                    add_log_line(gb, f"Exception while waiting for SLURM job {cid} to disappear: {ex}", YELLOW)
                    add_log_line(gb, traceback.format_exc(), YELLOW)
                # Now unregister and requeue jobs
                engines._unregister(engine, "Engine timed out")
                add_log_line(
                    gb, "Engine with id " + engine.engine_id + " timed out", RED
                )

        used_cpus = []
        used_mem = []
        used_load = []
        total_cpus = []
        total_mem = []
        sys_busy = []
        sys_iow = []
        gpfs_io_pct = []
        ssd_used = []
        ssd_total = []
        for engine in all_engines:
            if not engine.partition == "archive":
                total_cpus.append(engine.cores)
                total_mem.append(engine.totmem / 1024.0)

                used_cpus.append(engine.cores * (engine.cpu_usage / 100.0))
                used_mem.append((engine.totmem / 1024.0) * (engine.mem_usage / 100.0))
                used_load.append(engine.cores * engine.load)
                sys_busy.append(engine.sys_cpu_busy)
                sys_iow.append(engine.sys_iowait)
                if bool(getattr(engine, 'gpfs_io_available', False)):
                    gpfs_io_pct.append(float(getattr(
                        engine, 'gpfs_io_pct', 0.0)))
                if getattr(engine, 'has_ssd', False) and getattr(engine, 'ssd_total_gb', 0.0) > 0.0:
                    ssd_total.append(float(getattr(engine, 'ssd_total_gb', 0.0)))
                    ssd_used.append(float(getattr(engine, 'ssd_used_gb', 0.0)))
        status.total_ssd = numpy.array(ssd_total, dtype=float)
        status.used_ssd = numpy.array(ssd_used, dtype=float)
        status.ssd_total_gb = float(status.total_ssd.sum()) if status.total_ssd.size else 0.0
        status.ssd_used_gb = float(status.used_ssd.sum()) if status.used_ssd.size else 0.0

        status.used_cpus = numpy.array(used_cpus)
        status.used_load = numpy.array(used_load)
        status.total_cpus = numpy.array(total_cpus, dtype=float)
        status.used_mem = numpy.array(used_mem, dtype=float)
        status.total_mem = numpy.array(total_mem, dtype=float)
        status.sys_cpu_busy = numpy.array(sys_busy, dtype=float)
        status.sys_iowait = numpy.array(sys_iow, dtype=float)
        status.gpfs_io_pct = numpy.array(gpfs_io_pct, dtype=float)

        # End-of-life drain: an engine near its Slurm walltime will be hard-killed,
        # taking any running job with it. Phase it out early (it then accepts NO new
        # jobs -- request_jobs returns [] for PHASING_OUT -- and stops once idle) so
        # work drains gracefully and autogrow replaces the capacity. Runs before
        # consolidation so the drain flag is set before the unphase logic below.
        try:
            if bool(getattr(status, 'engine_drain_before_end_enable', True)):
                drain_before = float(status.config.get('engine_drain_before_end_sec',
                                                        getattr(status, 'engine_drain_before_end_sec', 12 * 3600.0)))
                for e in all_engines:
                    if getattr(e, 'partition', '') == 'archive' or getattr(e, 'stopping', False):
                        continue
                    try:
                        tl = float(getattr(e, 'timeleft', 5 * 24 * 3600))
                    except Exception:
                        tl = 5 * 24 * 3600
                    if 0 < tl < drain_before and e.status != PHASING_OUT:
                        e.status = PHASING_OUT
                        e.end_of_life_drain = True
                        add_log_line(gb, f"End-of-life drain: engine {e.engine_id} has {int(tl)}s walltime left (< {int(drain_before)}s); phasing out.", YELLOW)
        except Exception:
            import traceback
            traceback.print_exc()

        now = time.time()
        try:
            safety_fraction = float(status.config.get("consolidation_safety_fraction", status.consolidation_safety_fraction))
            min_engines = int(status.config.get("consolidation_min_engines", status.consolidation_min_engines))
            hysteresis_sec = float(status.config.get("consolidation_hysteresis_sec", status.consolidation_hysteresis_sec))
            cooldown_sec = float(status.config.get("consolidation_cooldown_sec", status.consolidation_cooldown_sec))
            min_runtime_sec = float(status.config.get("consolidation_min_runtime_sec", status.consolidation_min_runtime_sec))
            allow_with_queue = bool(status.config.get("consolidation_allow_with_queue", status.consolidation_allow_with_queue))
            pending_min_age_sec = float(status.config.get("consolidation_pending_min_age_sec", status.consolidation_pending_min_age_sec))
            dbg_consolidation = bool(status.config.get("consolidation_debug", status.consolidation_debug))
            keep_weights = dict(status.config.get("consolidation_keep_weights", status.consolidation_keep_weights))

            if status.autoconsolidate_enable and now - autoconsolidate_last_plan_ts > 60:
                autoconsolidate_last_plan_ts = now

                parts = set(e.partition for e in all_engines)
                for part in parts:
                    part_engines = [e for e in all_engines if e.partition == part]
                    if not part_engines:
                        continue

                    # Determine max capacity of any engine in this partition
                    try:
                        cap_cpu_max = max(int(getattr(e, 'cores', 0)) for e in part_engines)
                        cap_mem_mb_max = max(float(getattr(e, 'totmem', 0.0)) for e in part_engines)
                    except Exception:
                        cap_cpu_max = 0
                        cap_mem_mb_max = 0.0

                    pending_eligible = []
                    download_available = max(
                        0.0,
                        jobs.dcache_download_total - jobs.dcache_download_inuse,
                    )
                    upload_available = max(
                        0.0,
                        jobs.dcache_upload_total - jobs.dcache_upload_inuse,
                    )
                    s3_download_available = max(
                        0.0,
                        jobs.s3_download_total - jobs.s3_download_inuse,
                    )
                    for j in list(jobs.jobs_by_id.values()):
                        if (
                            j.partition == part
                            and j.state in queue_states
                            and jobs.dependency_status(j)["state"] == DEPENDENCY_SATISFIED
                            and float(j.ncpu) <= float(cap_cpu_max)
                            and float(j.mem) <= float(cap_mem_mb_max)
                            and (
                                part == 'archive'
                                or not hasattr(j, 'submit_ts')
                                or (now - float(getattr(j, 'submit_ts', now)) >= pending_min_age_sec)
                            )
                            and ((jobs.active_total >= (jobs.active_inuse + j.active_start_use_add)) or j.active_start_use_add == 0)
                            and ((jobs.dcache_total >= (jobs.dcache_inuse + j.dcache_start_use_add)) or j.dcache_start_use_add == 0)
                            and ((jobs.archive_total >= (jobs.archive_inuse + j.archive_start_use_add)) or j.archive_start_use_add == 0)
                            and jobs._dcache_transfer_fits_locked(
                                j, download_available, upload_available,
                                s3_download_available
                            )
                            and (
                                str(getattr(j, 'ssd_use', 'no') or 'no') != 'required'
                                or jobs._any_ssd_engine_available(getattr(j, 'ssd_gb', 0.0))
                            )
                        ):
                            pending_eligible.append(j)
                            download_need, upload_need = jobs._dcache_slot_needs(j)
                            download_available -= download_need
                            upload_available -= upload_need
                            s3_download_available -= jobs._s3_download_slot_need(j)
                      
                    if pending_eligible and part == 'archive':
                        # archive/staging stays FIFO and is grown on demand, not
                        # consolidated while it still has runnable queued jobs.
                        # Do NOT reset cooldown; clear hysteresis and unphase any prior
                        # targets so engines are usable.
                        status.consolidation_want[part] = None
                        unphased = []
                        for e in part_engines:
                            if e.status == PHASING_OUT and not getattr(e, 'end_of_life_drain', False):
                                e.status = ""
                                unphased.append(e.engine_id)
                        if dbg_consolidation:
                            try:
                                add_log_line(gb, f"[cons] part={part} skip consolidation due to {len(pending_eligible)} eligible queued job(s); unphased={len(unphased)}", CYAN)
                            except Exception:
                                pass
                        continue

                    running_jobs = [
                        j for j in list(jobs.jobs_by_id.values())
                        if j.partition == part and j.state == "RUNNING"
                    ]

                    # Size the engines to KEEP for RUNNING work PLUS the eligible pending
                    # backlog that could start right now. Sizing to running-only phased
                    # out perfectly usable engines while jobs waited -- the exact
                    # "phasing out while there is runnable work" bug that had to be undone
                    # by hand. Budget-blocked / oversized / too-young pending jobs are
                    # already excluded from pending_eligible above, so genuinely idle
                    # excess (no runnable queue) still consolidates as before.
                    demand_jobs = running_jobs + pending_eligible
                    demand_resources = [
                        _consolidation_job_resources(j) for j in demand_jobs
                    ]
                    total_req_cpu = sum(cpu for cpu, _mem in demand_resources)
                    total_req_mem_mb = sum(
                        mem_mb for _cpu, mem_mb in demand_resources
                    )
                    needed_cpu = max(0, int(math.ceil(total_req_cpu * safety_fraction)))
                    needed_mem_mb = max(0, int(math.ceil(total_req_mem_mb * safety_fraction)))

                    drain_horizon = max(1.0, float(status.config.get(
                        "consolidation_drain_horizon_sec",
                        getattr(status, 'consolidation_drain_horizon_sec', 6 * 3600.0))))
                    drain_by_id = {e.engine_id: engine_drain_seconds(e, now) for e in part_engines}

                    def keep_score(e):
                        # Every term is 0..1 so the configured weights actually decide.
                        res_cpu_frac = float(getattr(e, 'res_cpu_reserved', 0.0)) / max(1.0, float(e.cores))
                        res_mem_frac = (float(getattr(e, 'res_mem_reserved_mb', 0.0)) / 1024.0) / max(1.0, float(e.totmem) / 1024.0)
                        # residual work: how long before this engine empties itself
                        drain_factor = min(1.0, drain_by_id.get(e.engine_id, 0.0) / drain_horizon)
                        # occupancy, per core rather than an unbounded count
                        jobs_factor = min(1.0, float(len(e.jobs)) / max(1.0, float(e.cores)))
                        tl = float(min(float(e.timeleft), 5 * 24 * 3600)) if hasattr(e, 'timeleft') else (5 * 24 * 3600.0)
                        time_factor = tl / float(5 * 24 * 3600)
                        w_drain = float(keep_weights.get('drain', 0.45))
                        w_jobs = float(keep_weights.get('jobs', 0.15))
                        w_res = float(keep_weights.get('reserves', 0.25))
                        w_time = float(keep_weights.get('time', 0.15))
                        alpha = float(keep_weights.get('reserves_alpha_cpu', 0.5))
                        return (w_drain * drain_factor
                                + w_jobs * jobs_factor
                                + w_res * (alpha * res_cpu_frac + (1.0 - alpha) * res_mem_frac)
                                + w_time * time_factor)

                    engines_sorted = sorted(part_engines, key=keep_score, reverse=True)

                    keep = []
                    acc_cpu = 0
                    acc_mem_mb = 0
                    for e in engines_sorted:
                        if acc_cpu >= needed_cpu and acc_mem_mb >= needed_mem_mb:
                            break
                        keep.append(e)
                        acc_cpu += int(e.cores)
                        acc_mem_mb += int(e.totmem)

                    if len(keep) < min_engines and part_engines:
                        need_more = min_engines - len(keep)
                        for e in engines_sorted[len(keep):len(keep)+need_more]:
                            keep.append(e)

                    keep_ids = set(e.engine_id for e in keep)
                    if dbg_consolidation:
                        try:
                            sum_keep_cpu = sum(int(e.cores) for e in keep)
                            sum_keep_mem_mb = sum(int(e.totmem) for e in keep)
                            add_log_line(gb, f"[cons] part={part} needed_cpu={needed_cpu} needed_mem_mb={int(needed_mem_mb)} keep={len(keep)}/{len(part_engines)} keep_cpu={sum_keep_cpu} keep_mem_mb={int(sum_keep_mem_mb)}", CYAN)
                            # Make the pick explainable: drain = minutes until empty.
                            dropped = [e for e in part_engines if e.engine_id not in keep_ids]
                            if dropped:
                                detail = ", ".join(
                                    f"{e.engine_id}:{int(drain_by_id.get(e.engine_id, 0.0) / 60)}m"
                                    for e in sorted(dropped, key=lambda x: drain_by_id.get(x.engine_id, 0.0)))
                                add_log_line(gb, f"[cons] part={part} phasing out (drain to empty): {detail}", CYAN)
                            overrun = [e for e in part_engines
                                       if drain_by_id.get(e.engine_id, 0.0) > float(getattr(e, 'timeleft', 0) or 0)]
                            if overrun:
                                add_log_line(gb, f"[cons] part={part} WARNING: {len(overrun)} engine(s) hold jobs whose reqtime outlasts the node walltime; those will be killed at the wall: " + ", ".join(e.engine_id for e in overrun), YELLOW)
                        except Exception:
                            pass

                    unphase_changed = False
                    for e in part_engines:
                        if e.engine_id in keep_ids and e.status == PHASING_OUT and not getattr(e, 'end_of_life_drain', False):
                            e.status = ""
                            unphase_changed = True

                    needs_phaseout = len(keep) < len(part_engines)
                    want_ts = status.consolidation_want.get(part)
                    last_action_ts_by_part = getattr(status, 'consolidation_last_action_ts_by_part', {}) or {}
                    last_action_ts = float(last_action_ts_by_part.get(part, 0.0))
                    phase_changed = False
                    if needs_phaseout and (now - last_action_ts) >= cooldown_sec:
                        if want_ts is None:
                            status.consolidation_want[part] = now
                            if dbg_consolidation:
                                try:
                                    add_log_line(gb, f"[cons] part={part} start hysteresis window ({int(hysteresis_sec)}s)", CYAN)
                                except Exception:
                                    pass
                        elif (now - want_ts) >= hysteresis_sec:
                            for e in part_engines:
                                if e.engine_id not in keep_ids:
                                    if (now - float(e.starttime)) >= min_runtime_sec:
                                        if e.status != PHASING_OUT:
                                            e.status = PHASING_OUT
                                            phase_changed = True                            
                                
                            if unphase_changed or phase_changed:
                                # update per-part cooldown timestamp
                                last_action_ts_by_part[part] = now
                                status.consolidation_last_action_ts_by_part = dict(last_action_ts_by_part)
                    else:
                        if not needs_phaseout:
                            status.consolidation_want[part] = None                            

        except Exception:
            import traceback
            traceback.print_exc()
        # Autogrow controller
        try:
            now = time.time()            
            if autogrow_last_plan_ts < now - 60.0 and status.autogrow_enable:
                autogrow_last_plan_ts = now
                
                plan = compute_autogrow_plan(all_engines, "compute")
                status.autogrow_plan_detail = dict(plan)
                cooldown_remaining_compute = max(0.0, float(status.autogrow_cooldown_sec) - (now - float(status.autogrow_last_action_compute_ts)))
                
                if plan.get('best_nodes', 0) > 0:
                    plan_compute = (
                        f"grow: {plan.get('best_nodes', 0)} @ "
                        f"{plan.get('best_part', 'compute')} "
                        f"({plan.get('engine_cores', 0) or 'exclusive'} cores), "
                        f"cooldown {int(cooldown_remaining_compute)}s left"
                    )
                else:
                    plan_compute = str(plan.get('plan_reason') or "no nodes needed")

                if cooldown_remaining_compute <= 0: # Autogrow cooldown expired, lets see if we need to start some engines
                    if plan.get('best_part',None) is not None:
                        to_start = int(plan.get('best_nodes', 0) or 0)
                        if to_start > 0:
                            try:
                                max_compute_nodes = int(status.config.get('autogrow_max_compute_nodes', 40))
                            except Exception:
                                max_compute_nodes = 40
                            current_compute = int(getattr(engines, 'cluster_running_engines', 0)) + int(getattr(engines, 'cluster_queued_engines', 0))
                            cap_remaining = max(0, int(max_compute_nodes) - int(current_compute))
                            clamped = False
                            if to_start > cap_remaining:
                                to_start = cap_remaining
                                clamped = True
                            if to_start > 0:
                                msg = f"Autogrow: starting {to_start} node(s) on {plan.get('best_part')}"
                                if clamped:
                                    msg += f" (cap {current_compute}+{to_start} <= {max_compute_nodes})"
                                add_log_line(
                                    gb,
                                    msg,
                                    CYAN,
                                )
                                ssd_feature_name = getattr(status, 'ssd_feature_name', '')
                                # Only pin the scratch-node constraint when a pending job
                                # actually requires SSD; otherwise let the engine land on
                                # any node in the (much larger) plain pool.
                                # Prefer scratch-node for ANY growth the planner placed on a
                                # scratch class (plan_use_scratch), not only when a job
                                # hard-requires SSD -- scratch is equal-cost and preferred.
                                constraint = ssd_feature_name if (ssd_feature_name and bool(plan.get('plan_use_scratch', False))) else None
                                started = engines.start_slurm(
                                    gb,
                                    to_start,
                                    status.autogrow_runtime_default,
                                    plan.get('best_part'),
                                    constraint,
                                    int(plan.get(
                                        'engine_cores',
                                        getattr(status, 'autogrow_engine_cores', 0),
                                    ) or 0),
                                )
                                status.autogrow_last_action_compute_ts = now
                                if started:
                                    plan_compute = f"grew: {len(started)} @ {plan.get('best_part', 'compute')}"
                                else:
                                    plan_compute = "growth deferred (maintenance window or submission failure)"

                staging_pending = 0
                try:
                    archive_job_partitions = set(getattr(status, 'archive_job_partitions', ['archive', getattr(status, 'staging_partition', 'staging')]))
                    for job in list(jobs.jobs_by_id.values()):
                        part = str(getattr(job, 'partition', '') or '')
                        if part in archive_job_partitions and getattr(job, 'state', '') in queue_states:
                            staging_pending += 1
                except Exception:
                    staging_pending = 0

                desired_staging = 0
                staging_burst_threshold = max(1, int(getattr(status, 'staging_autogrow_burst_threshold', 50)))
                staging_base_nodes = max(0, int(getattr(status, 'staging_autogrow_base_nodes', 1)))
                staging_burst_nodes = max(staging_base_nodes, int(getattr(status, 'staging_autogrow_burst_nodes', 4)))
                if staging_pending >= staging_burst_threshold:
                    desired_staging = staging_burst_nodes
                elif staging_pending > 0:
                    desired_staging = staging_base_nodes
                
                queued_map = getattr(engines, 'cluster_queued_by_partition', {}) or {}
                running_map = getattr(engines, 'cluster_running_by_partition', {}) or {}
                staging_partition = getattr(status, 'staging_partition', 'staging')
                current_staging = int(queued_map.get(staging_partition, 0)) + int(running_map.get(staging_partition, 0))

                cooldown_remaining_staging = max(0.0, float(status.autogrow_cooldown_sec) - (now - float(status.autogrow_last_action_staging_ts)))

                if desired_staging > current_staging:
                    plan_staging = f"grow {desired_staging  - current_staging}, cooldown {int(cooldown_remaining_staging)}s left"
                else:
                    plan_staging = f"no nodes needed"
                
                
                if cooldown_remaining_staging <= 0:    
                    if desired_staging > 0:
                        if desired_staging > current_staging:
                            to_start_staging = min(desired_staging - current_staging, staging_burst_nodes - current_staging)
                            if to_start_staging > 0:
                                add_log_line(
                                    gb,
                                    f"Staging autogrow: {staging_pending} archive jobs pending, starting 1 of {to_start_staging} nodes.",
                                    CYAN,
                                )
                                started = engines.start_slurm(gb, 1, status.autogrow_runtime_default, staging_partition, None, 1)
                                status.autogrow_last_action_staging_ts = now
                                plan_staging = "grew: 1" if started else "growth deferred (maintenance window or submission failure)"


                status.autogrow_plan =f"Compute: {plan_compute} | Staging: {plan_staging}"              

        except Exception:
            import traceback
            traceback.print_exc()            

        time.sleep(5)


def thread_start_manager_server(port, rpc_path):
    request_handeler=SimpleXMLRPCRequestHandler
    request_handeler.rpc_paths=(f"/{rpc_path}",)
    server=ReuseAddrXMLRPCServer(
        ("", int(port)),
        logRequests=False,
        allow_none=True,
        requestHandler=request_handeler)
    server.register_introspection_functions()

    server.register_function(register, "register")
    server.register_function(failed_node, "failed_node")
