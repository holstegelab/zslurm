#!/usr/bin/env python
"""Inspect or set the dynamic zslurm lease inherited by this job."""

import argparse
import json
import sys

import zslurm_lease as lease


def _parser():
    parser = argparse.ArgumentParser(
        prog="zslurm_lease",
        description=(
            "Inspect or set this running job's local zslurm CPU/memory lease. "
            "Targets are absolute and cannot exceed the original job request."
        ),
    )
    parser.add_argument(
        "--json", action="store_true", help="print the complete JSON response"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("status", help="show the current and maximum lease")

    set_parser = subparsers.add_parser(
        "set",
        help="set an absolute lease target, waiting when the target grows",
    )
    set_parser.add_argument("--cores", type=float, help="target held CPU cores")
    memory = set_parser.add_mutually_exclusive_group()
    memory.add_argument("--mem-mb", type=float, help="target held memory in MB")
    memory.add_argument("--mem-gb", type=float, help="target held memory in GiB")
    set_parser.add_argument(
        "--wait",
        type=float,
        default=3600.0,
        metavar="SECONDS",
        help="maximum time to wait for growth (default: 3600)",
    )
    return parser


def _print_human(response):
    if response.get("ok"):
        print(
            "{status}: {held_cores:g}/{max_cores:g} cores, "
            "{held_mem_mb:g}/{max_mem_mb:g} MB "
            "(epoch {epoch})".format(**response)
        )
        safety = response.get("safety") or {}
        if safety.get("adjusted"):
            print(
                "safety floor applied: "
                f"{safety.get('cpu_floor', 0):g} cores, "
                f"{safety.get('memory_floor_mb', 0):g} MB memory "
                f"(observed {safety.get('observed_memory_mb', 0):g} MB)",
                file=sys.stderr,
            )
    else:
        print(
            f"{response.get('status', 'error')}: "
            f"{response.get('message', 'lease request failed')}",
            file=sys.stderr,
        )


def main(argv=None):
    parser = _parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "status":
            response = lease.request_from_environment(
                "status", socket_timeout_s=10.0
            )
        else:
            mem_mb = args.mem_mb
            if args.mem_gb is not None:
                mem_mb = args.mem_gb * 1024.0
            if args.cores is None and mem_mb is None:
                parser.error("set requires --cores, --mem-mb, or --mem-gb")
            # The socket must remain open for slightly longer than the requested
            # chief-side wait so the final grant/timeout response can arrive.
            response = lease.request_from_environment(
                "set",
                socket_timeout_s=max(10.0, args.wait + 5.0),
                cores=args.cores,
                mem_mb=mem_mb,
                timeout_s=args.wait,
            )
    except Exception as exc:
        print(f"zslurm_lease: {exc}", file=sys.stderr)
        return 5

    if args.json:
        print(json.dumps(response, sort_keys=True))
    else:
        _print_human(response)
    return int(response.get("code", 0 if response.get("ok") else 5))


if __name__ == "__main__":
    sys.exit(main())
