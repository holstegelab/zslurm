#!/usr/bin/env bash
set -euo pipefail

# Keep an engine in the same installation as the submitting manager. This is
# portable across conda, venv and system installs and avoids embedding a
# cluster- or user-specific environment path in the shared repository.
launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# A relocated environment can provide its bin directory explicitly when the
# inherited Slurm PATH is not sufficient.
if [[ -n "${ZSLURM_ENGINE_ENV_BIN:-}" ]]; then
    export PATH="${ZSLURM_ENGINE_ENV_BIN}:${PATH}"
fi

if [[ -n "${ZSLURM_CHIEF_PATH:-}" ]]; then
    exec "${ZSLURM_CHIEF_PATH}" "$@"
elif [[ -x "${launcher_dir}/zslurm_chief" ]]; then
    exec "${launcher_dir}/zslurm_chief" "$@"
elif command -v zslurm_chief >/dev/null 2>&1; then
    exec zslurm_chief "$@"
fi

echo "slurm_to_zslurm: zslurm_chief is not installed next to the launcher or on PATH" >&2
exit 127
