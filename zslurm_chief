CGROUP_MEM_LIMIT_FILE = None
CGROUP_MEM_CURRENT_FILE = None
CGROUP_MEM_STAT_FILE = None
CGROUP_CPU_STAT_FILE = None
CGROUP_CPU_USAGE_FILE = None
CGROUP_CPUSET_FILE = None
CGROUP_V2 = False

def detect_cgroup_files():
    global CGROUP_MEM_LIMIT_FILE, CGROUP_MEM_CURRENT_FILE, CGROUP_MEM_STAT_FILE, CGROUP_CPU_STAT_FILE, CGROUP_CPU_USAGE_FILE, CGROUP_CPUSET_FILE, CGROUP_V2
    CGROUP_MEM_LIMIT_FILE = None
    CGROUP_MEM_CURRENT_FILE = None
    CGROUP_MEM_STAT_FILE = None
    CGROUP_CPU_STAT_FILE = None
    CGROUP_CPU_USAGE_FILE = None
    CGROUP_CPUSET_FILE = None
    CGROUP_V2 = False
    try:
        with open('/proc/self/cgroup','r') as f:
            lines = [l.strip() for l in f.readlines() if l.strip()]
    except Exception:
        return False
    controller_paths = {}
    for line in lines:
        parts = line.split(':')
        if len(parts) != 3:
            continue
        _, subsystems, path = parts
        if subsystems == '':
            controller_paths['v2'] = path
            continue
        for subsystem in subsystems.split(','):
            controller_paths[subsystem] = path
    v2_path = controller_paths.get('v2')
    if v2_path is not None:
        base = '/sys/fs/cgroup' + (v2_path if v2_path != '/' else '')
        limit = os.path.join(base, 'memory.max')
        current = os.path.join(base, 'memory.current')
        memory_stat = os.path.join(base, 'memory.stat')
        cpu_stat = os.path.join(base, 'cpu.stat')
        cpuset_candidates = [
            os.path.join(base, 'cpuset.cpus.effective'),
            os.path.join(base, 'cpuset.cpus'),
        ]
        if os.path.exists(limit) and os.path.exists(current):
            CGROUP_MEM_LIMIT_FILE = limit
            CGROUP_MEM_CURRENT_FILE = current
            if os.path.exists(memory_stat):
                CGROUP_MEM_STAT_FILE = memory_stat
        if os.path.exists(cpu_stat):
            CGROUP_CPU_STAT_FILE = cpu_stat
        for candidate in cpuset_candidates:
            if os.path.exists(candidate):
                CGROUP_CPUSET_FILE = candidate
                break
        if not (CGROUP_MEM_CURRENT_FILE is None and CGROUP_CPU_STAT_FILE is None):
            CGROUP_V2 = True
            return True
        return False
    found = False
    v1_mem_path = controller_paths.get('memory')
    if v1_mem_path is not None:
        base = '/sys/fs/cgroup/memory' + (v1_mem_path if v1_mem_path != '/' else '')
        limit = os.path.join(base, 'memory.limit_in_bytes')
        current = os.path.join(base, 'memory.usage_in_bytes')
        memory_stat = os.path.join(base, 'memory.stat')
        if os.path.exists(limit) and os.path.exists(current):
            CGROUP_MEM_LIMIT_FILE = limit
            CGROUP_MEM_CURRENT_FILE = current
            if os.path.exists(memory_stat):
                CGROUP_MEM_STAT_FILE = memory_stat
            found = True
    v1_cpuacct_path = controller_paths.get('cpuacct')
    if v1_cpuacct_path is not None:
        base = '/sys/fs/cgroup/cpuacct' + (v1_cpuacct_path if v1_cpuacct_path != '/' else '')
        usage = os.path.join(base, 'cpuacct.usage')
        if os.path.exists(usage):
            CGROUP_CPU_USAGE_FILE = usage
            found = True
    v1_cpuset_path = controller_paths.get('cpuset')
    if v1_cpuset_path is not None:
        base = '/sys/fs/cgroup/cpuset' + (v1_cpuset_path if v1_cpuset_path != '/' else '')
        candidate = os.path.join(base, 'cpuset.cpus')
        if os.path.exists(candidate):
            CGROUP_CPUSET_FILE = candidate
    return found


def get_cgroup_memory_current_bytes():
    try:
        if CGROUP_MEM_CURRENT_FILE is None:
            return None
        with open(CGROUP_MEM_CURRENT_FILE,'r') as f:
            current_s = f.read().strip()
        return max(0.0, float(current_s))
    except Exception:
        return None


def get_cgroup_memory_current_mb():
    current = get_cgroup_memory_current_bytes()
    return None if current is None else current / (1024.0 ** 2)


def get_cgroup_memory_stat():
    try:
        if CGROUP_MEM_STAT_FILE is None:
            return None
        with open(CGROUP_MEM_STAT_FILE, 'r') as f:
            return zslurm_shared.parse_cgroup_memory_stat(f)
    except Exception:
        return None


def get_cgroup_memory_without_page_cache_mb():
    """Return cgroup usage excluding file cache, but including shmem/kernel."""
    current = get_cgroup_memory_current_bytes()
    if current is None:
        return None
    effective = zslurm_shared.cgroup_memory_without_page_cache(
        current, get_cgroup_memory_stat()
    )
    return effective / (1024.0 ** 2)


def get_cgroup_memory_limit_mb():
    try:
        if CGROUP_MEM_LIMIT_FILE is None:
            return None
        with open(CGROUP_MEM_LIMIT_FILE,'r') as f:
            limit_s = f.read().strip()
        if CGROUP_V2 and limit_s == 'max':
            return None
        limit = float(limit_s)
        if limit > 1e15:
            return None
        return max(0.0, limit / (1024.0 ** 2))
    except Exception:
        return None


def parse_slurm_memory_mb(value):
    """Parse a Slurm memory value into MiB.

    Slurm's ``SLURM_MEM_PER_*`` variables normally contain an integer MiB
    value.  Accept unit suffixes too so the fallback remains useful with
    wrappers that preserve the submitted value.
    """
    if value is None:
        return None
    text = str(value).strip().upper()
    if not text or text in ('N/A', 'NONE', 'UNLIMITED'):
        return None
    if text.endswith('B') and len(text) > 1 and text[-2] in 'KMGTPE':
        text = text[:-1]
    factors = {
        'K': 1.0 / 1024.0,
        'M': 1.0,
        'G': 1024.0,
        'T': 1024.0 ** 2,
        'P': 1024.0 ** 3,
        'E': 1024.0 ** 4,
    }
    factor = 1.0
    if text and text[-1] in factors:
        factor = factors[text[-1]]
        text = text[:-1].strip()
    try:
        result = float(text) * factor
    except (TypeError, ValueError):
        return None
    if not math.isfinite(result) or result <= 0.0:
        return None
    return result


def get_slurm_memory_limit_mb(cpu_count, environ=None):
    """Return the memory granted to this Slurm allocation, when advertised."""
    env = os.environ if environ is None else environ
    per_node = parse_slurm_memory_mb(env.get('SLURM_MEM_PER_NODE'))
    if per_node is not None:
        return per_node
    per_cpu = parse_slurm_memory_mb(env.get('SLURM_MEM_PER_CPU'))
    if per_cpu is None:
        return None
    try:
        advertised_cpu = max(0.0, float(cpu_count))
    except (TypeError, ValueError):
        return None
    if not math.isfinite(advertised_cpu) or advertised_cpu <= 0.0:
        return None
    return per_cpu * advertised_cpu


def compute_engine_memory_capacity_mb(
    physical_memory_mb,
    explicit_memory_mb=None,
    cgroup_limit_mb=None,
    slurm_limit_mb=None,
    static_reserve_mb=100.0,
    headroom_fraction=0.08,
    cap_fraction=0.99,
):
    """Return (total, schedulable, hard_limit) memory for chief registration.

    Every finite allocation boundary is authoritative.  Applying headroom to
    their minimum prevents a chief from advertising physical node RAM that is
    outside its Slurm cgroup.
    """
    limits = []
    for value in (
        physical_memory_mb,
        explicit_memory_mb,
        cgroup_limit_mb,
        slurm_limit_mb,
    ):
        try:
            value = float(value)
        except (TypeError, ValueError):
            continue
        if math.isfinite(value) and value > 0.0:
            limits.append(value)
    if not limits:
        return 0.0, 0.0, 0.0

    hard_limit_mb = min(limits)
    try:
        static_reserve_mb = max(0.0, float(static_reserve_mb))
    except (TypeError, ValueError):
        static_reserve_mb = 0.0
    try:
        headroom_fraction = min(0.99, max(0.0, float(headroom_fraction)))
    except (TypeError, ValueError):
        headroom_fraction = 0.0
    try:
        cap_fraction = min(1.0, max(0.0, float(cap_fraction)))
    except (TypeError, ValueError):
        cap_fraction = 1.0

    total_mb = max(0.0, hard_limit_mb - static_reserve_mb)
    schedulable_mb = min(
        cap_fraction * hard_limit_mb,
        (1.0 - headroom_fraction) * total_mb,
    )
    return total_mb, max(0.0, schedulable_mb), hard_limit_mb


def get_cgroup_cpu_time_sec():
    try:
        if not CGROUP_CPU_STAT_FILE is None:
            with open(CGROUP_CPU_STAT_FILE,'r') as f:
                for line in f:
                    parts = line.strip().split()
                    if len(parts) == 2 and parts[0] == 'usage_usec':
                        return max(0.0, float(parts[1]) / 1_000_000.0)
            return None
        if not CGROUP_CPU_USAGE_FILE is None:
            with open(CGROUP_CPU_USAGE_FILE,'r') as f:
                return max(0.0, float(f.read().strip()) / 1_000_000_000.0)
        return None
    except Exception:
        return None


def get_cgroup_cpu_capacity():
    if CGROUP_CPUSET_FILE is None:
        return float(e_ncpu)
    try:
        with open(CGROUP_CPUSET_FILE,'r') as f:
            cpuset_spec = f.read().strip()
        if not cpuset_spec:
            return float(e_ncpu)
        count = 0
        for chunk in cpuset_spec.split(','):
            chunk = chunk.strip()
            if not chunk:
                continue
            if '-' in chunk:
                start_s, end_s = chunk.split('-', 1)
                start = int(start_s)
                end = int(end_s)
                if end >= start:
                    count += (end - start + 1)
            else:
                count += 1
        if count > 0:
            return float(min(float(count), e_ncpu))
    except Exception:
        pass
    return float(e_ncpu)

def get_cgroup_remaining_mb():
    try:
        limit_mb = get_cgroup_memory_limit_mb()
        current = get_cgroup_memory_current_bytes()
        if limit_mb is None or current is None:
            return None
        # File cache is reclaimable and must not reduce scheduler admission.
        # Shared memory remains charged via memory.stat's shmem subset.
        return zslurm_shared.cgroup_memory_available_without_page_cache(
            limit_mb * (1024.0 ** 2), current, get_cgroup_memory_stat()
        ) / (1024.0 ** 2)
    except Exception as ex:
        sys.stderr.write('cgroup memory read failed: ' + str(ex) + '\n')
        sys.stderr.write(traceback.format_exc())
        sys.stderr.flush()
        return None


def get_effective_available_mb():
    available_mb = psutil.virtual_memory().available / (1024.0 ** 2)
    if bool(config.get('mem_use_cgroup_available', True)) and not (CGROUP_MEM_LIMIT_FILE is None or CGROUP_MEM_CURRENT_FILE is None):
        cgroup_rem_mb = get_cgroup_remaining_mb()
        if not cgroup_rem_mb is None:
            available_mb = min(available_mb, cgroup_rem_mb)
    return max(0.0, float(available_mb))




def detect_scratch_path(cluster_jobid, environ=None, allow_tmpdir=False):
    """Return the local scratch root assigned to this pilot allocation.

    Snellius exposes a job-specific ``/scratch-node`` directory. Spider binds
    its node-local XFS volume to ``TMPDIR=/tmp`` inside each Slurm job. TMPDIR
    is therefore only accepted when a Slurm job identity is present; a login
    node's ordinary /tmp must never make an unmanaged engine advertise SSD.
    """
    env = os.environ if environ is None else environ
    candidates = []

    configured = env.get("ZSLURM_ENGINE_SCRATCH_DIR")
    if configured:
        candidates.append(str(configured))

    try:
        user = getpass.getuser()
    except Exception as ex:
        sys.stderr.write(f"{xtime()} - Failed to detect current user for scratch path: {ex}\n")
        sys.stderr.write(traceback.format_exc())
        sys.stderr.flush()
        return None

    job_id = env.get("SLURM_JOB_ID") or env.get("SLURM_JOBID")
    legacy_ids = []
    if job_id:
        legacy_ids.append(str(job_id))
    array_job_id = env.get("SLURM_ARRAY_JOB_ID")
    if array_job_id:
        legacy_ids.append(str(array_job_id))
        array_task_id = env.get("SLURM_ARRAY_TASK_ID")
        if array_task_id:
            legacy_ids.append(f"{array_job_id}_{array_task_id}")

    if cluster_jobid:
        cid = str(cluster_jobid)
        if cid:
            legacy_ids.append(cid)
            if "_" in cid:
                legacy_ids.append(cid.split("_", 1)[0])

    seen = set()
    for candidate in legacy_ids:
        if not candidate or candidate in seen:
            continue
        seen.add(candidate)
        if user:
            candidates.append(f"/scratch-node/{user}.{candidate}")

    slurm_tmp = env.get("SLURM_TMPDIR")
    if slurm_tmp:
        candidates.append(str(slurm_tmp))
    generic_tmp = env.get("TMPDIR")
    if allow_tmpdir and job_id and generic_tmp:
        candidates.append(str(generic_tmp))

    seen_paths = set()
    for path in candidates:
        path = os.path.realpath(os.path.expanduser(path))
        if path in seen_paths:
            continue
        seen_paths.add(path)
        try:
            if os.path.isdir(path) and os.access(path, os.W_OK):
                return path
        except Exception as ex:
            sys.stderr.write(f"{xtime()} - Scratch path probe failed for {path}: {ex}\n")
            sys.stderr.write(traceback.format_exc())
            sys.stderr.flush()

    return None


def configured_scratch_capacity_gb(settings, engine_cores):
    """Return an optional per-pilot SSD capacity cap in GiB."""
    fixed = float(settings.get("scratch_capacity_gb", 0.0) or 0.0)
    per_core = float(
        settings.get("scratch_capacity_gb_per_core", 0.0) or 0.0
    )
    limits = []
    if fixed > 0.0:
        limits.append(fixed)
    if per_core > 0.0 and float(engine_cores) > 0.0:
        limits.append(per_core * float(engine_cores))
    return min(limits) if limits else None


def read_scratch_usage(path, capacity_gb=None):
    """Return (schedulable GiB, unavailable GiB) for the scratch path."""
    if not path:
        return 0.0, 0.0
    try:
        usage = shutil.disk_usage(path)
        physical_total_gb = max(0.0, usage.total / (1024.0 ** 3))
        physical_free_gb = max(0.0, usage.free / (1024.0 ** 3))
        if capacity_gb is None:
            total_gb = physical_total_gb
        else:
            total_gb = min(physical_total_gb, max(0.0, float(capacity_gb)))
        # A partial Spider pilot must not advertise the entire shared 12-TiB
        # device. Within its cap, physical free space is still authoritative.
        available_gb = min(total_gb, physical_free_gb)
        used_gb = max(0.0, total_gb - available_gb)
        return total_gb, used_gb
    except Exception as ex:
        sys.stderr.write(f"{xtime()} - SSD usage read failed for {path}: {ex}\n")
        sys.stderr.write(traceback.format_exc())
        sys.stderr.flush()
        return 0.0, 0.0


def prepare_job_scratch(root, jobid):
    """Create and return a private scratch directory for one child job."""
    if not root:
        return None
    component = "".join(
        character if character.isalnum() or character in "._-" else "_"
        for character in str(jobid)
    )
    if not component:
        raise ValueError("empty ZSlurm job id cannot name scratch")
    jobs_root = os.path.join(os.path.realpath(root), ".zslurm", "jobs")
    os.makedirs(jobs_root, mode=0o700, exist_ok=True)
    os.chmod(jobs_root, 0o700)
    # Attempts can briefly overlap while the manager replaces a lost worker
    # process. A unique suffix prevents a new attempt from deleting scratch
    # that the previous process may still be using.
    path = tempfile.mkdtemp(prefix="job-" + component + "-", dir=jobs_root)
    os.chmod(path, 0o700)
    return path


def cleanup_job_scratch(root, path):
    """Remove one owned child directory, never the pilot or filesystem root."""
    if not root or not path:
        return
    jobs_root = os.path.realpath(
        os.path.join(os.path.realpath(root), ".zslurm", "jobs")
    )
    resolved = os.path.realpath(path)
    if os.path.dirname(resolved) != jobs_root or not os.path.basename(
        resolved
    ).startswith("job-"):
        raise RuntimeError("refusing unsafe scratch cleanup: " + str(path))
    shutil.rmtree(resolved, ignore_errors=True)


def configure_job_scratch_environment(env, root, jobid):
    """Assign one child directory and make all common temp APIs use it."""
    if not root:
        return None
    path = prepare_job_scratch(root, jobid)
    env["ZSLURM_SCRATCH_ROOT"] = os.path.realpath(root)
    env["ZSLURM_SCRATCH_DIR"] = path
    for name in ("TMPDIR", "TMP", "TEMP", "TEMPDIR"):
        env[name] = path
    return path


def parse_link_rate_bps(value):
    """Parse an RDMA sysfs link rate such as ``100 Gb/sec (2X HDR)``."""
    text = str(value or "").strip().split("(", 1)[0].strip()
    parts = text.split()
    if len(parts) < 2:
        return None
    try:
        number = float(parts[0])
    except (TypeError, ValueError):
        return None
    unit = parts[1].lower()
    factors = {
        "bit/sec": 1.0,
        "kbit/sec": 1e3,
        "mbit/sec": 1e6,
        "gbit/sec": 1e9,
        "tbit/sec": 1e12,
        "kb/sec": 1e3,
        "mb/sec": 1e6,
        "gb/sec": 1e9,
        "tb/sec": 1e12,
    }
    factor = factors.get(unit)
    if factor is None or not math.isfinite(number) or number <= 0.0:
        return None
    return number * factor


def gpfs_rdma_port_path(port_spec, sysfs_root="/sys/class/infiniband"):
    """Resolve ``DEVICE/PORT`` to its sysfs port directory."""
    text = str(port_spec or "").strip().strip("/")
    if text.count(":") == 1 and "/" not in text:
        text = text.replace(":", "/")
    parts = [part for part in text.split("/") if part]
    if len(parts) != 2 or not parts[1].isdigit():
        return None
    return os.path.join(sysfs_root, parts[0], "ports", parts[1])


def detect_gpfs_rdma_port(
        partition_name, config_obj=None,
        sysfs_root="/sys/class/infiniband"):
    """Find the readable active RDMA port used by GPFS on Snellius.

    Snellius currently configures compute/fat clients on ``mlx5_2/1`` and
    archive/server clients on ``mlx5_0/1``.  The setting remains overridable
    because device numbering is a site property rather than a ZSlurm contract.
    """
    cfg = config_obj or {}
    if cfg.get("gpfs_io_enable", True) is False:
        return None

    configured = cfg.get("gpfs_rdma_port")
    if isinstance(configured, (list, tuple)):
        candidates = list(configured)
    elif configured:
        candidates = [configured]
    elif str(partition_name or "").strip().lower() == "archive":
        candidates = ["mlx5_0/1", "mlx5_2/1"]
    else:
        candidates = ["mlx5_2/1", "mlx5_0/1"]

    for candidate in candidates:
        port_path = gpfs_rdma_port_path(candidate, sysfs_root=sysfs_root)
        if not port_path:
            continue
        state_path = os.path.join(port_path, "state")
        rate_path = os.path.join(port_path, "rate")
        receive_path = os.path.join(
            port_path, "counters", "port_rcv_data")
        transmit_path = os.path.join(
            port_path, "counters", "port_xmit_data")
        try:
            with open(state_path, "r") as handle:
                state = handle.read().strip()
            with open(rate_path, "r") as handle:
                rate_bps = parse_link_rate_bps(handle.read())
            if not state.startswith("4:") or rate_bps is None:
                continue
            with open(receive_path, "r") as handle:
                int(handle.read().strip())
            with open(transmit_path, "r") as handle:
                int(handle.read().strip())
            return port_path
        except (OSError, TypeError, ValueError):
            continue
    return None


class GpfsIoMonitor(object):
    """Measure GPFS RDMA receive/transmit throughput and link utilization."""

    def __init__(self, port_path, counter_unit_bytes=4.0, clock=None):
        self.port_path = port_path
        self.counter_unit_bytes = max(0.0, float(counter_unit_bytes))
        self.clock = clock or time.monotonic
        self.last_sample = None
        self.rate_bps = None
        if port_path:
            try:
                with open(os.path.join(port_path, "rate"), "r") as handle:
                    self.rate_bps = parse_link_rate_bps(handle.read())
            except OSError:
                self.rate_bps = None

    def _read(self):
        if not self.port_path or self.rate_bps is None:
            return None
        try:
            with open(os.path.join(
                    self.port_path, "counters", "port_rcv_data"), "r") as handle:
                received = int(handle.read().strip())
            with open(os.path.join(
                    self.port_path, "counters", "port_xmit_data"), "r") as handle:
                transmitted = int(handle.read().strip())
            return self.clock(), received, transmitted
        except (OSError, TypeError, ValueError):
            return None

    def sample(self):
        current = self._read()
        if current is None:
            return {
                "available": False,
                "rx_mib_s": 0.0,
                "tx_mib_s": 0.0,
                "io_pct": 0.0,
            }
        previous = self.last_sample
        self.last_sample = current
        if previous is None:
            return {
                "available": True,
                "rx_mib_s": 0.0,
                "tx_mib_s": 0.0,
                "io_pct": 0.0,
            }

        elapsed = current[0] - previous[0]
        received_delta = current[1] - previous[1]
        transmitted_delta = current[2] - previous[2]
        if elapsed <= 0.0 or received_delta < 0 or transmitted_delta < 0:
            return {
                "available": True,
                "rx_mib_s": 0.0,
                "tx_mib_s": 0.0,
                "io_pct": 0.0,
            }

        rx_bytes_s = received_delta * self.counter_unit_bytes / elapsed
        tx_bytes_s = transmitted_delta * self.counter_unit_bytes / elapsed
        capacity_bytes_s = self.rate_bps / 8.0
        io_pct = 100.0 * max(rx_bytes_s, tx_bytes_s) / capacity_bytes_s
        return {
            "available": True,
            "rx_mib_s": max(0.0, rx_bytes_s / (1024.0 ** 2)),
            "tx_mib_s": max(0.0, tx_bytes_s / (1024.0 ** 2)),
            "io_pct": min(100.0, max(0.0, io_pct)),
        }


