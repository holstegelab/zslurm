def current_instance_manager_uri(instance_name):
    config = zslurm_shared.get_instance_config(instance_name) or {}
    endpoint_host = (
        config.get('advertise_host') or config.get('bind_host'))
    endpoint_port = config.get('base_port')
    endpoint_path = config.get('rpcpath')
    if not endpoint_host or endpoint_port is None or not endpoint_path:
        return None
    return f"http://{endpoint_host}:{int(endpoint_port)}/{endpoint_path}"


def reconnect_to_instance(instance_name, manager_uri):
    """Reconnect when the logical instance now points at another manager."""
    redirected_uri = current_instance_manager_uri(instance_name)
    if not redirected_uri or redirected_uri == manager_uri:
        return None
    new_proxy, new_id = register_at_manager(redirected_uri)
    return new_proxy, new_id, redirected_uri


