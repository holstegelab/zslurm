def job_monitor(
    jobid, process, ncpu, mem, logfile, logfile_path,
    job_scratch_context=None,
):
    memcache = [] #stores memory usage at different snapshots over time
    cpucache = [] #stores cpu usage at different snapshots over time
    iocache = {} #stores latest known io counter info per process. Note that this is an estimate, when a child process stops this information disappears, so we might miss the last 30 seconds of io per child process.

    retcode = None
    resources = None
    lastcpureport = None
    spend_time = 0
    last_summary_io_total = None
    iodeltas = []
    monitor_initial_delay = float(config.get('monitor_initial_delay_sec', 0.0))
    monitor_interval = float(config.get('monitor_interval_sec', 600.0))
    live_monitor_interval = float(config.get('monitor_live_interval_sec', min(5.0, monitor_interval)))
    stuck_cpu_thr = float(config.get('stuck_cpu_core_threshold', 0.05))
    stuck_io_thr = float(config.get('stuck_io_activity_bytes_threshold', 4096.0))
    stuck_enabled = bool(config.get('stuck_detection_enable', True))
    stuck_stop_threshold = int(config.get('stuck_stop_threshold', STOP_THRESHOLD))
    if stuck_stop_threshold < 1:
        stuck_stop_threshold = 1
    if live_monitor_interval <= 0.0:
        live_monitor_interval = 5.0

    pid = process.pid
    try:
        ps = psutil.Process(pid)
    except psutil.NoSuchProcess:
        ps = None

    start_time = time.time()
    live_report_time = 0.0
    summary_report_time = 0.0
    last_live_sample_time = start_time
    last_live_spend_time = 0.0
    status.current_cpu_usage[jobid] = 0.0
    status.current_mem_usage[jobid] = 0.0
    
    while retcode is None:
        try:
            res = os.wait4(process.pid,os.WNOHANG)
            if res[0] > 0:
                retcode = os.waitstatus_to_exitcode(res[1])
                resources = res[2]
        except OSError:
            retcode = process.poll()
            resources = None
        
        cur_time = time.time()
        
        if (cur_time - live_report_time) > live_monitor_interval:
            live_report_time = cur_time
            if retcode is None and not ps is None:
                try:
                    with ps.oneshot():
                        c = ps.cpu_times()
                        nt = ps.num_threads()
                        #children_user and children_system record the cpu time of FINISHED children processes
                        lastcpureport={'user':c.user,'system':c.system,'children_user':c.children_user,'children_system':c.children_system, 'iowait':c.iowait, 'nthreads':nt}

                        m = ps.memory_full_info()
                        r = {'uss':m.uss,'rss':m.rss,'vms':m.vms, 'pss':m.pss}

                        ix = ps.io_counters()
                        iocache[ps.pid] = {'read_count':ix.read_count, 'write_count':ix.write_count, 'read_bytes':ix.read_chars, 'write_bytes':ix.write_chars}
                        
                        for m in ps.children(recursive=True):
                            try:
                                with m.oneshot():
                                    cx = m.cpu_times()
                                    for lab in ['user','system','children_user','children_system','iowait']:
                                        lastcpureport[lab] += getattr(cx,lab)
                                    lastcpureport['nthreads'] += m.num_threads()

                                    imx = m.io_counters()
                                    iocache[m.pid] = {'read_count':imx.read_count, 'write_count':imx.write_count, 'read_bytes':imx.read_chars, 'write_bytes':imx.write_chars}


                                    mx = m.memory_full_info()
                                    for lab in ['uss','rss','vms','pss']:
                                        r[lab] += getattr(mx,lab)
                            except psutil.AccessDenied:
                                continue #process did probably end
                            except psutil.NoSuchProcess:
                                continue
                    io_total = float(sum([float(v.get('read_bytes',0.0)) + float(v.get('write_bytes',0.0)) for v in iocache.values()]))

                    # Total CPU time across the tree without double counting
                    spend_time = (lastcpureport['user'] + lastcpureport['system'] + lastcpureport['children_user'] + lastcpureport['children_system']) 
                    if last_live_spend_time <= 0:
                        cpu_percentage = spend_time / max(cur_time - start_time, 1e-3)
                    else:
                        cpu_percentage = ((spend_time - last_live_spend_time) / max(cur_time - last_live_sample_time, 1e-3))
                    # Uncapped core-equivalent usage (non-negative)

                    cpu_percentage = max(0.0, float(cpu_percentage))                
                    with status.lock:
                        status.current_cpu_usage[jobid] = cpu_percentage
                        pss_mb = r['pss'] / (1024.0 * 1024.0)
                        rss_mb = r['rss'] / (1024.0 * 1024.0)
                        status.current_mem_usage[jobid] = pss_mb

                    lease_controller.record_usage(
                        jobid,
                        cpu_cores=cpu_percentage,
                        pss_mb=pss_mb,
                        rss_mb=rss_mb,
                        sampled_at=cur_time,
                    )

                    last_live_sample_time = cur_time
                    last_live_spend_time = spend_time

                    if (cur_time - summary_report_time) > monitor_interval:
                        summary_report_time = cur_time
                        if last_summary_io_total is None:
                            io_delta = 0.0
                        else:
                            io_delta = max(0.0, io_total - last_summary_io_total)
                        last_summary_io_total = io_total
                        iodeltas.append(io_delta)
                        memcache.append(r)

                        snapshot = dict(lastcpureport)
                        snapshot['cpu_perc'] = cpu_percentage
                        cpucache.append(snapshot)

                    if stuck_enabled and (summary_report_time - start_time) >= monitor_initial_delay:
                        if partition == 'compute' and len(cpucache) > stuck_stop_threshold and len(iodeltas) > stuck_stop_threshold:
                            if all([e['cpu_perc'] < stuck_cpu_thr for e in cpucache[::-1][:stuck_stop_threshold]]) and all([d <= stuck_io_thr for d in iodeltas[::-1][:stuck_stop_threshold]]):
                                window_sec = float(stuck_stop_threshold) * float(monitor_interval)
                                recent_cpu = [e['cpu_perc'] for e in cpucache[::-1][:min(stuck_stop_threshold, 5)]]
                                recent_io = iodeltas[::-1][:min(stuck_stop_threshold, 5)]
                                sys.stderr.write(
                                    f"{xtime()} - [{myid}] Job stuck, terminating job {jobid}; "
                                    f"cpu_thr={stuck_cpu_thr}core io_thr={stuck_io_thr}B interval={monitor_interval}s "
                                    f"n_intervals={stuck_stop_threshold} window~{window_sec:.1f}s "
                                    f"recent_cpu={recent_cpu} recent_io={recent_io}\n"
                                )
                                sys.stderr.flush()
                                procs = []
                                try:
                                    for proc in ps.children(recursive=True):
                                        proc.terminate()
                                        procs.append(proc)
                                    ps.terminate()
                                    procs.append(ps)
                                except psutil.NoSuchProcess:
                                    pass
                                time.sleep(10)
                                for proc in procs:
                                    try:
                                        proc.kill()
                                    except psutil.NoSuchProcess:
                                        pass
                                retcode=RC_STUCK



                except psutil.NoSuchProcess:
                    pass
                except psutil.AccessDenied:
                    pass #process did probably end


        time.sleep(1)

    sys.stderr.write(f"{xtime()}:{jobid} - MONITOR END; INFO: {pid} {logfile_path} {retcode}\n")
    sys.stderr.flush()
    
    report = {}
    report['starttime'] = time.strftime('%b %d %Y %H:%M:%S',time.localtime(start_time))
    report['endtime'] = time.strftime('%b %d %Y %H:%M:%S', time.localtime(time.time()))

    report['runtime'] = time.time() - start_time
    report['montime'] = summary_report_time - start_time
    report['retcode'] = retcode

    if not resources is None:
        report['user'] = resources.ru_utime
        report['system'] = resources.ru_stime
        report['maxrss'] = resources.ru_maxrss / 1024.0
    if not lastcpureport is None:
        #note: children_x contains time of _terminated_ children. 
        report['mon_user'] = lastcpureport['user'] + lastcpureport['children_user']
        report['mon_system'] = lastcpureport['system'] + lastcpureport['children_system']
        report['iowait'] = lastcpureport['iowait']
        report['avg_cpu_percentage'] = (report['mon_user'] + report['mon_system']) / report['runtime']

    if len(memcache) > 0:
        for lab in ['uss','rss','vms']:
            report[lab] = list([float(e)/(1024.0 * 1024.0) for e in numpy.percentile([e[lab] for e in memcache],[0,5,25,50,75,95,100])])
        report['cpu_percentage'] = list([float(e) for e in numpy.percentile([e['cpu_perc'] for e in cpucache], [0,5,25,50,75,95,100])])
        report['nthreads_avg'] = float(numpy.mean([e['nthreads'] for e in cpucache]))
        report['nthreads_max'] = float(numpy.max([e['nthreads'] for e in cpucache]))

        #20 snapshots of memory usage
        idx = numpy.asarray(numpy.round(numpy.linspace(0, len(memcache)-1, 20)),dtype=int)
        report['memory_over_time'] = ';'.join([str(float(e['pss']) / (1024.0 * 1024.0)) for e in [memcache[i] for i in idx]])

    if len(iocache) > 0: 
        for lab in ['read_count','read_bytes','write_count','write_bytes']:
            report[lab] = float(numpy.sum([e[lab] for e in iocache.values()]))
    #print(("%s - Job %s done with rcode %s" % (xtime(), str(jobid), str(retcode))))
    #print ("%s - Report %s" % (xtime(), str(report)))

    with status.lock:
        current_attempt = zslurm_lease.claim_finished_attempt(
            status.running_processes, jobid, process
        )
        if current_attempt:
            # Finalising the lease also closes its last reporting phase. Attach
            # both per-phase rows and time-integrated effective reservations to
            # the normal job report before it is sent to the manager.
            lease_report = lease_controller.finish_job(jobid, ncpu, mem)
            phases = lease_report.get("phases", [])
            report["lease_phases"] = phases
            for field in (
                "phase_count",
                "reserved_core_seconds",
                "sampled_reserved_core_seconds",
                "used_core_seconds",
                "reserved_mem_mb_seconds",
                "sampled_reserved_mem_mb_seconds",
                "pss_mb_seconds",
                "cpu_efficiency",
                "memory_efficiency",
                "sample_coverage",
            ):
                if field in lease_report:
                    report["lease_" + field] = lease_report[field]
            status.return_codes[jobid] = retcode
            status.reports[jobid] = report
            status.current_cpu_usage.pop(jobid, None)
            status.current_mem_usage.pop(jobid, None)
            event_timer.set()
        else:
            sys.stderr.write(
                f"job_monitor cleanup: stale or duplicate attempt for jobid {jobid}; "
                "current process left untouched\n"
            )
            sys.stderr.flush()

    logfile.close()

    if job_scratch_context:
        job_scratch_root, job_scratch_path = job_scratch_context
        try:
            cleanup_job_scratch(job_scratch_root, job_scratch_path)
        except Exception as ex:
            sys.stderr.write(
                f"{xtime()}:{jobid} - Scratch cleanup failed for "
                f"{job_scratch_path}: {ex}\n"
            )
            sys.stderr.flush()

    if not keep_logfiles:
        try:
            if not retain_completed_job_log(retcode):
                sys.stderr.write(f'Deleting log file {logfile_path} as there are no errors.\n')
                sys.stderr.flush()
                os.remove(logfile_path)
            else:
                sys.stderr.write(
                    f'Keeping failed job log {logfile_path} (return code {retcode}).\n'
                )
                sys.stderr.flush()

        except FileNotFoundError:
            sys.stderr.write(f'Log file {logfile_path} has disappeared.\n')
            sys.stderr.flush()


status.lock = threading.RLock()


signal.signal(signal.SIGTERM, handler)

starttime = time.time()
last_seen = time.time()
mode = zslurm_shared.RUNNING
idle_start = 0
event_timer = threading.Event()


def _lease_manager_resize(jobid, target_cpu, target_mem_mb):
    # Use a fresh proxy because xmlrpc.client.ServerProxy/Transport caches a
    # connection and is not safe to share between the main poll loop and the
    # local lease server's handler threads.
    proxy = zslurm_shared.TimeoutServerProxy(
        uri, timeout=REQUEST_TIMEOUT, allow_none=True
    )
    return proxy.resize_running_job(
        myid, str(jobid), float(target_cpu), float(target_mem_mb)
    )


def _lease_memory_available():
    # Match normal job admission: both the configured reservation envelope and
    # current cgroup/system availability must be able to cover a growth delta.
    reserved_envelope_free = max(
        0.0,
        e_memtot_buffer - sum(status.current_mem_usage.values(), 0.0),
    )
    physical_free = max(0.0, cap_fraction * get_effective_available_mb())
    return min(reserved_envelope_free, physical_free)


lease_controller = zslurm_lease.ChiefLeaseController(
    status=status,
    total_cpu=e_ncpu,
    total_mem_mb=e_memtot_buffer,
    manager_resize=_lease_manager_resize,
    memory_available=_lease_memory_available,
    wake_event=event_timer,
    min_cpu=float(config.get("lease_min_cpu", 0.1)),
    memory_headroom_fraction=float(
        config.get("lease_memory_headroom_fraction", 0.2)
    ),
    memory_headroom_mb=float(config.get("lease_memory_headroom_mb", 512.0)),
)


def _lease_socket_path():
    configured = config.get("lease_socket_dir")
    if configured:
        base = os.path.expanduser(str(configured))
    elif scratch_path and os.path.isdir(scratch_path):
        base = scratch_path
    else:
        base = os.environ.get("TMPDIR") or "/tmp"
    runtime_dir = os.path.join(
        base, f".zslurm-lease-{os.getuid()}-{os.getpid()}"
    )
    candidate = os.path.join(
        runtime_dir, "chief.sock"
    )
    # sockaddr_un.sun_path is commonly limited to 108 bytes.
    if len(os.fsencode(candidate)) >= 100:
        runtime_dir = os.path.join(
            "/tmp", f".zslurm-lease-{os.getuid()}-{os.getpid()}"
        )
        candidate = os.path.join(
            runtime_dir, "chief.sock"
        )
    return candidate


lease_socket_path = _lease_socket_path()
lease_server = zslurm_lease.LeaseServer(
    lease_socket_path, lease_controller
).start()


def _prepare_child_scratch_environment(env, jobid):
    # Scratch may be discovered again after chief startup. Bind the root into
    # the returned context so a later refresh cannot redirect cleanup.
    root = scratch_path
    if not root:
        return None
    path = configure_job_scratch_environment(env, root, jobid)
    return root, path


def _cleanup_child_scratch_context(context):
    root, path = context
    cleanup_job_scratch(root, path)


job_starter = DeferredJobStarts(
    status, lease_controller, lease_socket_path, job_monitor, event_timer,
    retry_seconds=config.get('job_start_retry_seconds', PING_INTERVAL),
    retry_max_seconds=config.get('job_start_retry_max_seconds', 300.0),
    memory_available=_lease_memory_available,
    prepare_child_environment=_prepare_child_scratch_environment,
    cleanup_child_context=_cleanup_child_scratch_context,
)
atexit.register(lease_server.close)
sys.stderr.write(f"{xtime()} - LEASE SERVER; INFO: {lease_socket_path}\n")
sys.stderr.flush()

last_cpu_times = psutil.cpu_times()
last_cpu_total = sum(last_cpu_times)
last_cgroup_cpu_time = get_cgroup_cpu_time_sec()
last_cgroup_sample_time = time.time()

try :
    #lengine_monitor = psutil.Process(lengine.pid)

    while True:
        sys.stderr.flush()
        sys.stdout.flush()
        event_timer.clear()

        while status.return_codes:
            with status.lock:
                nretcodes = {}
                for jobid, rcode in list(status.return_codes.items()):
                    try :
                        s.job_finished(myid, jobid, rcode,status.reports.get(jobid,{'no_job_report':True, 'jobid':jobid}))
                        #print('%s - Reported that job %s finished with rcode %s' % (xtime(), str(jobid), str(rcode)))

                        status.reports.pop(jobid,None)
                    except MANAGER_RPC_ERRORS as rpc_error :
                        print(
                            '%s - [%s] Manager RPC failed while reporting jobid %s: %s'
                            % (xtime(), myid, str(jobid), rpc_error)
                        )
                        try:
                            reconnected = reconnect_to_instance(inst_name, uri)
                            if reconnected is not None:
                                s, myid, uri = reconnected
                                manager_supports_gpfs_io = manager_supports_method(
                                    s, "poll_with_gpfs")
                                status.assigned_jobs.clear()
                                last_seen = time.time()
                                s.job_finished(
                                    myid,
                                    jobid,
                                    rcode,
                                    status.reports.get(
                                        jobid,
                                        {'no_job_report': True, 'jobid': jobid},
                                    ),
                                )
                                status.reports.pop(jobid, None)
                                print(
                                    f"[{myid}] Reconnected through instance "
                                    f"{inst_name} to {uri}; completion reported."
                                )
                                continue
                        except Exception as reconnect_error:
                            sys.stderr.write(
                                f"{xtime()} - [{myid}] Completion reconnect failed: "
                                f"{reconnect_error}\n"
                            )
                            sys.stderr.flush()
                        nretcodes[jobid] = rcode
                status.return_codes = nretcodes
            if status.return_codes:
                time.sleep(PING_INTERVAL) #retry later
       
       
        #check memory available (reserved, actual use)
        dyn_available_mb = cap_fraction * get_effective_available_mb()
        mb_memory_available = min(e_memtot_buffer - sum(status.current_mem_usage.values(),0.0), dyn_available_mb)

        
        # No filesystem operations under this lock: a failed log creation used
        # to abandon it and strand all monitor threads after unregistering.
        with status.lock:
            lease_acquire_pending = lease_controller.has_pending_acquire()
            if (
                mode == zslurm_shared.RUNNING
                and not lease_acquire_pending
                and not job_starter.pending
                and status.current_cpu > 0 and status.current_mem > 0
                and mb_memory_available > float(config.get('mem_min_requestable_mb', 256.0))
            ):
                if status.assigned_jobs:
                    jobs = list(status.assigned_jobs.values())
                else:
                    try:
                        overcommit = float(config.get('mem_overcommit_fraction', 1.0))
                        jobs = s.request_jobs(myid, status.current_cpu, min(status.current_mem, mb_memory_available) * overcommit, partition)
                    except MANAGER_RPC_ERRORS:
                        DeferredJobStarts.log('REQUEST HTTP Error')
                        jobs = []
                for job in jobs:
                    jobid, job_name, command, cwd, env, ncpu, mem, state = job
                    if jobid in status.running_processes or jobid in job_starter.pending:
                        continue
                    if state == 'ASSIGNED':
                        if status.current_cpu >= ncpu and min(status.current_mem, mb_memory_available) >= mem:
                            # Retain the grant until the acknowledgement reply
                            # arrives. A lost reply can then be retried safely.
                            status.assigned_jobs[jobid] = job
                            try:
                                permission = s.can_run_assigned_job(myid, jobid)
                            except MANAGER_RPC_ERRORS:
                                continue
                            status.assigned_jobs.pop(jobid, None)
                            if not permission:
                                continue
                            job = tuple(job[:-1]) + ('RUNNING',)
                        else:
                            status.assigned_jobs[jobid] = job
                            continue
                    job_starter.claim(job)

        # Retry even with zero free cores: these starts already own their grants.
        # Backoff is non-blocking, so heartbeats, leases and completion reporting
        # continue while the shared filesystem is temporarily unwritable.
        if mode == zslurm_shared.RUNNING:
            job_starter.run_ready()
        else:
            job_starter.cancel_all()

        if mode == zslurm_shared.STOPPING and not status.running_processes and not job_starter.pending and not status.return_codes:
            break

           
        #POLL
        cpu_usage = (sum(status.current_cpu_usage.values(),0.0) / e_ncpu) * 100.0
        mem_usage = (sum(status.current_mem_usage.values(), 0.0) / e_memtot_buffer) * 100.0
        load = psutil.getloadavg()[0] / host_cpu_count
        # System CPU busy and iowait (percent over this poll interval)
        cur_cpu_times = psutil.cpu_times()
        cur_cpu_total = sum(cur_cpu_times)
        dtotal = max(1e-9, (cur_cpu_total - last_cpu_total))
        didle = getattr(cur_cpu_times, 'idle', 0.0) - getattr(last_cpu_times, 'idle', 0.0)
        diowait = getattr(cur_cpu_times, 'iowait', 0.0) - getattr(last_cpu_times, 'iowait', 0.0)
        sys_cpu_busy = max(0.0, 100.0 * (1.0 - (didle / dtotal)))
        sys_iowait = max(0.0, 100.0 * (diowait / dtotal))
        last_cpu_times = cur_cpu_times
        last_cpu_total = cur_cpu_total
        now = time.time()
        cgroup_cpu_time = get_cgroup_cpu_time_sec()
        if not cgroup_cpu_time is None and not last_cgroup_cpu_time is None:
            cpu_delta = max(0.0, cgroup_cpu_time - last_cgroup_cpu_time)
            wall_delta = max(1e-9, now - last_cgroup_sample_time)
            cpu_capacity = max(1e-9, get_cgroup_cpu_capacity())
            cpu_usage = min(100.0, max(0.0, 100.0 * ((cpu_delta / wall_delta) / cpu_capacity)))
        if not cgroup_cpu_time is None:
            last_cgroup_cpu_time = cgroup_cpu_time
            last_cgroup_sample_time = now

        cgroup_memory_mb = get_cgroup_memory_without_page_cache_mb()
        if not cgroup_memory_mb is None:
            cgroup_limit_mb = get_cgroup_memory_limit_mb()
            mem_capacity = e_memtot_buffer if cgroup_limit_mb is None else min(e_memtot_buffer, cgroup_limit_mb)
            mem_usage = min(100.0, max(0.0, 100.0 * (cgroup_memory_mb / max(mem_capacity, 1e-9))))
        idle = not status.running_processes and not job_starter.pending
        if idle and idle_start == 0:
            idle_start = time.time()
        elif not idle:
            idle_start = 0
        commands = []
        try:
            gpfs_io_metrics = gpfs_io_monitor.sample()
            sys.stderr.write(
                f"{xtime()} - POLL; INFO: {myid} {cpu_usage:.2f} "
                f"{e_memtot:.2f} {e_memtot_buffer:.2f} "
                f"{get_memory_avl():.2f} {mem_usage:.2f} {load:.2f} "
                f"{sys_cpu_busy:.2f} {sys_iowait:.2f} "
                f"gpfs_rx={gpfs_io_metrics['rx_mib_s']:.2f}MiB/s "
                f"gpfs_tx={gpfs_io_metrics['tx_mib_s']:.2f}MiB/s "
                f"gpfs={gpfs_io_metrics['io_pct']:.2f}% {mode} "
                f"{status.current_cpu_usage} {status.current_mem_usage}\n"
            )
            sys.stderr.flush()

            if now - ssd_last_refresh >= ssd_refresh_interval:
                if not scratch_path or not os.path.isdir(scratch_path):
                    scratch_path = detect_scratch_path(
                        clusterid,
                        allow_tmpdir=bool(
                            config.get("scratch_use_tmpdir", False)
                        ),
                    )
                ssd_total_gb, ssd_used_gb = read_scratch_usage(
                    scratch_path, scratch_capacity_gb
                )
                ssd_last_refresh = now

            idle_duration = 0.0 if idle_start == 0 else (now - idle_start)
            poll_args = (
                myid, cpu_usage, mem_usage, load, mode, idle_duration,
                status.current_cpu_usage.copy(),
                status.current_mem_usage.copy(),
                sys_cpu_busy, sys_iowait, ssd_total_gb, ssd_used_gb,
            )
            if manager_supports_gpfs_io:
                commands = s.poll_with_gpfs(
                    *(poll_args + (
                        gpfs_io_metrics["rx_mib_s"],
                        gpfs_io_metrics["tx_mib_s"],
                        gpfs_io_metrics["io_pct"],
                        gpfs_io_metrics["available"],
                    ))
                )
            else:
                commands = s.poll(*poll_args)
            last_seen = time.time()
        except MANAGER_RPC_ERRORS as serror :
            print('%s - [%s] Caught a socket error for command poll !' % (xtime(), myid))
            reconnected = False
            # The logical instance record is atomically redirected during a
            # manager handover.  This fallback also covers an old manager that
            # exits before this chief receives MIGRATE_MANAGER.
            try:
                reconnected = reconnect_to_instance(inst_name, uri)
                if reconnected is not None:
                    new_proxy, new_id, redirected_uri = reconnected
                    status.assigned_jobs.clear()
                    s = new_proxy
                    manager_supports_gpfs_io = manager_supports_method(
                        s, "poll_with_gpfs")
                    myid = new_id
                    uri = redirected_uri
                    last_seen = time.time()
                    reconnected = True
                    print(
                        f"[{myid}] Reconnected through instance {inst_name} "
                        f"to {redirected_uri}."
                    )
            except Exception as reconnect_error:
                sys.stderr.write(
                    f"{xtime()} - [{myid}] Instance redirect reconnect failed: "
                    f"{reconnect_error}\n"
                )
                sys.stderr.flush()
            if not reconnected and time.time() - last_seen > PING_TIMEOUT:
                print('[%s] Timeout triggered!' % myid)
                mode=zslurm_shared.STOPPING


        cancel_job_list = []
        for cmd, param in commands:
            if (cmd == zslurm_shared.STOP) :
                print('[%s] Received command to stop.' % myid)
                mode = zslurm_shared.STOPPING
                job_starter.cancel_all()
            elif (cmd == zslurm_shared.DIE):
                print('[%s] Received command to die.' % myid)
                mode = zslurm_shared.STOPPING

                terminate_jobs()
            elif (cmd == zslurm_shared.DEASSIGN):
                print(('[%s] Received command to deassign job: ' % myid)+ str(param))
                with status.lock:
                    jobid = param
                    status.assigned_jobs.pop(jobid,None)
            elif (cmd == zslurm_shared.CANCEL):
                print(('[%s] Received command to cancel job: ' % myid)+ str(param))
                cancel_job_list.append(param)

            elif (cmd == zslurm_shared.REREGISTER):
                print(('[%s] Received command to reregister.' % myid))
                try:
                    myid = register_with_manager(s,
                        myip,
                        e_ncpu,
                        e_memtot_buffer,
                        partition,
                        clusterid,
                        ssd_total_gb,
                        ssd_used_gb,
                        inst_name,
                    )
                except MANAGER_RPC_ERRORS as serror :
                    pass
                if myid == 'DENIED':
                    print(('[%s] Denied reregistration, stopping.' %myid))
                    mode = zslurm_shared.STOPPING

            elif (cmd == zslurm_shared.MIGRATE_MANAGER):
                target = param if isinstance(param, dict) else {}
                target_uri = target.get('manager_url')
                target_instance = target.get('instance')
                if not target_uri:
                    sys.stderr.write(
                        f"{xtime()} - [{myid}] Invalid manager migration payload; "
                        "remaining on source manager.\n"
                    )
                    sys.stderr.flush()
                    continue
                print(
                    f"[{myid}] Migrating manager connection to "
                    f"{target_instance or target_uri}."
                )
                try:
                    new_proxy, new_id = register_at_manager(target_uri)
                    # ASSIGNED jobs were deliberately requeued in the imported
                    # manager snapshot. Running child processes and lease state
                    # remain untouched and are reconciled by the next target poll.
                    status.assigned_jobs.clear()
                    s = new_proxy
                    manager_supports_gpfs_io = manager_supports_method(
                        s, "poll_with_gpfs")
                    myid = new_id
                    uri = str(target_uri)
                    inst_name = target_instance or inst_name
                    last_seen = time.time()
                    print(
                        f"[{myid}] Manager migration complete; existing child "
                        "processes continue running."
                    )
                except Exception as migration_error:
                    sys.stderr.write(
                        f"{xtime()} - [{myid}] Manager migration failed: "
                        f"{migration_error}; remaining on source manager.\n"
                    )
                    sys.stderr.flush()

            else :
                print("[%s] UNKNOWN COMMAND RECEIVED, EXITING!" %myid)
                break
        if cancel_job_list:
            with status.lock:
                processes = []
                for jobid in cancel_job_list:
                    job_starter.cancel(jobid)
                    if jobid in status.running_processes:
                    
                        p = status.running_processes[jobid]
                        try:
                            process = psutil.Process(p.pid)
                            processes.append(process)
                            for proc in process.children(recursive=True):
                                processes.append(proc)
                                proc.terminate()
                            process.terminate()
                            #os.killpg(os.getpgid(p.pid), signal.SIGTERM)
                        except psutil.NoSuchProcess:
                            pass
            
            time.sleep(10) #allow jobs some time to terminate normally

            #kill any remaining jobs
            for proc in processes:
                try:
                    proc.kill()
                except psutil.NoSuchProcess:
                    pass

        event_timer.wait(PING_INTERVAL)

    sys.stdout.flush()
    sys.stderr.flush()

    safe_unregister(s, myid)


except (Exception, KeyboardInterrupt, SystemExit) :
    sys.stdout.flush()
    sys.stderr.flush()

    # All accounting locks unwind via context managers. On an unexpected fatal
    # error, stop/reap children before giving their jobs back to the manager;
    # never leave a half-alive chief occupying a Slurm allocation indefinitely.
    try:
        terminate_jobs()
    finally:
        safe_unregister(s, myid)
    raise
