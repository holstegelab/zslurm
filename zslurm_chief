def manager_supports_method(proxy, method_name):
    """Use XML-RPC introspection for rolling protocol compatibility."""
    try:
        return str(method_name) in set(proxy.system.listMethods())
    except (MANAGER_RPC_ERRORS, xmlrpclib.Fault, AttributeError, TypeError):
        return False


_warned_legacy_manager = False


def register_with_manager(proxy, *registration_args):
    """Send the chief version when supported without breaking old managers."""
    global _warned_legacy_manager
    if manager_supports_method(proxy, "register_versioned"):
        return proxy.register_versioned(*(registration_args + (VERSION,)))
    if not _warned_legacy_manager:
        sys.stderr.write(
            f"WARNING: this zslurm_chief is {VERSION}, but the manager does "
            "not support versioned registration. Check that both use the "
            "same ZSlurm installation.\n"
        )
        sys.stderr.flush()
        _warned_legacy_manager = True
    return proxy.register(*registration_args)


